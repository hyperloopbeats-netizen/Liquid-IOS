    function spawnShockwave(localOrigin, normalDir, intensity = 1.0, hex = 0x22d3ee) {
      if (!shockwaveGroup) return;
      const maxWaves = ecoModeEnabled ? 8 : 14;
      if (shockwaves.length >= maxWaves) {
        const old = shockwaves.shift();
        shockwaveGroup.remove(old.mesh);
        old.mesh.geometry.dispose();
        old.mesh.material.dispose();
      }
      const mesh = new THREE.Mesh(
        new THREE.RingGeometry(0.04, 0.068, 28),
        new THREE.MeshBasicMaterial({
          color: hex,
          side: THREE.DoubleSide,
          transparent: true,
          opacity: Math.min(0.95, 0.55 + intensity * 0.4)
        })
      );
      mesh.position.copy(localOrigin).addScaledVector(normalDir, 0.02);
      mesh.lookAt(localOrigin.clone().add(normalDir));
      shockwaveGroup.add(mesh);
      shockwaves.push({ mesh, age: 0, maxAge: 0.85, speed: 1.45 + intensity * 0.85 });
    }

