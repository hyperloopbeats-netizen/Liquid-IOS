    function emitSonarPing(originLocal = new THREE.Vector3(0, -0.05, 1.22), normalLocal = new THREE.Vector3(0, 0, 1)) {
      const now = performance.now();
      pingLatencyMs = lastPingTimestamp > 0 ? Math.min(999, Math.round(now - lastPingTimestamp)) : 18;
