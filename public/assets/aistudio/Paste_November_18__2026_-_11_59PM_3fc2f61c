        document.getElementById('lab-signal-readout').textContent =
          `RMS: ${latestRms.toFixed(2)} | ZC: ${zeroCrossCount} | PURIFIED: ${purifiedSignal.toFixed(2)}`;
        renderOscilloscope(elapsed);
