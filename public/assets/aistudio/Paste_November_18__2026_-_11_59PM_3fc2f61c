        shockwaveGroup = new THREE.Group();
        headMesh.add(shockwaveGroup);
        shockwaves.length = 0;

        container.classList.remove('hidden');
        fallback2dCanvas.classList.add('hidden');
        webglAvailable = true;
        return true;
      } catch (err) {
        webglAvailable = false;
        activateCanvasFallback(`2D Canvas Fallback Active (${err.message})`);
        return false;
      }
    }

