<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>HyperFace AI Studio v12.0 — OS-Safe Studio & Full Design Matrix</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }
    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-color: #03060c;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      color: #e2e8f0;
      user-select: none;
    }
    .font-mono {
      font-family: 'JetBrains Mono', monospace;
    }
    ::-webkit-scrollbar {
      width: 4px;
      height: 4px;
    }
    ::-webkit-scrollbar-track {
      background: rgba(15, 23, 42, 0.45);
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(56, 189, 248, 0.35);
      border-radius: 9999px;
    }
    input[type="range"] {
      -webkit-appearance: none;
      appearance: none;
      height: 5px;
      background: rgba(30, 41, 59, 0.95);
      border-radius: 9999px;
      outline: none;
      border: 1px solid rgba(148, 163, 184, 0.22);
    }
    input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: #38bdf8;
      cursor: pointer;
      box-shadow: 0 0 8px rgba(56, 189, 248, 0.7);
    }
    .glass-card {
      background: rgba(6, 11, 22, 0.88);
      border: 1px solid rgba(56, 189, 248, 0.22);
      box-shadow: 0 10px 28px rgba(0, 0, 0, 0.7), inset 0 1px 0 rgba(255, 255, 255, 0.05);
    }
    @media (min-width: 768px) {
      .glass-card {
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
      }
    }
    .matrix-cell-active {
      background: linear-gradient(135deg, rgba(34, 211, 238, 0.26), rgba(232, 121, 249, 0.22));
      border-color: rgba(56, 189, 248, 0.65) !important;
      box-shadow: 0 0 12px rgba(34, 211, 238, 0.22);
    }
  </style>
  <script type="importmap">
    {
      "imports": {
        "three": "https://cdn.jsdelivr.net/npm/three@0.164.1/build/three.module.js",
        "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.164.1/examples/jsm/"
      }
    }
  </script>
</head>
<body class="h-screen w-screen overflow-hidden relative bg-slate-950 text-slate-100">

  <!-- Full-Viewport Stage: WebGL 3D Canvas + OS-Safe 2D Canvas Fallback / Eco Renderer -->
  <div id="canvas-container" class="absolute inset-0 w-full h-full z-0"></div>
  <canvas id="fallback-2d-canvas" class="hidden absolute inset-0 w-full h-full z-0 block"></canvas>

  <!-- Symmetrical Top Bar: Mirrored Left & Right Clusters, Smart App Switcher, Eco Mode & HUD Toggle -->
  <header class="fixed top-2 left-2 right-2 z-30 grid grid-cols-1 lg:grid-cols-12 gap-2 items-center pointer-events-none">
    <!-- Left Top Cluster: Identity, Telemetry Badges & Status -->
    <div class="lg:col-span-4 glass-card rounded-2xl px-3 py-1.5 flex items-center justify-between gap-2 pointer-events-auto min-w-0">
      <div class="flex items-center gap-2 min-w-0">
        <div id="status-dot" class="w-2.5 h-2.5 shrink-0 rounded-full bg-emerald-400 shadow-[0_0_8px_#34d399]"></div>
        <div class="min-w-0">
          <div class="flex items-center gap-1.5">
            <h1 class="text-xs sm:text-sm font-bold tracking-wider uppercase text-cyan-300 truncate">HyperFace AI v12.0</h1>
            <span id="fps-badge" class="font-mono text-[10px] px-1.5 py-0.5 rounded bg-cyan-500/15 text-cyan-300 border border-cyan-400/25 shrink-0">60 FPS</span>
            <span id="reaction-badge" class="font-mono text-[10px] px-1.5 py-0.5 rounded bg-fuchsia-500/20 text-fuchsia-200 border border-fuchsia-400/30 shrink-0">CALM</span>
          </div>
          <p id="status-text" class="text-[10px] text-slate-300 font-mono truncate">Initializing OS-Safe Studio v12.0, Full Design Matrix &amp; 20 Daemons...</p>
        </div>
      </div>
    </div>

    <!-- Center Top Cluster: Smart App 1 / Smart App 2 Switcher -->
    <div class="lg:col-span-4 glass-card rounded-2xl p-1 flex items-center justify-center gap-1 pointer-events-auto">
      <button id="app1-btn" type="button" class="flex-1 py-1 px-2 rounded-xl text-[11px] font-semibold bg-cyan-500/25 text-cyan-200 border border-cyan-400/40 transition truncate">
        App 1: AI Studio &amp; Matrix
      </button>
      <button id="app2-btn" type="button" class="flex-1 py-1 px-2 rounded-xl text-[11px] font-semibold text-slate-300 hover:bg-slate-800/70 border border-transparent transition truncate">
        App 2: Vector, Post-FX &amp; 20D
      </button>
    </div>

    <!-- Right Top Cluster: Decoupled Op Modes, Zoom, Eco Mode, Snapshot & HUD Toggle -->
    <div class="lg:col-span-4 glass-card rounded-2xl p-1 flex flex-wrap items-center justify-between lg:justify-end gap-1 pointer-events-auto">
      <div class="flex items-center gap-1">
        <button id="mode-sculpt-btn" type="button" class="px-2 py-1 rounded-xl text-[10px] font-semibold bg-emerald-500/25 text-emerald-200 border border-emerald-400/40 transition">Sculpt</button>
        <button id="mode-orbit-btn" type="button" class="px-2 py-1 rounded-xl text-[10px] font-semibold text-slate-300 hover:bg-slate-800/70 border border-transparent transition">Orbit</button>
        <button id="mode-ping-btn" type="button" class="px-2 py-1 rounded-xl text-[10px] font-semibold text-slate-300 hover:bg-slate-800/70 border border-transparent transition">Ping</button>
        <button id="mode-rotate-btn" type="button" class="px-2 py-1 rounded-xl text-[10px] font-semibold text-slate-300 hover:bg-slate-800/70 border border-transparent transition">Rotate</button>
      </div>
      <div class="flex items-center gap-0.5 bg-slate-950/80 rounded-xl px-1 py-0.5 border border-white/10">
        <button id="zoom-out-btn" type="button" class="w-5 h-5 rounded font-mono text-xs text-cyan-200 hover:bg-slate-800 flex items-center justify-center" title="Zoom Out">−</button>
        <span id="zoom-readout" class="font-mono text-[10px] text-cyan-300 px-1">1.00x</span>
        <button id="zoom-in-btn" type="button" class="w-5 h-5 rounded font-mono text-xs text-cyan-200 hover:bg-slate-800 flex items-center justify-center" title="Zoom In">+</button>
        <button id="zoom-reset-btn" type="button" class="px-1 rounded font-mono text-[9px] text-slate-300 hover:bg-slate-800" title="Reset Zoom">1:1</button>
      </div>
      <button id="eco-mode-btn" type="button" class="px-2 py-1 rounded-xl text-[10px] font-mono font-semibold bg-slate-900 hover:bg-slate-800 text-emerald-300 border border-white/15 transition" title="Toggle Low-CPU Eco Mode">
        Eco: OFF
      </button>
      <button id="capture-snapshot-btn" type="button" class="px-2 py-1 rounded-xl text-[10px] font-mono font-semibold bg-indigo-500/25 hover:bg-indigo-500/35 text-indigo-200 border border-indigo-400/35 transition" title="Export PNG Snapshot">
        Snap
      </button>
      <button id="toggle-all-hud-btn" type="button" class="px-2 py-1 rounded-xl text-[10px] font-mono font-semibold text-cyan-200 hover:bg-slate-800/80 border border-white/10 transition">
        HUD [−]
      </button>
    </div>
  </header>

  <!-- ======================================================================= -->
  <!-- SMART APP 1 LEFT DOCK: FULL DESIGN MATRIX (4x4 / 16-CELL) & AI PRESETS  -->
  <!-- ======================================================================= -->
  <aside id="left-hud-wrapper" class="fixed top-28 lg:top-16 left-2 z-20 w-[calc(100vw-1rem)] sm:w-[356px] pointer-events-none">
    <section class="glass-card rounded-2xl overflow-hidden pointer-events-auto">
      <div class="px-3 py-2 flex items-center justify-between border-b border-white/10 bg-slate-900/65">
        <div class="flex items-center gap-2 min-w-0">
          <span class="w-2 h-2 shrink-0 rounded-full bg-cyan-400"></span>
          <h2 class="text-xs font-bold uppercase tracking-wider text-cyan-200 truncate">Design Matrix · AI Studio Presets</h2>
        </div>
        <button id="collapse-left-btn" type="button" class="font-mono text-xs px-2 py-0.5 rounded-lg bg-slate-800/90 hover:bg-slate-700 text-cyan-300 border border-white/10 shrink-0">
          [−]
        </button>
      </div>

      <div id="left-panel-body" class="p-3 space-y-2.5 max-h-[60vh] lg:max-h-[73vh] overflow-y-auto">
        <!-- AI Studio Scene & Expression Synthesis Presets -->
        <div class="rounded-xl bg-slate-950/85 border border-cyan-400/25 p-2.5 space-y-1.5">
          <div class="flex items-center justify-between text-[10px] font-mono">
            <span class="text-cyan-300 font-semibold">AI STUDIO SYNTHESIS PRESETS</span>
            <span id="studio-preset-badge" class="text-fuchsia-300">VOCAL STUDIO</span>
          </div>
          <div class="grid grid-cols-5 gap-1 text-[9px] font-mono">
            <button type="button" data-studio-preset="vocal" class="studio-preset-btn py-1 px-1 rounded-lg bg-cyan-500/25 text-cyan-200 border border-cyan-400/40 truncate">Vocal</button>
            <button type="button" data-studio-preset="liquid" class="studio-preset-btn py-1 px-1 rounded-lg bg-slate-900 hover:bg-slate-800 text-slate-300 border border-white/10 truncate">Liquid</button>
            <button type="button" data-studio-preset="vector" class="studio-preset-btn py-1 px-1 rounded-lg bg-slate-900 hover:bg-slate-800 text-slate-300 border border-white/10 truncate">Vector</button>
            <button type="button" data-studio-preset="chromatic" class="studio-preset-btn py-1 px-1 rounded-lg bg-slate-900 hover:bg-slate-800 text-slate-300 border border-white/10 truncate">Glass</button>
            <button type="button" data-studio-preset="sonar" class="studio-preset-btn py-1 px-1 rounded-lg bg-slate-900 hover:bg-slate-800 text-slate-300 border border-white/10 truncate">Sonar</button>
          </div>
        </div>

        <!-- 4x4 / 16-Cell Full Design Matrix -->
        <div class="rounded-xl bg-slate-950/90 border border-fuchsia-400/30 p-2.5 space-y-2">
          <div class="flex items-center justify-between text-[10px] font-mono">
            <span class="text-fuchsia-300 font-bold">FULL DESIGN MATRIX (4×4 · 16 CELLS)</span>
            <span id="matrix-cell-readout" class="text-cyan-300">M01 · GEOM</span>
          </div>

          <div id="full-design-matrix-grid" class="grid grid-cols-4 gap-1.5 text-[9px] font-mono"></div>

          <div class="rounded-lg bg-slate-900/90 border border-white/10 p-2 space-y-1.5">
            <div class="flex items-center justify-between text-[10px] font-mono">
              <span id="matrix-selected-title" class="text-cyan-200 font-semibold">M01: Sculpted Face Mesh</span>
              <span id="matrix-selected-val" class="text-fuchsia-300">1.00</span>
            </div>
            <p id="matrix-selected-desc" class="text-[10px] text-slate-400 leading-snug">
              Anatomical brow, orbital socket, nasal bridge, cheekbone, 8-node lip &amp; jaw topology.
            </p>
            <div class="flex items-center gap-2">
              <input id="matrix-param-slider" type="range" min="0" max="1" step="0.01" value="0.5" class="flex-1" />
              <button id="matrix-inject-btn" type="button" class="px-2 py-0.5 rounded bg-fuchsia-500/25 hover:bg-fuchsia-500/35 text-fuchsia-200 border border-fuchsia-400/35 text-[10px] font-mono">
                Inject
              </button>
            </div>
          </div>

          <div class="grid grid-cols-3 gap-1.5 text-[10px] font-mono">
            <button id="matrix-randomize-btn" type="button" class="py-1 px-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 border border-white/15 text-cyan-200 truncate">
              Harmonize
            </button>
            <button id="matrix-pulse-btn" type="button" class="py-1 px-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 border border-white/15 text-fuchsia-200 truncate">
              Matrix Pulse
            </button>
            <button id="matrix-reset-btn" type="button" class="py-1 px-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 border border-white/15 text-emerald-200 truncate">
              Reset Matrix
            </button>
          </div>
        </div>

        <!-- Image Upload & Full Manipulation Controls -->
        <div class="rounded-xl bg-slate-950/85 border border-cyan-400/25 p-2.5 space-y-2">
          <div class="flex items-center justify-between text-[10px] font-mono">
            <span class="text-cyan-300 font-semibold">IMAGE RELIEF &amp; MORPH</span>
            <span id="image-status-badge" class="text-slate-400">NO IMAGE</span>
          </div>
          <div class="grid grid-cols-3 gap-1.5">
            <label for="image-file-input" class="col-span-2 cursor-pointer py-1.5 px-2 rounded-lg text-[10px] font-mono font-semibold text-center bg-cyan-500/20 hover:bg-cyan-500/30 text-cyan-200 border border-cyan-400/35 transition truncate">
              Upload Image
            </label>
            <input id="image-file-input" type="file" accept="image/*,.png,.jpg,.jpeg,.webp,.gif" class="hidden" />
            <button id="clear-image-btn" type="button" class="py-1.5 px-2 rounded-lg text-[10px] font-mono font-semibold bg-slate-900 hover:bg-slate-800 text-rose-300 border border-white/15 transition">
              Clear
            </button>
          </div>
          <div class="flex items-center gap-2">
            <canvas id="image-preview-canvas" width="96" height="56" class="w-20 h-12 rounded-lg bg-slate-900 border border-white/10 shrink-0 object-cover"></canvas>
            <div class="flex-1 space-y-1.5 min-w-0">
              <div class="flex items-center justify-between">
                <span class="text-[10px] font-mono text-slate-300">Mirror Symmetry</span>
                <button id="image-mirror-btn" type="button" class="px-1.5 py-0.5 rounded text-[10px] font-mono bg-cyan-500/20 text-cyan-200 border border-cyan-400/30">
                  MIRROR: ON
                </button>
              </div>
              <div>
                <div class="flex justify-between text-[10px] font-mono mb-0.5">
                  <span class="text-slate-400">Relief Depth</span>
                  <span id="relief-depth-val" class="text-cyan-300">0.24</span>
                </div>
                <input id="relief-depth-slider" type="range" min="0.00" max="0.65" step="0.01" value="0.24" class="w-full" />
              </div>
            </div>
          </div>
        </div>

        <!-- Decoupled Zoom & Rotate Controls -->
        <div class="rounded-xl bg-slate-950/85 border border-cyan-400/25 p-2.5 space-y-2">
          <div class="flex items-center justify-between text-[10px] font-mono">
            <span class="text-cyan-300 font-semibold">DECOUPLED ZOOM &amp; ROTATE</span>
            <span id="decouple-state-badge" class="text-emerald-300">ISOLATED</span>
          </div>
          <div class="grid grid-cols-4 gap-1">
            <button id="lock-zoom-btn" type="button" class="py-1 px-1 rounded-lg text-[9px] font-mono font-semibold bg-slate-900 hover:bg-slate-800 border border-white/15 text-cyan-200 transition truncate">
              Zoom: FREE
            </button>
            <button id="lock-ops-btn" type="button" class="py-1 px-1 rounded-lg text-[9px] font-mono font-semibold bg-slate-900 hover:bg-slate-800 border border-white/15 text-amber-200 transition truncate">
              Ops: FREE
            </button>
            <button id="auto-orbit-btn" type="button" class="py-1 px-1 rounded-lg text-[9px] font-mono font-semibold bg-slate-900 hover:bg-slate-800 border border-white/15 text-fuchsia-200 transition truncate">
              Orbit: OFF
            </button>
            <button id="reset-orbit-cam-btn" type="button" class="py-1 px-1 rounded-lg text-[9px] font-mono font-semibold bg-slate-900 hover:bg-slate-800 border border-white/15 text-emerald-200 transition truncate">
              Cam: 0,0
            </button>
          </div>
          <div>
            <div class="flex justify-between text-[10px] font-mono mb-0.5">
              <span class="text-slate-400">Camera Zoom</span>
              <span id="zoom-slider-val" class="text-cyan-300">1.00x</span>
            </div>
            <input id="zoom-slider" type="range" min="0.55" max="2.10" step="0.01" value="1.00" class="w-full" />
          </div>
          <div class="grid grid-cols-3 gap-1.5">
            <div>
              <div class="flex justify-between text-[9px] font-mono">
                <span class="text-slate-400">Yaw</span>
                <span id="yaw-val" class="text-cyan-300">0°</span>
              </div>
              <input id="yaw-slider" type="range" min="-90" max="90" step="1" value="0" class="w-full" />
            </div>
            <div>
              <div class="flex justify-between text-[9px] font-mono">
                <span class="text-slate-400">Pitch</span>
                <span id="pitch-val" class="text-cyan-300">0°</span>
              </div>
              <input id="pitch-slider" type="range" min="-55" max="55" step="1" value="0" class="w-full" />
            </div>
            <div>
              <div class="flex justify-between text-[9px] font-mono">
                <span class="text-slate-400">Roll</span>
                <span id="roll-val" class="text-cyan-300">0°</span>
              </div>
              <input id="roll-slider" type="range" min="-45" max="45" step="1" value="0" class="w-full" />
            </div>
          </div>
          <button id="snap-zero-rot-btn" type="button" class="w-full py-1 px-2 rounded-lg text-[10px] font-mono font-semibold bg-slate-900 hover:bg-slate-800 border border-white/15 text-emerald-200 transition">
            Zero-Center Snap Rotation
          </button>
        </div>

        <!-- Shader Skin & Liquid Push/Pull Brush -->
        <div>
          <label for="skin-select" class="block text-[11px] font-medium text-slate-300 mb-1">GLSL Sovereign Shader Skin</label>
          <select id="skin-select" class="w-full rounded-xl bg-slate-900/95 border border-cyan-400/25 px-3 py-1.5 text-xs text-slate-100 focus:outline-none focus:border-cyan-400">
            <option value="0" selected>01 · Liquid Chrome / Obsidian</option>
            <option value="1">02 · Biometric Wireframe Matrix</option>
            <option value="2">03 · Spartan Crystal Facets</option>
            <option value="3">04 · Acoustic Plasma Glass</option>
          </select>
        </div>

        <div>
          <div class="flex items-center justify-between mb-1">
            <span class="text-[11px] font-medium text-slate-300">Liquid Push / Pull Field</span>
            <span id="brush-mode-label" class="text-[10px] font-mono text-cyan-300">PUSH OUTWARD</span>
          </div>
          <div class="grid grid-cols-4 gap-1 bg-slate-950/90 p-1 rounded-xl border border-white/10">
            <button type="button" data-brush="push" class="brush-btn py-1.5 rounded-lg text-[11px] font-semibold bg-cyan-500/30 text-cyan-200 border border-cyan-400/40">Push +</button>
            <button type="button" data-brush="pull" class="brush-btn py-1.5 rounded-lg text-[11px] font-semibold text-slate-400 hover:text-slate-100">Pull −</button>
            <button type="button" data-brush="vortex" class="brush-btn py-1.5 rounded-lg text-[11px] font-semibold text-slate-400 hover:text-slate-100">Vortex</button>
            <button type="button" data-brush="pinch" class="brush-btn py-1.5 rounded-lg text-[11px] font-semibold text-slate-400 hover:text-slate-100">Pinch</button>
          </div>
        </div>

        <div class="space-y-2">
          <div>
            <div class="flex justify-between text-[11px] mb-0.5">
              <span class="text-slate-300">Brush Radius</span>
              <span id="radius-val" class="font-mono text-cyan-300">0.42</span>
            </div>
            <input id="radius-slider" type="range" min="0.15" max="0.95" step="0.01" value="0.42" class="w-full" />
          </div>
          <div>
            <div class="flex justify-between text-[11px] mb-0.5">
              <span class="text-slate-300">Liquid Viscosity</span>
              <span id="viscosity-val" class="font-mono text-cyan-300">0.88</span>
            </div>
            <input id="viscosity-slider" type="range" min="0.15" max="0.99" step="0.01" value="0.88" class="w-full" />
          </div>
          <div>
            <div class="flex justify-between text-[11px] mb-0.5">
              <span class="text-slate-300">Force Polarity &amp; Gain</span>
              <span id="polarity-val" class="font-mono text-cyan-300">+1.25</span>
            </div>
            <input id="polarity-slider" type="range" min="-2.50" max="2.50" step="0.05" value="1.25" class="w-full" />
          </div>
        </div>

        <div class="grid grid-cols-2 gap-2">
          <button id="freeze-liquid-btn" type="button" class="py-1.5 px-2.5 rounded-xl text-xs font-semibold bg-slate-900 hover:bg-slate-800 border border-white/15 text-amber-300 transition">
            Freeze Liquid: Off
          </button>
          <button id="reset-sculpt-btn" type="button" class="py-1.5 px-2.5 rounded-xl text-xs font-semibold bg-slate-900 hover:bg-slate-800 border border-white/15 text-emerald-300 transition">
            Reset Sculpt
          </button>
        </div>
      </div>
    </section>
  </aside>

  <!-- ======================================================================= -->
  <!-- SMART APP 1 RIGHT DOCK: LIPS ENGINE, SONAR PING, REACTIONS & VECTORS   -->
  <!-- ======================================================================= -->
  <aside id="right-hud-wrapper" class="fixed top-28 lg:top-16 right-2 z-20 w-[calc(100vw-1rem)] sm:w-[356px] pointer-events-none flex flex-col gap-2">
    <section class="glass-card rounded-2xl overflow-hidden pointer-events-auto">
      <div class="px-3 py-2 flex items-center justify-between border-b border-white/10 bg-slate-900/65">
        <div class="flex items-center gap-2 min-w-0">
          <span class="w-2 h-2 shrink-0 rounded-full bg-fuchsia-400"></span>
          <h2 class="text-xs font-bold uppercase tracking-wider text-fuchsia-200 truncate">Lips, Ping, Reactions &amp; Vectors</h2>
        </div>
        <button id="collapse-right-btn" type="button" class="font-mono text-xs px-2 py-0.5 rounded-lg bg-slate-800/90 hover:bg-slate-700 text-fuchsia-300 border border-white/10 shrink-0">
          [−]
        </button>
      </div>

