      { id: 'M03', code: 'FRSN', title: 'M03: Fresnel & Rim Boost', desc: 'Controls rim energy and reaction glow intensity.', val: 0.35, apply: (v) => { shaderUniforms.uReactionBoost.value = v * 1.1; } },
      { id: 'M04', code: 'EXPO', title: 'M04: Tone Exposure Gain', desc: 'Adjusts ACES filmic renderer exposure level.', val: 0.55, apply: (v) => { if (renderer) renderer.toneMappingExposure = 0.65 + v * 1.25; } },
      { id: 'M05', code: 'F1-O', title: 'M05: F1 Formant Aperture', desc: 'Injects vertical vocal aperture into lip & jaw springs.', val: 0.4, apply: (v) => { springVel[1] += v * 5.0; springVel[8] += v * 4.5; } },
      { id: 'M06', code: 'F2-S', title: 'M06: F2/F3 Lip Spread', desc: 'Injects horizontal corner spread & vowel width.', val: 0.4, apply: (v) => { springVel[2] += v * 4.2; springVel[3] += v * 4.2; } },
      { id: 'M07', code: 'PLSV', title: 'M07: Plosive Transient', desc: 'Triggers consonant burst impulse across lip & brow nodes.', val: 0.45, apply: (v) => { springVel[0] += v * 5.5; springVel[12] += v * 3.8; springVel[13] += v * 3.8; } },
      { id: 'M08', code: 'JAW-D', title: 'M08: Mandible Jaw Drop', desc: 'Modulates chin/jaw spring momentum and resonance.', val: 0.35, apply: (v) => { springVel[8] += v * 6.5; vectorNodes[8].impactForce = Math.min(3.5, vectorNodes[8].impactForce + v * 1.2); } },
      { id: 'M09', code: 'RADI', title: 'M09: Liquid Brush Radius', desc: 'Sets Gaussian push/pull sculpting field radius.', val: 0.42, apply: (v) => { const r = (0.15 + v * 0.80).toFixed(2); radiusSlider.value = r; document.getElementById('radius-val').textContent = r; } },
      { id: 'M10', code: 'VISC', title: 'M10: Liquid Viscosity', desc: 'Tunes spring-damper relaxation and fluid persistence.', val: 0.88, apply: (v) => { const vis = (0.15 + v * 0.84).toFixed(2); viscositySlider.value = vis; document.getElementById('viscosity-val').textContent = vis; } },
      { id: 'M11', code: 'POLR', title: 'M11: Push/Pull Polarity', desc: 'Balances outward push (+1) vs inward pull (-1) force.', val: 0.75, apply: (v) => { const pol = ((v * 2.0 - 1.0) * 2.2).toFixed(2); polaritySlider.value = pol; document.getElementById('polarity-val').textContent = (parseFloat(pol) >= 0 ? '+' : '') + pol; } },
      { id: 'M12', code: 'RLF-D', title: 'M12: Image Relief Depth', desc: 'Scales uploaded image luminance displacement depth.', val: 0.37, apply: (v) => { const d = (v * 0.65).toFixed(2); reliefDepthSlider.value = d; reliefDepthVal.textContent = d; } },
      { id: 'M13', code: 'PING', title: 'M13: Sonar Ping Wave', desc: 'Emits a calibrated sonar wave pulse from the face.', val: 0.65, apply: (v) => { emitSonarPing(new THREE.Vector3(0, (v - 0.5) * 0.6, 1.22), new THREE.Vector3(0, 0, 1)); } },
      { id: 'M14', code: 'VECT', title: 'M14: Trajectory Vector Gain', desc: 'Boosts velocity arrow & trajectory ribbon excitation.', val: 0.6, apply: (v) => { for (let i = 0; i < ZONE_COUNT; i++) { vectorNodes[i].impactForce = Math.min(3.5, vectorNodes[i].impactForce + v * 0.9); } } },
      { id: 'M15', code: 'GAZE', title: 'M15: Eye Gaze & Pupil Sync', desc: 'Stimulates pupil dilation and ocular fixation response.', val: 0.5, apply: (v) => { if (leftEyeRig && rightEyeRig) { leftEyeRig.pupilMesh.scale.setScalar(0.75 + v * 0.75); rightEyeRig.pupilMesh.scale.setScalar(0.75 + v * 0.75); } } },
      { id: 'M16', code: 'DMN20', title: 'M16: 20-Daemon Harmonic', desc: 'Pulses all 20 daemons and synchronizes matrix cadence.', val: 0.7, apply: (v) => { daemons.forEach((d) => { if (d.enabled) { d.pulses++; d.waveVal = Math.min(1, 0.3 + v * 0.7); } }); } }
    ];

    let selectedMatrixIdx = 0;
    const matrixGridEl = document.getElementById('full-design-matrix-grid');
    const matrixCellReadoutEl = document.getElementById('matrix-cell-readout');
    const matrixSelectedTitleEl = document.getElementById('matrix-selected-title');
    const matrixSelectedValEl = document.getElementById('matrix-selected-val');
    const matrixSelectedDescEl = document.getElementById('matrix-selected-desc');
    const matrixParamSlider = document.getElementById('matrix-param-slider');

    function renderDesignMatrixGrid() {
      matrixGridEl.innerHTML = DESIGN_MATRIX_CELLS.map((cell, idx) => {
        const isSel = idx === selectedMatrixIdx;
        return `
          <button type="button" data-matrix-idx="${idx}" class="matrix-cell-btn p-1.5 rounded-lg border text-left transition ${isSel ? 'matrix-cell-active text-cyan-100' : 'bg-slate-900/85 hover:bg-slate-800/90 border-white/10 text-slate-300'}">
            <div class="flex items-center justify-between font-bold">
              <span>${cell.id}</span>
              <span class="text-[8px] text-fuchsia-300">${cell.code}</span>
            </div>
            <div class="mt-1 h-1 bg-slate-800 rounded-full overflow-hidden">
              <div class="h-full bg-gradient-to-r from-cyan-400 to-fuchsia-400" style="width:${Math.round(cell.val * 100)}%"></div>
            </div>
          </button>
        `;
      }).join('');

      const cur = DESIGN_MATRIX_CELLS[selectedMatrixIdx];
      matrixCellReadoutEl.textContent = `${cur.id} · ${cur.code}`;
      matrixSelectedTitleEl.textContent = cur.title;
      matrixSelectedValEl.textContent = cur.val.toFixed(2);
      matrixSelectedDescEl.textContent = cur.desc;
      matrixParamSlider.value = cur.val.toFixed(2);
    }

    matrixGridEl.addEventListener('click', (e) => {
      const btn = e.target.closest('.matrix-cell-btn');
      if (!btn) return;
      const idx = parseInt(btn.dataset.matrixIdx, 10);
      if (isFinite(idx) && DESIGN_MATRIX_CELLS[idx]) {
        selectedMatrixIdx = idx;
        renderDesignMatrixGrid();
      }
    });

    matrixParamSlider.addEventListener('input', () => {
      const cell = DESIGN_MATRIX_CELLS[selectedMatrixIdx];
      if (!cell || faceOpsLocked) return;
      cell.val = parseFloat(matrixParamSlider.value);
      matrixSelectedValEl.textContent = cell.val.toFixed(2);
      cell.apply(cell.val);
      renderDesignMatrixGrid();
    });

    document.getElementById('matrix-inject-btn').addEventListener('click', () => {
      if (faceOpsLocked) return;
      const cell = DESIGN_MATRIX_CELLS[selectedMatrixIdx];
      cell.apply(cell.val);
      spawnShockwave(new THREE.Vector3(0, 0, 1.18), new THREE.Vector3(0, 0, 1), 1.1, 0x22d3ee);
      setEngineStatus(`Injected ${cell.title} (${cell.val.toFixed(2)})`, 'active');
    });

    document.getElementById('matrix-pulse-btn').addEventListener('click', () => {
      if (faceOpsLocked) return;
      DESIGN_MATRIX_CELLS.forEach((cell) => cell.apply(cell.val));
      emitSonarPing();
      setEngineStatus('Full 16-Cell Design Matrix Pulsed', 'active');
    });

    document.getElementById('matrix-randomize-btn').addEventListener('click', () => {
      if (faceOpsLocked) return;
      DESIGN_MATRIX_CELLS.forEach((cell, i) => {
        cell.val = Number((0.25 + 0.65 * Math.abs(Math.sin((i + 1) * 1.37))).toFixed(2));
        cell.apply(cell.val);
      });
      renderDesignMatrixGrid();
      setEngineStatus('Design Matrix Harmonized Across 16 Cells', 'active');
    });

    document.getElementById('matrix-reset-btn').addEventListener('click', () => {
      if (faceOpsLocked) return;
      const defaults = [1.0, 0.25, 0.35, 0.55, 0.4, 0.4, 0.45, 0.35, 0.42, 0.88, 0.75, 0.37, 0.65, 0.6, 0.5, 0.7];
      DESIGN_MATRIX_CELLS.forEach((cell, i) => {
        cell.val = defaults[i] ?? 0.5;
        cell.apply(cell.val);
      });
      renderDesignMatrixGrid();
      setEngineStatus('Design Matrix Reset to Defaults', 'ready');
    });

    const studioPresetBadge = document.getElementById('studio-preset-badge');
    let autoReactionEnabled = true;
    let activeReaction = 'calm';
    let manualReactionHoldUntil = 0;

    document.querySelectorAll('.studio-preset-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (faceOpsLocked) return;
        const preset = btn.dataset.studioPreset;
        document.querySelectorAll('.studio-preset-btn').forEach((b) => {
          b.className = 'studio-preset-btn py-1 px-1 rounded-lg bg-slate-900 hover:bg-slate-800 text-slate-300 border border-white/10 truncate';
        });
        btn.className = 'studio-preset-btn py-1 px-1 rounded-lg bg-cyan-500/25 text-cyan-200 border border-cyan-400/40 truncate';

        if (preset === 'vocal') {
          studioPresetBadge.textContent = 'VOCAL STUDIO';
          shaderUniforms.uSkinMode.value = 0; document.getElementById('skin-select').value = '0';
          activeReaction = 'surprise'; manualReactionHoldUntil = elapsedSimTime + 2.5;
          springVel[1] += 5.5; springVel[8] += 4.5;
        } else if (preset === 'liquid') {
          studioPresetBadge.textContent = 'LIQUID SCULPTOR';
          shaderUniforms.uSkinMode.value = 3; document.getElementById('skin-select').value = '3';
          viscositySlider.value = '0.94'; document.getElementById('viscosity-val').textContent = '0.94';
          applyLiquidBrushAt(new THREE.Vector3(0.2, -0.15, 1.12), new THREE.Vector3(0, 0, 1), 0.025, true);
        } else if (preset === 'vector') {
          studioPresetBadge.textContent = 'KINETIC VECTOR';
          shaderUniforms.uSkinMode.value = 1; document.getElementById('skin-select').value = '1';
          showVectors = true; toggleVecBtn.textContent = '3D Vectors: ON';
          for (let i = 0; i < ZONE_COUNT; i++) vectorNodes[i].impactForce = Math.min(3.5, vectorNodes[i].impactForce + 1.1);
        } else if (preset === 'chromatic') {
          studioPresetBadge.textContent = 'CHROMATIC GLASS';
          shaderUniforms.uSkinMode.value = 2; document.getElementById('skin-select').value = '2';
          activeReaction = 'squint'; manualReactionHoldUntil = elapsedSimTime + 2.5;
        } else if (preset === 'sonar') {
          studioPresetBadge.textContent = 'SONAR PING';
          emitSonarPing();
        }
        setEngineStatus(`AI Studio Preset Applied: ${studioPresetBadge.textContent}`, 'active');
      });
    });

    renderDesignMatrixGrid();

    // =========================================================================
    // 7. AUDIO FEATURE EXTRACTION, SMART OBSERVATIONS & 20 DAEMONS
    // =========================================================================
    const smartObservations = [
      { key: 'OBS-01:FORMANT', label: 'Vocal Formant F1/F2', value: 0, unit: '%', status: 'CALM' },
      { key: 'OBS-02:PLOSIVE', label: 'Plosive Transient Rate', value: 0, unit: '%', status: 'STEADY' },
      { key: 'OBS-03:LIQUID',  label: 'Liquid Shear Strain', value: 0, unit: 'u', status: 'FLUID' },
      { key: 'OBS-04:PING',    label: 'Sonar Echo Return', value: 0, unit: '%', status: 'IDLE' },
      { key: 'OBS-05:RELIEF',  label: 'Image Relief Depth', value: 0, unit: '%', status: 'OFF' },
      { key: 'OBS-06:IMPACT',  label: 'Peak Vector Impact', value: 0, unit: 'N', status: 'IDLE' }
    ];

    const reactionDetailEl = document.getElementById('reaction-detail');
    const autoReactionBtn = document.getElementById('auto-reaction-btn');
    const smartObsListEl = document.getElementById('smart-obs-list');
    const labObsListEl = document.getElementById('lab-obs-list');
    const labDaemonsGridEl = document.getElementById('lab-daemons-grid');
    let prevEnvelope = 0;
    let lastThrottledHudMs = 0;

    function extractVocalLipFeatures(elapsed) {
      let rawBass = 0, rawF1 = 0, rawF2 = 0, rawPlosive = 0;

      if (analyser && freqData && timeDomainData && activeAudioMode !== 'none') {
        analyser.getByteFrequencyData(freqData);
        analyser.getByteTimeDomainData(timeDomainData);

        const nyquist = (audioCtx ? audioCtx.sampleRate : 48000) * 0.5;
        const binHz = nyquist / freqData.length;

        const bEnd = Math.max(2, Math.min(freqData.length - 1, Math.ceil(160 / binHz)));
        let sumB = 0, cntB = 0;
        for (let i = 1; i <= bEnd; i++) { sumB += freqData[i]; cntB++; }
        rawBass = cntB > 0 ? (sumB / (cntB * 255)) : 0;

        const f1Start = Math.max(bEnd + 1, Math.floor(180 / binHz));
        const f1End = Math.min(freqData.length - 1, Math.ceil(900 / binHz));
        let sum1 = 0, cnt1 = 0;
        for (let i = f1Start; i <= f1End; i++) { sum1 += freqData[i]; cnt1++; }
        rawF1 = cnt1 > 0 ? (sum1 / (cnt1 * 255)) : 0;

        const f2Start = Math.max(f1End + 1, Math.floor(900 / binHz));
        const f2End = Math.min(freqData.length - 1, Math.ceil(3500 / binHz));
        let sum2 = 0, cnt2 = 0;
        for (let i = f2Start; i <= f2End; i++) { sum2 += freqData[i]; cnt2++; }
        rawF2 = cnt2 > 0 ? (sum2 / (cnt2 * 255)) : 0;

        let rmsSum = 0, zc = 0;
        for (let i = 1; i < timeDomainData.length; i += 2) {
          const prevS = (timeDomainData[i - 1] - 128) / 128;
          const curS = (timeDomainData[i] - 128) / 128;
          rmsSum += curS * curS;
          if ((prevS < 0 && curS >= 0) || (prevS >= 0 && curS < 0)) zc++;
        }
        zeroCrossCount = zc;
        const rms = Math.sqrt(rmsSum / (timeDomainData.length * 0.5));
        latestRms = rms;
        const deltaEnv = Math.max(0, rms - prevEnvelope);
        prevEnvelope = rms;
        rawPlosive = Math.min(1.0, (deltaEnv * 5.5) + (rms * 0.45));
      } else {
        rawBass = 0.04 + 0.03 * Math.sin(elapsed * 1.4);
        rawF1 = 0.05 + 0.03 * Math.sin(elapsed * 1.8);
        rawF2 = 0.04 + 0.03 * Math.cos(elapsed * 2.3);
        rawPlosive = 0.03 + 0.02 * Math.sin(elapsed * 1.2);
        latestRms = 0.02;
      }

      bassEnergy += (Math.min(1.0, rawBass * 1.55) - bassEnergy) * 0.25;
      f1Aperture += (Math.min(1.0, rawF1 * 1.65) - f1Aperture) * 0.28;
      f2Spread += (Math.min(1.0, rawF2 * 1.85) - f2Spread) * 0.26;
      plosiveEnergy += (Math.min(1.0, rawPlosive * 1.5) - plosiveEnergy) * 0.32;
      purifiedSignal += (((f1Aperture + f2Spread) * 0.5) - purifiedSignal) * 0.14;

      shaderUniforms.uF1.value = f1Aperture;
      shaderUniforms.uF2.value = f2Spread;
      shaderUniforms.uPlosive.value = plosiveEnergy;
    }

    function computeLiquidStrain() {
      if (!headGeometry || !headGeometry.userData || !headGeometry.userData.sculptOffsets) return 0;
      const sculpt = headGeometry.userData.sculptOffsets;
      let sum = 0;
      const step = ecoModeEnabled ? 24 : 12;
      for (let i = 0; i < sculpt.length; i += step) {
        sum += Math.abs(sculpt[i]) + Math.abs(sculpt[i + 1]) + Math.abs(sculpt[i + 2]);
      }
      return Math.min(100, (sum / (sculpt.length / step)) * 220);
    }

    function updateDaemonsAndObservations(dt, elapsed) {
      const strain = computeLiquidStrain();
      let peakImpact = 0;
      for (let i = 0; i < ZONE_COUNT; i++) {
        if (vectorNodes[i].impactForce > peakImpact) peakImpact = vectorNodes[i].impactForce;
      }

      if (autoReactionEnabled && elapsed > manualReactionHoldUntil) {
        if (plosiveEnergy > 0.62) activeReaction = 'pout';
        else if (f1Aperture > 0.65 && bassEnergy > 0.45) activeReaction = 'surprise';
        else if (bassEnergy > 0.58) activeReaction = 'bassnod';
        else if (strain > 32) activeReaction = 'ripple';
        else if (f2Spread > 0.52) activeReaction = 'squint';
        else activeReaction = 'calm';
      }

      const boost = activeReaction === 'calm' ? 0.05 : 0.65;
      shaderUniforms.uReactionBoost.value += (boost - shaderUniforms.uReactionBoost.value) * Math.min(1, dt * 8);

      smartObservations[0].value = Math.round(((f1Aperture + f2Spread) * 0.5) * 100);
      smartObservations[0].status = smartObservations[0].value > 55 ? 'VOCAL' : 'CALM';
      smartObservations[1].value = Math.round(plosiveEnergy * 100);
      smartObservations[1].status = smartObservations[1].value > 55 ? 'BURST' : 'STEADY';
      smartObservations[2].value = Math.round(strain);
      smartObservations[2].status = strain > 30 ? 'STRAIN' : 'FLUID';
      smartObservations[3].value = Math.round(pingEchoLevel * 100);
      smartObservations[3].status = pingEchoLevel > 0.15 ? 'ECHO' : 'IDLE';
      smartObservations[4].value = hasUploadedImage ? Math.round(parseFloat(reliefDepthSlider.value) * 100) : 0;
      smartObservations[4].status = hasUploadedImage ? (mirrorImageEnabled ? 'MIRROR' : 'DIRECT') : 'OFF';
      smartObservations[5].value = Number(peakImpact.toFixed(2));
      smartObservations[5].status = peakImpact > 1.2 ? 'PEAK' : 'IDLE';

      for (let i = 0; i < daemons.length; i++) {
        const d = daemons[i];
        const phaseWave = 0.5 + 0.5 * Math.sin(elapsed * (1.5 + i * 0.25) + i * 0.7);
        const signalMix = f1Aperture * 0.35 + f2Spread * 0.3 + plosiveEnergy * 0.2 + pingEchoLevel * 0.25 + phaseWave * 0.2;
        d.waveVal = Math.min(1.0, signalMix);
        if (d.enabled && d.waveVal > 0.52 && Math.floor(elapsed * 8 + i) !== Math.floor((elapsed - dt) * 8 + i)) {
          d.pulses++;
        }
        d.state = !d.enabled ? 'OFF' : (d.waveVal > 0.6 ? 'PEAK' : 'LOCK');
      }

      if (!ecoModeEnabled) {
        for (let i = 0; i < aiSatMeshes.length; i++) {
          const sat = aiSatMeshes[i];
          const a = (i / aiSatMeshes.length) * Math.PI * 2 + elapsed * 0.35;
          sat.position.set(
            Math.cos(a) * (1.46 + f1Aperture * 0.12 + pingEchoLevel * 0.08),
            Math.sin(a) * 1.05 + 0.08,
            0.22 + Math.sin(elapsed * 1.8 + i) * 0.1
          );
          sat.rotation.y += dt * 2.0;
        }
      }
    }

    // =========================================================================
    // 8. EYES, LIPS SPRING SOLVER & VECTOR MATRIX
    // =========================================================================
    let nextBlinkTime = 2.4;
    let blinkProgress = 0;

    function updateRealEyes(dt, elapsed) {
      if (!leftEyeRig || !rightEyeRig) return;
      if (blinkProgress === 0 && elapsed >= nextBlinkTime) {
        blinkProgress = 0.01;
        nextBlinkTime = elapsed + 2.5 + (Math.sin(elapsed * 7.3) * 0.5 + 0.5) * 2.8;
      }

      let lidCloseAmount = 0;
      if (blinkProgress > 0) {
        blinkProgress += dt * 6.5;
        if (blinkProgress >= 2.0) {
          blinkProgress = 0;
          lidCloseAmount = 0;
        } else {
          lidCloseAmount = blinkProgress <= 1.0 ? blinkProgress : (2.0 - blinkProgress);
        }
      }

      let reactionLidOffset = 0;
      if (activeReaction === 'surprise') reactionLidOffset = -0.14;
      else if (activeReaction === 'squint') reactionLidOffset = 0.16;

      const eyeOpenBoost = Math.min(0.18, plosiveEnergy * 0.16);
      const upperRotX = -0.44 + lidCloseAmount * 0.62 - eyeOpenBoost * 0.4 + reactionLidOffset;
      const lowerRotX = 0.36 - lidCloseAmount * 0.54 + eyeOpenBoost * 0.3 - reactionLidOffset * 0.6;

      leftEyeRig.upperLid.rotation.x = upperRotX;
      rightEyeRig.upperLid.rotation.x = upperRotX;
      leftEyeRig.lowerLid.rotation.x = lowerRotX;
      rightEyeRig.lowerLid.rotation.x = lowerRotX;

      const targetLook = new THREE.Vector3(0, 0.15, 3.5);
      if (hasPointerGaze) targetLook.copy(gazePointerWorld);
      else targetLook.set(Math.sin(elapsed * 0.7) * 0.45, 0.1 - f1Aperture * 0.25, 3.2);

      [leftEyeRig, rightEyeRig].forEach((rig) => {
        const worldOrigin = new THREE.Vector3();
        rig.eyePivot.getWorldPosition(worldOrigin);
        const dir = targetLook.clone().sub(worldOrigin).normalize();
        const yaw = Math.max(-0.42, Math.min(0.42, Math.atan2(dir.x, dir.z)));
        const pitch = Math.max(-0.32, Math.min(0.32, Math.asin(Math.max(-0.8, Math.min(0.8, dir.y)))));

        rig.ballGroup.rotation.y += (yaw - rig.ballGroup.rotation.y) * Math.min(1, dt * 12);
        rig.ballGroup.rotation.x += (-pitch - rig.ballGroup.rotation.x) * Math.min(1, dt * 12);

        const pupilScale = Math.max(0.65, Math.min(1.55, 1.05 + plosiveEnergy * 0.38 - f2Spread * 0.18));
        rig.pupilMesh.scale.setScalar(pupilScale);
        rig.irisMat.color.setHSL(0.54 + f2Spread * 0.22, 0.9, 0.55 + plosiveEnergy * 0.15);
        rig.irisMat.emissiveIntensity = 0.22 + plosiveEnergy * 0.45;
      });
    }

    let prevF1 = 0;
    let prevPlosive = 0;
    const vectorTableBody = document.getElementById('vector-table-body');
    const sortSelect = document.getElementById('vector-sort-select');
    let showVectors = true;
    let latestRankedVectors = vectorNodes.slice();

    function stepLipsAndVectorMatrix(dt, elapsed) {
      const safeDt = Math.min(dt, 0.033);
      const viscosity = parseFloat(viscositySlider.value);
      const reliefDepth = hasUploadedImage ? parseFloat(reliefDepthSlider.value) : 0;

      const f1Delta = Math.max(0, f1Aperture - prevF1);
      const plosiveDelta = Math.max(0, plosiveEnergy - prevPlosive);
      prevF1 = f1Aperture;
      prevPlosive = plosiveEnergy;

      const rGasp = activeReaction === 'surprise' ? 0.55 : 0;
      const rPout = activeReaction === 'pout' ? 0.50 : 0;
      const rNod = activeReaction === 'bassnod' ? 0.45 : 0;
      const vowelPhase = Math.sin(elapsed * 7.0);

      springTarget[0] = f1Aperture * 0.85 + plosiveEnergy * 0.35 + rGasp * 0.5;
      springTarget[1] = f1Aperture * 1.15 + plosiveEnergy * 0.42 + rGasp * 0.7 + rNod * 0.4;
      springTarget[2] = (f2Spread * 0.95 - f1Aperture * 0.25) * (0.85 + 0.15 * vowelPhase) - rPout * 0.45;
      springTarget[3] = (f2Spread * 0.95 - f1Aperture * 0.25) * (0.85 + 0.15 * vowelPhase) - rPout * 0.45;
      springTarget[4] = f1Aperture * 0.78 + f2Spread * 0.25 + rGasp * 0.4;
      springTarget[5] = f1Aperture * 0.78 + f2Spread * 0.25 + rGasp * 0.4;
      springTarget[6] = f1Aperture * 0.96 + plosiveEnergy * 0.25 + rGasp * 0.5;
      springTarget[7] = f1Aperture * 0.96 + plosiveEnergy * 0.25 + rGasp * 0.5;
      springTarget[8] = f1Aperture * 1.22 + plosiveEnergy * 0.35 + rGasp * 0.65 + rNod * 0.6;
      springTarget[9] = f2Spread * 0.75 + plosiveEnergy * 0.30 + rPout * 0.35;
      springTarget[10] = f2Spread * 0.75 + plosiveEnergy * 0.30 + rPout * 0.35;
      springTarget[11] = plosiveEnergy * 0.55 + rPout * 0.35;
      springTarget[12] = plosiveEnergy * 0.72 + f2Spread * 0.20 + rGasp * 0.65;
      springTarget[13] = plosiveEnergy * 0.72 + f2Spread * 0.20 + rGasp * 0.65;
      springTarget[14] = f1Aperture * 0.55 + plosiveEnergy * 0.25 + rGasp * 0.35;
      springTarget[15] = f2Spread * 0.50 + plosiveEnergy * 0.30;

      const stiffness = 92.0;
      const damping = 13.8;

      for (let i = 0; i < ZONE_COUNT; i++) {
        const prevP = springPos[i];
        const accel = (springTarget[i] - springPos[i]) * stiffness - springVel[i] * damping;
        springVel[i] += accel * safeDt;
        springPos[i] += springVel[i] * safeDt;

        const node = vectorNodes[i];
        node.trajectoryVel = Math.abs(springPos[i] - prevP) / Math.max(0.004, safeDt);
        node.resonance = Math.abs(springTarget[i]);

        const hitImpulse = f1Delta * (i <= 8 ? 3.5 : 1.0) + plosiveDelta * (i <= 7 ? 3.8 : 1.3);
        node.impactForce = Math.max(0, node.impactForce * Math.exp(-safeDt * 3.0) + hitImpulse);

        if (!ecoModeEnabled && node.impactForce > 0.78 && (elapsed - node.lastShockTime) > 0.45) {
          node.lastShockTime = elapsed;
          spawnShockwave(
            node.anchor,
            node.anchor.clone().normalize(),
            Math.min(1.4, node.impactForce * 0.65),
            i <= 7 ? 0x22d3ee : 0xe879f9
          );
        }

        const rad = node.anchor.clone().normalize();
        const vSign = (i === 0 || i === 4 || i === 5 || i === 12 || i === 13) ? 1.0 : -1.0;
        node.velocityVec.set(
          rad.x * springVel[i] * 0.14,
          vSign * springVel[i] * 0.18 + Math.sin(elapsed * 2.5 + i) * 0.015,
          rad.z * (0.08 + Math.abs(springPos[i]) * 0.22)
        );
      }

      if (headGeometry && headGeometry.attributes && headGeometry.attributes.position) {
        const posAttr = headGeometry.attributes.position;
        const base = headGeometry.userData.basePositions;
        const sculpt = headGeometry.userData.sculptOffsets;
        const relax = freezeLiquid ? 1.0 : Math.pow(viscosity, safeDt * 12.0);

        const z0 = springPos[0], z1 = springPos[1], z2 = springPos[2], z3 = springPos[3];
        const z4 = springPos[4], z5 = springPos[5], z6 = springPos[6], z7 = springPos[7];
        const z8 = springPos[8], z9 = springPos[9], z10 = springPos[10], z11 = springPos[11];
        const z12 = springPos[12], z13 = springPos[13], z14 = springPos[14], z15 = springPos[15];

        for (let i = 0; i < posAttr.count; i++) {
          const idx = i * 3;
          if (!freezeLiquid && relax < 0.9999) {
            sculpt[idx] *= relax;
            sculpt[idx + 1] *= relax;
            sculpt[idx + 2] *= relax;
          }

          let x = base[idx] + sculpt[idx];
          let y = base[idx + 1] + sculpt[idx + 1];
          let z = base[idx + 2] + sculpt[idx + 2];

          if (z > -0.15) {
            if (reliefDepth > 0.001) {
              const hVal = sampleImageRelief(base[idx], base[idx + 1]);
              z += hVal * reliefDepth * (0.65 + f1Aperture * 0.35 + pingEchoLevel * 0.25);
            }

            const upperC = Math.exp(-(x * x / 0.022 + Math.pow(y + 0.42, 2) / 0.005));
            const lowerC = Math.exp(-(x * x / 0.022 + Math.pow(y + 0.51, 2) / 0.006));
            const upperL = Math.exp(-(Math.pow(x + 0.13, 2) / 0.024 + Math.pow(y + 0.43, 2) / 0.006));
            const upperR = Math.exp(-(Math.pow(x - 0.13, 2) / 0.024 + Math.pow(y + 0.43, 2) / 0.006));
            const lowerL = Math.exp(-(Math.pow(x + 0.13, 2) / 0.024 + Math.pow(y + 0.50, 2) / 0.007));
            const lowerR = Math.exp(-(Math.pow(x - 0.13, 2) / 0.024 + Math.pow(y + 0.50, 2) / 0.007));
            const cornerL = Math.exp(-(Math.pow(x + 0.23, 2) / 0.018 + Math.pow(y + 0.465, 2) / 0.008));
            const cornerR = Math.exp(-(Math.pow(x - 0.23, 2) / 0.018 + Math.pow(y + 0.465, 2) / 0.008));

            y += upperC * z0 * 0.08 + upperL * z4 * 0.068 + upperR * z5 * 0.068;
            y -= lowerC * z1 * 0.12 + lowerL * z6 * 0.10 + lowerR * z7 * 0.10;
            z += (upperC * z0 + lowerC * z1) * 0.048;

            x -= cornerL * z2 * 0.07;
            x += cornerR * z3 * 0.07;
            y += (cornerL * z2 + cornerR * z3) * 0.025;

            if (y < -0.25) {
              const jt = Math.min(1.0, (-0.25 - y) / 1.05);
              const sj = jt * jt * (3.0 - 2.0 * jt);
              y -= sj * z8 * 0.15;
              z += sj * z8 * 0.055;
            }

            const cheekL = Math.exp(-(Math.pow(x + 0.50, 2) / 0.07 + Math.pow(y + 0.04, 2) / 0.06));
            const cheekR = Math.exp(-(Math.pow(x - 0.50, 2) / 0.07 + Math.pow(y + 0.04, 2) / 0.06));
            x -= cheekL * z9 * 0.05;
            z += cheekL * z9 * 0.08;
            x += cheekR * z10 * 0.05;
            z += cheekR * z10 * 0.08;

            const noseM = Math.exp(-(x * x / 0.025 + Math.pow(y + 0.14, 2) / 0.025));
            z += noseM * z11 * 0.045;

            const browL = Math.exp(-(Math.pow(x + 0.34, 2) / 0.055 + Math.pow(y - 0.36, 2) / 0.02));
            const browR = Math.exp(-(Math.pow(x - 0.34, 2) / 0.055 + Math.pow(y - 0.36, 2) / 0.02));
            y += browL * z12 * 0.065 + browR * z13 * 0.065;
            z += browL * z12 * 0.035 + browR * z13 * 0.035;

            const frontM = Math.exp(-Math.pow(y - 0.72, 2) / 0.12);
            z += frontM * z14 * 0.04 * Math.cos(x * 2.6);

            const tempM = Math.exp(-Math.pow(Math.abs(x) - 0.78, 2) / 0.08);
            x += Math.sign(x) * tempM * z15 * 0.035;
          }

          posAttr.setXYZ(i, x, y, z);
        }

        posAttr.needsUpdate = true;
        if (!ecoModeEnabled) {
          headGeometry.computeVertexNormals();
        }
      }

      const sortBy = sortSelect.value;
      latestRankedVectors = vectorNodes.slice().sort((a, b) => {
        if (sortBy === 'trajectory') return b.trajectoryVel - a.trajectoryVel;
        if (sortBy === 'nodeId') return a.id - b.id;
        if (sortBy === 'resonance') return b.resonance - a.resonance;
        return b.impactForce - a.impactForce;
      });

      if (vectorGroup && arrowHelpers.length === ZONE_COUNT) {
        vectorGroup.visible = showVectors && !ecoModeEnabled;
        if (vectorGroup.visible) {
          const rankMap = new Uint8Array(ZONE_COUNT);
          for (let r = 0; r < latestRankedVectors.length; r++) rankMap[latestRankedVectors[r].id] = r;

          const dirVec = new THREE.Vector3();
          for (let i = 0; i < ZONE_COUNT; i++) {
            const node = vectorNodes[i];
            const r = rankMap[i];
            const arrow = arrowHelpers[i];
            const line = ribbonLines[i];

            const origin = node.anchor.clone().addScaledVector(node.anchor.clone().normalize(), springPos[i] * 0.14);
            arrow.position.copy(origin);

            if (node.velocityVec.lengthSq() > 0.00001) dirVec.copy(node.velocityVec).normalize();
            else dirVec.copy(node.anchor).normalize();
            arrow.setDirection(dirVec);

            const rBoost = r < 3 ? 1.35 : r < 8 ? 1.05 : 0.85;
            const len = Math.min(0.55, Math.max(0.11, (0.12 + node.trajectoryVel * 0.04 + node.impactForce * 0.16) * rBoost));
            arrow.setLength(len, Math.min(0.085, len * 0.34), Math.min(0.06, len * 0.24));

            const hex = r < 3 ? 0xf472b6 : (r < 8 ? 0x22d3ee : 0x34d399);
            arrow.setColor(hex);
            line.material.color.setHex(hex);

            const tip = origin.clone().addScaledVector(dirVec, len);
            const pArr = line.geometry.attributes.position.array;
            for (let h = RIBBON_LEN - 1; h > 0; h--) {
              pArr[h * 3] = pArr[(h - 1) * 3];
              pArr[h * 3 + 1] = pArr[(h - 1) * 3 + 1];
              pArr[h * 3 + 2] = pArr[(h - 1) * 3 + 2];
            }
            pArr[0] = tip.x;
            pArr[1] = tip.y;
            pArr[2] = tip.z;
            line.geometry.attributes.position.needsUpdate = true;
          }
        }
      }
    }

    // =========================================================================
    // 9. 2D CANVAS STUDIO RENDERER (ECO MODE & AUTOMATIC FALLBACK)
    // =========================================================================
    function render2dStudioStage(elapsed) {
      if (!fallback2dCtx) return;
      const w = fallback2dCanvas.width;
      const h = fallback2dCanvas.height;
      fallback2dCtx.clearRect(0, 0, w, h);

      fallback2dCtx.fillStyle = '#03060c';
      fallback2dCtx.fillRect(0, 0, w, h);

      const cx = w * 0.5;
      const cy = h * 0.5;
      const scale = Math.min(w, h) * 0.26 * zoomMultiplier;

      if (pingEchoLevel > 0.02) {
        fallback2dCtx.strokeStyle = `rgba(34, 211, 238, ${pingEchoLevel * 0.65})`;
        fallback2dCtx.lineWidth = 3;
        fallback2dCtx.beginPath();
        fallback2dCtx.arc(cx, cy, scale * (1.2 + (1.0 - pingEchoLevel) * 1.4), 0, Math.PI * 2);
        fallback2dCtx.stroke();
      }

      fallback2dCtx.save();
      fallback2dCtx.translate(cx, cy);
      fallback2dCtx.rotate(curRoll + Math.sin(elapsed * 0.8) * 0.02);
      const yawScaleX = Math.max(0.45, Math.cos(curYaw));
      fallback2dCtx.scale(yawScaleX, 1);

      fallback2dCtx.strokeStyle = '#38bdf8';
      fallback2dCtx.fillStyle = 'rgba(14, 165, 233, 0.12)';
      fallback2dCtx.lineWidth = 2.5;
      fallback2dCtx.beginPath();
      fallback2dCtx.ellipse(0, 0, scale * 0.78, scale * 1.05, 0, 0, Math.PI * 2);
      fallback2dCtx.fill();
      fallback2dCtx.stroke();

      if (hasUploadedImage) {
        fallback2dCtx.save();
        fallback2dCtx.beginPath();
        fallback2dCtx.ellipse(0, 0, scale * 0.72, scale * 0.98, 0, 0, Math.PI * 2);
        fallback2dCtx.clip();
        fallback2dCtx.globalAlpha = 0.55;
        fallback2dCtx.drawImage(editCanvas, -scale * 0.72, -scale * 0.98, scale * 1.44, scale * 1.96);
        fallback2dCtx.restore();
      }

      const eyeY = -scale * 0.22;
      const eyeOffsetX = scale * 0.30;
      const pupilR = scale * (0.055 + plosiveEnergy * 0.035);
      [-1, 1].forEach((s) => {
        const ex = s * eyeOffsetX;
        fallback2dCtx.fillStyle = '#f8fafc';
        fallback2dCtx.beginPath();
        fallback2dCtx.ellipse(ex, eyeY, scale * 0.14, scale * 0.085, 0, 0, Math.PI * 2);
        fallback2dCtx.fill();

        fallback2dCtx.fillStyle = '#0284c7';
        fallback2dCtx.beginPath();
        fallback2dCtx.arc(ex, eyeY, scale * 0.085, 0, Math.PI * 2);
        fallback2dCtx.fill();

        fallback2dCtx.fillStyle = '#020617';
        fallback2dCtx.beginPath();
        fallback2dCtx.arc(ex, eyeY, pupilR, 0, Math.PI * 2);
        fallback2dCtx.fill();
      });

      const mouthY = scale * 0.42;
      const mouthW = scale * (0.28 + f2Spread * 0.18);
      const mouthOpen = scale * (0.04 + f1Aperture * 0.22 + springPos[1] * 0.08);
      fallback2dCtx.strokeStyle = '#f472b6';
      fallback2dCtx.fillStyle = 'rgba(232, 121, 249, 0.25)';
      fallback2dCtx.lineWidth = 2.5;
      fallback2dCtx.beginPath();
      fallback2dCtx.ellipse(0, mouthY, mouthW, Math.max(4, mouthOpen), 0, 0, Math.PI * 2);
      fallback2dCtx.fill();
      fallback2dCtx.stroke();

      fallback2dCtx.restore();
    }

    // =========================================================================
    // 10. THROTTLED HUD (~12 Hz) & OSCILLOSCOPE RENDERER
    // =========================================================================
    function renderOscilloscope(elapsed) {
      if (activeApp !== 2 || !oscCtx || !oscCanvas.width || !oscCanvas.height) return;
      const w = oscCanvas.width;
      const h = oscCanvas.height;
      oscCtx.clearRect(0, 0, w, h);

      oscCtx.strokeStyle = 'rgba(56, 189, 248, 0.12)';
      oscCtx.lineWidth = 1;
      for (let gx = 0; gx <= 8; gx++) {
        const x = (gx / 8) * w;
        oscCtx.beginPath(); oscCtx.moveTo(x, 0); oscCtx.lineTo(x, h); oscCtx.stroke();
      }
      for (let gy = 0; gy <= 4; gy++) {
        const y = (gy / 4) * h;
        oscCtx.beginPath(); oscCtx.moveTo(0, y); oscCtx.lineTo(w, y); oscCtx.stroke();
      }

      oscCtx.strokeStyle = '#22d3ee';
      oscCtx.lineWidth = 2;
      oscCtx.beginPath();
      const samples = ecoModeEnabled ? 64 : 112;
      for (let i = 0; i <= samples; i++) {
        const tNorm = i / samples;
        const x = tNorm * w;
        let amp = 0;
        if (timeDomainData && activeAudioMode !== 'none') {
          const idx = Math.min(timeDomainData.length - 1, Math.floor(tNorm * timeDomainData.length));
          amp = (timeDomainData[idx] - 128) / 128;
        } else {
          amp = (Math.sin(tNorm * Math.PI * 6 + elapsed * 4) * f1Aperture + Math.cos(tNorm * Math.PI * 10 - elapsed * 5) * (f2Spread + pingEchoLevel * 0.4)) * 0.5;
        }
        const y = h * 0.5 - amp * (h * 0.38);
        if (i === 0) oscCtx.moveTo(x, y);
        else oscCtx.lineTo(x, y);
      }
      oscCtx.stroke();

      oscCtx.strokeStyle = '#e879f9';
      oscCtx.lineWidth = 1.5;
      oscCtx.beginPath();
      for (let i = 0; i <= samples; i++) {
        const tNorm = i / samples;
        const x = tNorm * w;
        const y = h * 0.5 - Math.sin(tNorm * Math.PI * 4 + elapsed * 3) * (purifiedSignal * h * 0.38);
        if (i === 0) oscCtx.moveTo(x, y);
        else oscCtx.lineTo(x, y);
      }
      oscCtx.stroke();
    }

