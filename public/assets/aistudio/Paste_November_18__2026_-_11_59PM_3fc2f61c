          sat.position.set(Math.cos(angle) * 1.48, Math.sin(angle) * 1.05 + 0.08, 0.25);
          aiUnitGroup.add(sat);
          aiSatMeshes.push(sat);
        }

        vectorGroup = new THREE.Group();
        headMesh.add(vectorGroup);
        arrowHelpers.length = 0;
        ribbonLines.length = 0;
        for (let i = 0; i < ZONE_COUNT; i++) {
          const node = vectorNodes[i];
          const arrow = new THREE.ArrowHelper(
