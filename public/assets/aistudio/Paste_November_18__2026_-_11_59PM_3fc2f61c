    function updateShockwaves(dt, elapsed) {
      if (autoPingEnabled && !faceOpsLocked && elapsed >= nextAutoPingTime) {
        emitSonarPing();
        nextAutoPingTime = elapsed + 1.8;
      }

      const decayFactor = Math.pow(parseFloat(pingDecaySlider.value), dt * 4.0);
      pingEchoLevel *= decayFactor;
      shaderUniforms.uPingWave.value = pingEchoLevel;
      pingTelemetryBadge.textContent = `ECHO: ${pingEchoLevel.toFixed(2)} | ${pingLatencyMs}ms`;

      for (let i = shockwaves.length - 1; i >= 0; i--) {
        const sw = shockwaves[i];
        sw.age += dt;
        const t = sw.age / sw.maxAge;
        if (t >= 1.0) {
          if (shockwaveGroup) shockwaveGroup.remove(sw.mesh);
          sw.mesh.geometry.dispose();
          sw.mesh.material.dispose();
          shockwaves.splice(i, 1);
        } else {
          const s = 1.0 + sw.age * sw.speed * 4.4;
          sw.mesh.scale.set(s, s, 1);
          sw.mesh.material.opacity = (1.0 - t) * (1.0 - t) * 0.88;
        }
      }
      document.getElementById('shockwave-count').textContent = String(shockwaves.length);
    }

    let activeBrushMode = 'push';
    let freezeLiquid = false;
    let isSculptDragging = false;
    const prevDragPt = new THREE.Vector3();
    let hasPrevDragPt = false;
    const gazePointerWorld = new THREE.Vector3(0, 0.1, 3.5);
    let hasPointerGaze = false;

    const raycaster = new THREE.Raycaster();
    const pointerNdc = new THREE.Vector2();
    const radiusSlider = document.getElementById('radius-slider');
    const viscositySlider = document.getElementById('viscosity-slider');
    const polaritySlider = document.getElementById('polarity-slider');

    function applyLiquidBrushAt(localHit, normalHit, dtStep = 0.016, triggerShock = false) {
      if (faceOpsLocked) return;
      const radius = parseFloat(radiusSlider.value);
      const polarity = parseFloat(polaritySlider.value);
      const invR2 = 1.0 / Math.max(0.015, radius * radius);
      const sign = activeBrushMode === 'pull' ? -1.0 : 1.0;
      const effectiveSign = sign * Math.sign(polarity || 1);

      shaderUniforms.uBrushCenter.value.copy(localHit);
      shaderUniforms.uBrushRadius.value = radius;
      shaderUniforms.uBrushActive.value = 1.0;
      shaderUniforms.uBrushPolarity.value = effectiveSign;

      if (headGeometry && headGeometry.attributes && headGeometry.attributes.position) {
        const posAttr = headGeometry.attributes.position;
        const base = headGeometry.userData.basePositions;
        const sculpt = headGeometry.userData.sculptOffsets;
        const tangent = new THREE.Vector3();
        if (hasPrevDragPt) tangent.subVectors(localHit, prevDragPt);
        const strength = 0.042 * Math.abs(polarity) * (dtStep / 0.016);

        for (let i = 0; i < posAttr.count; i++) {
          const idx = i * 3;
          const bx = base[idx] + sculpt[idx];
          const by = base[idx + 1] + sculpt[idx + 1];
          const bz = base[idx + 2] + sculpt[idx + 2];

          const dx = bx - localHit.x;
          const dy = by - localHit.y;
          const dz = bz - localHit.z;
          const d2 = dx * dx + dy * dy + dz * dz;
          if (d2 > radius * radius * 3.2) continue;

          const falloff = Math.exp(-d2 * invR2 * 2.2);

          if (activeBrushMode === 'push' || activeBrushMode === 'pull') {
            sculpt[idx] += normalHit.x * falloff * strength * effectiveSign;
            sculpt[idx + 1] += normalHit.y * falloff * strength * effectiveSign;
            sculpt[idx + 2] += normalHit.z * falloff * strength * effectiveSign;
          } else if (activeBrushMode === 'vortex') {
            const rx = dy * normalHit.z - dz * normalHit.y;
            const ry = dz * normalHit.x - dx * normalHit.z;
            const rz = dx * normalHit.y - dy * normalHit.x;
            sculpt[idx] += (rx * 1.6 + tangent.x * 0.45) * falloff * strength * effectiveSign;
            sculpt[idx + 1] += (ry * 1.6 + tangent.y * 0.45) * falloff * strength * effectiveSign;
            sculpt[idx + 2] += (rz * 1.6 + tangent.z * 0.45) * falloff * strength * effectiveSign;
          } else if (activeBrushMode === 'pinch') {
            sculpt[idx] += (-dx * 0.65 + normalHit.x * 0.25) * falloff * strength * effectiveSign;
            sculpt[idx + 1] += (-dy * 0.65 + normalHit.y * 0.25) * falloff * strength * effectiveSign;
            sculpt[idx + 2] += (-dz * 0.65 + normalHit.z * 0.25) * falloff * strength * effectiveSign;
          }

          const mag = Math.hypot(sculpt[idx], sculpt[idx + 1], sculpt[idx + 2]);
          if (mag > 0.48) {
            const s = 0.48 / mag;
            sculpt[idx] *= s;
            sculpt[idx + 1] *= s;
            sculpt[idx + 2] *= s;
          }
        }
      }

      if (hasUploadedImage && triggerShock) {
        applyLiquidBrushToImageCanvas(localHit, radius, effectiveSign);
      }

      for (let z = 0; z < ZONE_COUNT; z++) {
        const node = vectorNodes[z];
        const dist = node.anchor.distanceTo(localHit);
        if (dist < radius * 1.75) {
          const coupling = Math.exp(-(dist * dist) * invR2 * 1.5);
          springVel[z] += coupling * effectiveSign * Math.abs(polarity) * 4.2;
          node.impactForce = Math.min(3.5, node.impactForce + coupling * Math.abs(polarity) * 0.85);
        }
      }

      if (triggerShock) {
        spawnShockwave(localHit, normalHit, Math.min(1.5, Math.abs(polarity)), effectiveSign >= 0 ? 0x22d3ee : 0xf472b6);
      }

      prevDragPt.copy(localHit);
      hasPrevDragPt = true;
    }

    function raycastFaceFromClient(clientX, clientY) {
      if (!renderer || !headMesh || !camera) return null;
      const rect = renderer.domElement.getBoundingClientRect();
      pointerNdc.x = ((clientX - rect.left) / rect.width) * 2 - 1;
      pointerNdc.y = -((clientY - rect.top) / rect.height) * 2 + 1;

      raycaster.setFromCamera(pointerNdc, camera);
      gazePointerWorld.copy(raycaster.ray.origin).addScaledVector(raycaster.ray.direction, 3.2);
      hasPointerGaze = true;

      const hits = raycaster.intersectObject(headMesh, false);
      if (hits.length > 0) {
        const localHit = headMesh.worldToLocal(hits[0].point.clone());
        const normalHit = hits[0].face
          ? hits[0].face.normal.clone().normalize()
          : localHit.clone().normalize();
        return { localHit, normalHit };
      }
      return null;
    }

