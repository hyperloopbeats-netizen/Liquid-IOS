    function rebuildReliefMapFromCanvas() {
      const sampleCanvas = document.createElement('canvas');
      sampleCanvas.width = RELIEF_W;
      sampleCanvas.height = RELIEF_H;
      const sCtx = sampleCanvas.getContext('2d');
      sCtx.drawImage(editCanvas, 0, 0, RELIEF_W, RELIEF_H);
      const data = sCtx.getImageData(0, 0, RELIEF_W, RELIEF_H).data;

      for (let y = 0; y < RELIEF_H; y++) {
        for (let x = 0; x < RELIEF_W; x++) {
          const sx = mirrorImageEnabled && x > RELIEF_W * 0.5 ? (RELIEF_W - 1 - x) : x;
          const idx = (y * RELIEF_W + sx) * 4;
          const lum = (0.299 * data[idx] + 0.587 * data[idx + 1] + 0.114 * data[idx + 2]) / 255.0;
          reliefHeightMap[y * RELIEF_W + x] = (lum - 0.5) * 2.0;
        }
      }
      if (uploadedImageTexture) uploadedImageTexture.needsUpdate = true;

      previewCtx.clearRect(0, 0, previewCanvas.width, previewCanvas.height);
      previewCtx.drawImage(editCanvas, 0, 0, previewCanvas.width, previewCanvas.height);
    }

    function applyLiquidBrushToImageCanvas(localPt, radius, effectiveSign) {
      if (!hasUploadedImage) return;
      const u = Math.max(0, Math.min(1, localPt.x * 0.65 + 0.5));
      const v = Math.max(0, Math.min(1, -localPt.y * 0.55 + 0.5));
      const cx = u * editCanvas.width;
      const cy = v * editCanvas.height;
      const rPx = Math.max(8, radius * 85);

      const snapshot = document.createElement('canvas');
      snapshot.width = editCanvas.width;
      snapshot.height = editCanvas.height;
      snapshot.getContext('2d').drawImage(editCanvas, 0, 0);

      editCtx.save();
      editCtx.beginPath();
      editCtx.arc(cx, cy, rPx, 0, Math.PI * 2);
      editCtx.clip();
      const scale = effectiveSign >= 0 ? 1.04 : 0.96;
      editCtx.translate(cx, cy);
      editCtx.scale(scale, scale);
      editCtx.rotate(activeBrushMode === 'vortex' ? 0.06 * effectiveSign : 0);
      editCtx.drawImage(snapshot, -cx, -cy);
      editCtx.restore();

      rebuildReliefMapFromCanvas();
    }

