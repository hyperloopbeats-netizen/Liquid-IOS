    }, { passive: false });

    function attachPointerListeners(el) {
      el.addEventListener('pointerdown', (e) => {
        if (activeApp !== 1) return;
        const hit = raycastFaceFromClient(e.clientX, e.clientY);

        if (opMode === 'rotate') {
          if (faceOpsLocked) return;
          isRotateDragging = true;
          lastRotPointerX = e.clientX;
          lastRotPointerY = e.clientY;
          return;
        }
        if (opMode === 'orbit') {
          isOrbitDragging = true;
          lastOrbitPointerX = e.clientX;
          lastOrbitPointerY = e.clientY;
          return;
        }
        if (opMode === 'ping') {
          if (faceOpsLocked) return;
          if (hit) emitSonarPing(hit.localHit, hit.normalHit);
          else emitSonarPing();
          return;
        }
        if (opMode === 'sculpt') {
          if (faceOpsLocked) return;
          if (e.pointerType === 'mouse' && e.button !== 0) return;
          if (hit) {
            isSculptDragging = true;
            hasPrevDragPt = false;
            applyLiquidBrushAt(hit.localHit, hit.normalHit, 0.02, true);
          } else if (ecoModeEnabled || !webglAvailable) {
            emitSonarPing();
          }
        }
      });

      el.addEventListener('pointermove', (e) => {
        if (activeApp !== 1) return;
        const hit = raycastFaceFromClient(e.clientX, e.clientY);

        if (isOrbitDragging && opMode === 'orbit' && camera && controls) {
          const dx = e.clientX - lastOrbitPointerX;
          const dy = e.clientY - lastOrbitPointerY;
          lastOrbitPointerX = e.clientX;
          lastOrbitPointerY = e.clientY;
          const offset = camera.position.clone().sub(controls.target);
          const spherical = new THREE.Spherical().setFromVector3(offset);
          spherical.theta -= dx * 0.0065;
          spherical.phi = Math.max(0.25, Math.min(Math.PI - 0.25, spherical.phi - dy * 0.0065));
          offset.setFromSpherical(spherical);
          camera.position.copy(controls.target).add(offset);
          controls.update();
          return;
        }

        if (isRotateDragging && opMode === 'rotate' && !faceOpsLocked) {
          const dx = e.clientX - lastRotPointerX;
          const dy = e.clientY - lastRotPointerY;
          lastRotPointerX = e.clientX;
          lastRotPointerY = e.clientY;
          targetYaw = Math.max(-1.57, Math.min(1.57, targetYaw + dx * 0.008));
          targetPitch = Math.max(-0.95, Math.min(0.95, targetPitch + dy * 0.007));
          velYaw = dx * 0.04;
          velPitch = dy * 0.035;
          syncRotationSliders();
          return;
        }

        if (!isSculptDragging || opMode !== 'sculpt' || faceOpsLocked) return;
        if (hit) applyLiquidBrushAt(hit.localHit, hit.normalHit, 0.016, false);
      });
    }

    attachPointerListeners(container);
    attachPointerListeners(fallback2dCanvas);

    window.addEventListener('pointerup', () => {
      isSculptDragging = false;
      hasPrevDragPt = false;
      isRotateDragging = false;
      isOrbitDragging = false;
    });

    const modeSculptBtn = document.getElementById('mode-sculpt-btn');
    const modeOrbitBtn = document.getElementById('mode-orbit-btn');
    const modePingBtn = document.getElementById('mode-ping-btn');
    const modeRotateBtn = document.getElementById('mode-rotate-btn');

    function setOpMode(mode) {
      opMode = mode;
      const activeCls = 'px-2 py-1 rounded-xl text-[10px] font-semibold bg-emerald-500/25 text-emerald-200 border border-emerald-400/40 transition';
      const idleCls = 'px-2 py-1 rounded-xl text-[10px] font-semibold text-slate-300 hover:bg-slate-800/70 border border-transparent transition';
      modeSculptBtn.className = mode === 'sculpt' ? activeCls : idleCls;
      modeOrbitBtn.className = mode === 'orbit'
        ? 'px-2 py-1 rounded-xl text-[10px] font-semibold bg-amber-500/25 text-amber-200 border border-amber-400/40 transition'
        : idleCls;
      modePingBtn.className = mode === 'ping'
        ? 'px-2 py-1 rounded-xl text-[10px] font-semibold bg-fuchsia-500/25 text-fuchsia-200 border border-fuchsia-400/40 transition'
        : idleCls;
      modeRotateBtn.className = mode === 'rotate'
        ? 'px-2 py-1 rounded-xl text-[10px] font-semibold bg-cyan-500/25 text-cyan-200 border border-cyan-400/40 transition'
        : idleCls;
    }

    modeSculptBtn.addEventListener('click', () => setOpMode('sculpt'));
    modeOrbitBtn.addEventListener('click', () => setOpMode('orbit'));
    modePingBtn.addEventListener('click', () => setOpMode('ping'));
    modeRotateBtn.addEventListener('click', () => setOpMode('rotate'));

    autoReactionBtn.addEventListener('click', () => {
      autoReactionEnabled = !autoReactionEnabled;
      autoReactionBtn.textContent = `AUTO: ${autoReactionEnabled ? 'ON' : 'OFF'}`;
    });

    document.querySelectorAll('.react-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        activeReaction = btn.dataset.reaction || 'calm';
        manualReactionHoldUntil = elapsedSimTime + 2.8;
        if (activeReaction === 'surprise') {
          springVel[0] += 6.0; springVel[1] += 7.0; springVel[12] += 5.0; springVel[13] += 5.0;
        } else if (activeReaction === 'pout') {
          springVel[0] += 5.0; springVel[1] += 5.0; springVel[11] += 4.5;
          spawnShockwave(new THREE.Vector3(0, -0.46, 1.1), new THREE.Vector3(0, 0, 1), 1.2, 0xf472b6);
        } else if (activeReaction === 'bassnod') {
          springVel[8] += 7.5;
        } else if (activeReaction === 'ripple') {
          applyLiquidBrushAt(new THREE.Vector3(0, -0.1, 1.15), new THREE.Vector3(0, 0, 1), 0.025, true);
        }
      });
    });

    const leftBody = document.getElementById('left-panel-body');
    const rightBody = document.getElementById('right-panel-body');
    const collapseLeftBtn = document.getElementById('collapse-left-btn');
    const collapseRightBtn = document.getElementById('collapse-right-btn');
    const toggleAllHudBtn = document.getElementById('toggle-all-hud-btn');

    collapseLeftBtn.addEventListener('click', () => {
      const h = leftBody.classList.toggle('hidden');
      collapseLeftBtn.textContent = h ? '[+]' : '[−]';
    });
    collapseRightBtn.addEventListener('click', () => {
      const h = rightBody.classList.toggle('hidden');
      collapseRightBtn.textContent = h ? '[+]' : '[−]';
    });
    toggleAllHudBtn.addEventListener('click', () => {
      hudVisible = !hudVisible;
      if (activeApp === 1) {
        leftWrapper.classList.toggle('hidden', !hudVisible);
        rightWrapper.classList.toggle('hidden', !hudVisible);
      }
      toggleAllHudBtn.textContent = hudVisible ? 'HUD [−]' : 'HUD [+]';
    });

    const toggleVidMonBtn = document.getElementById('toggle-video-monitor-btn');
    const vidMonBody = document.getElementById('video-monitor-body');
    toggleVidMonBtn.addEventListener('click', () => {
      const h = vidMonBody.classList.toggle('hidden');
      toggleVidMonBtn.textContent = h ? '[+]' : '[−]';
    });

    if (window.innerWidth < 640) {
      leftBody.classList.add('hidden');
      collapseLeftBtn.textContent = '[+]';
      rightBody.classList.add('hidden');
      collapseRightBtn.textContent = '[+]';
    }

    document.getElementById('skin-select').addEventListener('change', (e) => {
      shaderUniforms.uSkinMode.value = parseInt(e.target.value, 10) || 0;
    });

    const brushBtns = document.querySelectorAll('.brush-btn');
    const brushLabel = document.getElementById('brush-mode-label');
    const brushNames = { push: 'PUSH OUTWARD', pull: 'PULL INWARD', vortex: 'VORTEX SWIRL', pinch: 'ELASTIC PINCH' };

    brushBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeBrushMode = btn.dataset.brush;
        brushLabel.textContent = brushNames[activeBrushMode] || 'PUSH OUTWARD';
        brushBtns.forEach((b) => {
          b.className = 'brush-btn py-1.5 rounded-lg text-[11px] font-semibold text-slate-400 hover:text-slate-100';
        });
        btn.className = 'brush-btn py-1.5 rounded-lg text-[11px] font-semibold bg-cyan-500/30 text-cyan-200 border border-cyan-400/40';
      });
    });

    radiusSlider.addEventListener('input', () => {
      document.getElementById('radius-val').textContent = parseFloat(radiusSlider.value).toFixed(2);
    });
    viscositySlider.addEventListener('input', () => {
      document.getElementById('viscosity-val').textContent = parseFloat(viscositySlider.value).toFixed(2);
    });
    polaritySlider.addEventListener('input', () => {
      const v = parseFloat(polaritySlider.value);
      document.getElementById('polarity-val').textContent = (v >= 0 ? '+' : '') + v.toFixed(2);
    });

    const freezeBtn = document.getElementById('freeze-liquid-btn');
    freezeBtn.addEventListener('click', () => {
      freezeLiquid = !freezeLiquid;
      freezeBtn.textContent = `Freeze Liquid: ${freezeLiquid ? 'ON' : 'Off'}`;
      freezeBtn.classList.toggle('bg-amber-500/25', freezeLiquid);
    });

    document.getElementById('reset-sculpt-btn').addEventListener('click', () => {
      if (faceOpsLocked) return;
      if (headGeometry && headGeometry.userData && headGeometry.userData.sculptOffsets) {
        headGeometry.userData.sculptOffsets.fill(0);
      }
      springPos.fill(0);
      springVel.fill(0);
      for (let i = 0; i < ZONE_COUNT; i++) {
        vectorNodes[i].impactForce = 0;
        vectorNodes[i].trajectoryVel = 0;
        vectorNodes[i].resonance = 0;
      }
      spawnShockwave(new THREE.Vector3(0, 0, 1.15), new THREE.Vector3(0, 0, 1), 1.2, 0x34d399);
    });

    const toggleVecBtn = document.getElementById('toggle-vectors-btn');
    toggleVecBtn.addEventListener('click', () => {
      showVectors = !showVectors;
      toggleVecBtn.textContent = `3D Vectors: ${showVectors ? 'ON' : 'OFF'}`;
    });

    document.getElementById('pulse-shockwave-btn').addEventListener('click', () => {
      for (let i = 0; i < 4; i++) {
        const n = vectorNodes[i * 3];
        n.impactForce += 1.35;
        springVel[n.id] += 5.5;
        spawnShockwave(n.anchor, n.anchor.clone().normalize(), 1.3, 0xe879f9);
      }
    });

    const fxExposureSlider = document.getElementById('fx-exposure-slider');
    const fxFogSlider = document.getElementById('fx-fog-slider');
    const fxStarsSlider = document.getElementById('fx-stars-slider');
    let starDriftRate = 1.0;

    fxExposureSlider.addEventListener('input', () => {
      const v = parseFloat(fxExposureSlider.value);
      if (renderer) renderer.toneMappingExposure = v;
      document.getElementById('fx-exposure-val').textContent = v.toFixed(2);
    });
    fxFogSlider.addEventListener('input', () => {
      const v = parseFloat(fxFogSlider.value);
      if (scene && scene.fog) scene.fog.density = v;
      document.getElementById('fx-fog-val').textContent = v.toFixed(3);
    });
    fxStarsSlider.addEventListener('input', () => {
      starDriftRate = parseFloat(fxStarsSlider.value);
      document.getElementById('fx-stars-val').textContent = `${starDriftRate.toFixed(2)}x`;
    });

    function startSynthVocalBeat() {
      ensureAudioContext();
      stopAllAudioSources();
      activeAudioMode = 'synth';
      trackTitle.textContent = 'Sovereign Formant Synth';
      trackTime.textContent = 'SYNTH LOOP';
      playPauseBtn.disabled = false;
      playPauseBtn.textContent = '❚❚ Pause';
      seekSlider.disabled = true;
      setEngineStatus('Synth Vocal Beat Active → Driving Lips & 20 Daemons', 'active');

      const formants = [[720, 1120], [520, 1850], [280, 2320], [560, 860], [310, 890]];
      let step = 0;

      const tick = () => {
        if (activeAudioMode !== 'synth' || !audioCtx) return;
        const now = audioCtx.currentTime;
        if (step % 4 === 0) {
          const kick = audioCtx.createOscillator();
          const kGain = audioCtx.createGain();
          kick.type = 'sine';
          kick.frequency.setValueAtTime(135, now);
          kick.frequency.exponentialRampToValueAtTime(42, now + 0.15);
          kGain.gain.setValueAtTime(0.65, now);
          kGain.gain.exponentialRampToValueAtTime(0.001, now + 0.25);
          kick.connect(kGain); kGain.connect(masterGain);
          kick.start(now); kick.stop(now + 0.26);
        }
        if (step % 2 === 0 || step % 7 === 0) {
          const [f1, f2] = formants[Math.floor(step / 2) % formants.length];
          const osc = audioCtx.createOscillator();
          osc.type = 'sawtooth';
          osc.frequency.setValueAtTime(110 + (step % 5) * 18, now);
          const bp1 = audioCtx.createBiquadFilter(); bp1.type = 'bandpass'; bp1.frequency.setValueAtTime(f1, now); bp1.Q.value = 5.0;
          const bp2 = audioCtx.createBiquadFilter(); bp2.type = 'bandpass'; bp2.frequency.setValueAtTime(f2, now); bp2.Q.value = 6.0;
          const vGain = audioCtx.createGain();
          vGain.gain.setValueAtTime(0.001, now);
          vGain.gain.linearRampToValueAtTime(0.28, now + 0.025);
          vGain.gain.exponentialRampToValueAtTime(0.001, now + 0.20);
          osc.connect(bp1); osc.connect(bp2); bp1.connect(vGain); bp2.connect(vGain); vGain.connect(masterGain);
          osc.start(now); osc.stop(now + 0.22);
        }
        step = (step + 1) % 16;
      };
      tick();
      synthTimer = setInterval(tick, 125);
    }

    document.getElementById('mic-btn').addEventListener('click', async () => {
      try {
        ensureAudioContext();
        stopAllAudioSources();
        micStream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
        micSource = audioCtx.createMediaStreamSource(micStream);
        micSource.connect(analyser);
        activeAudioMode = 'mic';
        trackTitle.textContent = 'Live Microphone';
        trackTime.textContent = 'LIVE MIC';
        playPauseBtn.disabled = true;
        seekSlider.disabled = true;
        setEngineStatus('Live Mic Active — Speak to Drive Lips Engine', 'active');
      } catch (err) {
        setEngineStatus(`Mic Error: ${err.message}`, 'error');
      }
    });

    document.getElementById('synth-btn').addEventListener('click', startSynthVocalBeat);

    playPauseBtn.addEventListener('click', () => {
      if (activeAudioMode === 'video-element') {
        if (mp4VideoEl.paused) { mp4VideoEl.play().catch(() => {}); playPauseBtn.textContent = '❚❚ Pause'; }
        else { mp4VideoEl.pause(); playPauseBtn.textContent = '▶ Play'; }
      } else if (activeAudioMode === 'file-element') {
        if (htmlAudio.paused) { htmlAudio.play().catch(() => {}); playPauseBtn.textContent = '❚❚ Pause'; }
        else { htmlAudio.pause(); playPauseBtn.textContent = '▶ Play'; }
      } else if (activeAudioMode === 'file-buffer' && decodedAudioBuffer) {
        if (isBufferPlaying) {
          bufferOffset = Math.max(0, audioCtx.currentTime - bufferStartTime);
          try { bufferSource.stop(); } catch (_) {}
          isBufferPlaying = false;
          playPauseBtn.textContent = '▶ Play';
        } else {
          startBufferPlayback(bufferOffset);
        }
      } else if (activeAudioMode === 'synth') {
        if (synthTimer) { clearInterval(synthTimer); synthTimer = null; playPauseBtn.textContent = '▶ Play'; }
        else { startSynthVocalBeat(); }
      }
    });

    volumeSlider.addEventListener('input', () => {
      const v = parseFloat(volumeSlider.value);
      htmlAudio.volume = v;
      mp4VideoEl.volume = v;
      if (masterGain) masterGain.gain.value = v;
    });

    function fmtTime(sec) {
      if (!isFinite(sec) || sec < 0) return '00:00';
      const m = Math.floor(sec / 60);
      const s = Math.floor(sec % 60);
      return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
    }

    function updateTransportUI() {
      if (activeAudioMode === 'video-element' && isFinite(mp4VideoEl.duration) && mp4VideoEl.duration > 0) {
        seekSlider.value = String((mp4VideoEl.currentTime / mp4VideoEl.duration) * 100);
        trackTime.textContent = `${fmtTime(mp4VideoEl.currentTime)} / ${fmtTime(mp4VideoEl.duration)}`;
      } else if (activeAudioMode === 'file-element' && isFinite(htmlAudio.duration) && htmlAudio.duration > 0) {
        seekSlider.value = String((htmlAudio.currentTime / htmlAudio.duration) * 100);
        trackTime.textContent = `${fmtTime(htmlAudio.currentTime)} / ${fmtTime(htmlAudio.duration)}`;
      } else if (activeAudioMode === 'file-buffer' && decodedAudioBuffer) {
        const cur = isBufferPlaying
          ? Math.min(decodedAudioBuffer.duration, Math.max(0, audioCtx.currentTime - bufferStartTime))
          : bufferOffset;
        seekSlider.value = String((cur / decodedAudioBuffer.duration) * 100);
        trackTime.textContent = `${fmtTime(cur)} / ${fmtTime(decodedAudioBuffer.duration)}`;
      }
    }

    seekSlider.addEventListener('input', () => {
      const pct = parseFloat(seekSlider.value) / 100;
      if (activeAudioMode === 'video-element' && isFinite(mp4VideoEl.duration) && mp4VideoEl.duration > 0) {
        mp4VideoEl.currentTime = pct * mp4VideoEl.duration;
      } else if (activeAudioMode === 'file-element' && isFinite(htmlAudio.duration) && htmlAudio.duration > 0) {
        htmlAudio.currentTime = pct * htmlAudio.duration;
      } else if (activeAudioMode === 'file-buffer' && decodedAudioBuffer) {
        const targetSec = pct * decodedAudioBuffer.duration;
        if (isBufferPlaying) startBufferPlayback(targetSec);
        else bufferOffset = targetSec;
      }
    });

    labDaemonsGridEl.addEventListener('click', (e) => {
      const btn = e.target.closest('.daemon-card-btn');
      if (!btn) return;
      const idx = parseInt(btn.dataset.daemonIdx, 10);
      if (isFinite(idx) && daemons[idx]) {
        daemons[idx].enabled = !daemons[idx].enabled;
        if (daemons[idx].enabled) daemons[idx].pulses++;
      }
    });

    document.getElementById('lab-pulse-all-btn').addEventListener('click', () => {
      for (let i = 0; i < daemons.length; i++) {
        daemons[i].enabled = true;
        daemons[i].pulses++;
      }
      for (let z = 0; z < 4; z++) {
        const n = vectorNodes[z * 4];
        n.impactForce += 1.25;
        springVel[n.id] += 5.0;
      }
    });

    window.addEventListener('resize', () => {
      const dprCap = ecoModeEnabled ? 1.0 : Math.min(window.devicePixelRatio || 1, 1.5);
      if (camera && renderer) {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setPixelRatio(dprCap);
        renderer.setSize(window.innerWidth, window.innerHeight);
      }
      resizeFallback2dCanvas();
      resizeOscilloscopeCanvas();
    });

    let lastFrameMs = performance.now();
    let frameCount = 0;
    let fpsAccum = 0;

    function animate(nowMs = performance.now()) {
      requestAnimationFrame(animate);

      if (isDocumentHidden) {
        lastFrameMs = nowMs;
        return;
      }

      // Clamp frame delta time <= 0.05s to prevent OS spikes or runaway physics
      const rawDt = (nowMs - lastFrameMs) / 1000;
      lastFrameMs = nowMs;
      const dt = Math.max(0.001, Math.min(0.05, rawDt));
      elapsedSimTime += dt;

      frameCount++;
      fpsAccum += dt;
      if (fpsAccum >= 0.6) {
        fpsBadge.textContent = `${Math.min(60, Math.round(frameCount / fpsAccum))} FPS`;
        frameCount = 0;
        fpsAccum = 0;
      }

      extractVocalLipFeatures(elapsedSimTime);
      updateTransportUI();
      updateDaemonsAndObservations(dt, elapsedSimTime);
      stepLipsAndVectorMatrix(dt, elapsedSimTime);
      updateShockwaves(dt, elapsedSimTime);

      zoomMultiplier += (targetZoomMultiplier - zoomMultiplier) * Math.min(1, dt * 10);

      if (!faceOpsLocked) {
        if (!isRotateDragging) {
          targetYaw = Math.max(-1.57, Math.min(1.57, targetYaw + velYaw * dt * 10));
          targetPitch = Math.max(-0.95, Math.min(0.95, targetPitch + velPitch * dt * 10));
          velYaw *= Math.exp(-dt * 7.5);
          velPitch *= Math.exp(-dt * 7.5);
          if (Math.abs(velYaw) > 0.005 || Math.abs(velPitch) > 0.005) {
            syncRotationSliders();
          }
        }
        const orbitYaw = autoOrbitEnabled ? Math.sin(elapsedSimTime * 0.65) * 0.45 : 0;
        const nodPitch = activeReaction === 'bassnod' ? Math.sin(elapsedSimTime * 9.0) * bassEnergy * 0.09 : 0;

        curYaw += (targetYaw + orbitYaw - curYaw) * Math.min(1, dt * 10);
        curPitch += (targetPitch + nodPitch - curPitch) * Math.min(1, dt * 10);
        curRoll += (targetRoll - curRoll) * Math.min(1, dt * 10);
      }

      if (!ecoModeEnabled && webglAvailable && !webglContextLost && renderer && scene && camera && headMesh) {
        const offsetDir = camera.position.clone().sub(controls.target);
        if (offsetDir.lengthSq() < 0.0001) offsetDir.set(0, 0.08, BASE_CAMERA_DISTANCE);
        const desiredDist = BASE_CAMERA_DISTANCE / Math.max(0.4, zoomMultiplier);
        const curDist = offsetDir.length();
        const nextDist = curDist + (desiredDist - curDist) * Math.min(1, dt * 10);
        offsetDir.normalize().multiplyScalar(nextDist);
        camera.position.copy(controls.target).add(offsetDir);

        shaderUniforms.uTime.value = elapsedSimTime;
        if (!isSculptDragging) {
          shaderUniforms.uBrushActive.value *= Math.exp(-dt * 8.0);
        }

        headMesh.rotation.y = curYaw;
        headMesh.rotation.x = curPitch;
        headMesh.rotation.z = curRoll;
        updateRealEyes(dt, elapsedSimTime);

        if (starField) starField.rotation.y = elapsedSimTime * 0.02 * starDriftRate;
        controls.update();
        renderer.render(scene, camera);
      } else {
        render2dStudioStage(elapsedSimTime);
      }

      syncThrottledHud(nowMs, elapsedSimTime);
    }

    window.addEventListener('load', () => {
      initWebGLScene();
      resizeFallback2dCanvas();
      resizeOscilloscopeCanvas();
      if (webglAvailable && !ecoModeEnabled) {
        setEngineStatus('OS-Safe AI Studio v12.0 Ready — Design Matrix, Ping, Rotate & 20 Daemons', 'ready');
      }
      lastFrameMs = performance.now();
      requestAnimationFrame(animate);
    });
  </script>
</body>
</html>