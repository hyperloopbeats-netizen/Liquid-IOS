    function sampleImageRelief(x, y) {
      if (!hasUploadedImage) return 0;
      const u = Math.max(0, Math.min(0.999, x * 0.55 + 0.5));
      const v = Math.max(0, Math.min(0.999, -y * 0.45 + 0.5));
      const ix = Math.floor(u * RELIEF_W);
      const iy = Math.floor(v * RELIEF_H);
      return reliefHeightMap[iy * RELIEF_W + ix] || 0;
    }

    function createSculptedFaceGeometry(segments = 84) {
      const geo = new THREE.SphereGeometry(1.18, segments, segments);
      const pos = geo.attributes.position;
      const v = new THREE.Vector3();

      for (let i = 0; i < pos.count; i++) {
        v.fromBufferAttribute(pos, i);
        const nx = v.x / 1.18;
        const ny = v.y / 1.18;
        const nz = v.z / 1.18;

        let x = nx * 0.94;
        let y = ny * 1.32;
        let z = nz * 1.05;

        if (y < 0.0) {
          const jawT = Math.min(1.0, -y / 1.32);
          const taper = 1.0 - 0.34 * Math.pow(jawT, 1.45);
          x *= taper;
          z *= (1.0 - 0.14 * Math.pow(jawT, 1.8));
        }

        const templeMask = Math.exp(-Math.pow(y - 0.25, 2) / 0.18) * Math.max(0, Math.abs(x) - 0.55);
        x -= Math.sign(x) * templeMask * 0.12;

        if (nz > 0.0) {
          const frontWeight = Math.pow(nz, 0.75);
          const browRidge = Math.exp(-Math.pow(y - 0.36, 2) / 0.016) * Math.exp(-Math.pow(x, 2) / 0.48);
          z += browRidge * 0.12 * frontWeight;

          const socketL = Math.exp(-(Math.pow(x + 0.34, 2) / 0.046 + Math.pow(y - 0.21, 2) / 0.026));
          const socketR = Math.exp(-(Math.pow(x - 0.34, 2) / 0.046 + Math.pow(y - 0.21, 2) / 0.026));
          z -= (socketL + socketR) * 0.24 * frontWeight;

          const noseBridge = Math.exp(-(Math.pow(x, 2) / 0.016 + Math.pow(y - 0.02, 2) / 0.095));
          const noseTip = Math.exp(-(Math.pow(x, 2) / 0.024 + Math.pow(y + 0.14, 2) / 0.018));
          const nostrilL = Math.exp(-(Math.pow(x + 0.11, 2) / 0.011 + Math.pow(y + 0.18, 2) / 0.011));
          const nostrilR = Math.exp(-(Math.pow(x - 0.11, 2) / 0.011 + Math.pow(y + 0.18, 2) / 0.011));
          z += (noseBridge * 0.21 + noseTip * 0.19 + (nostrilL + nostrilR) * 0.075) * frontWeight;

          const cheekL = Math.exp(-(Math.pow(x + 0.50, 2) / 0.075 + Math.pow(y + 0.02, 2) / 0.055));
          const cheekR = Math.exp(-(Math.pow(x - 0.50, 2) / 0.075 + Math.pow(y + 0.02, 2) / 0.055));
          z += (cheekL + cheekR) * 0.11 * frontWeight;
          x += (cheekR - cheekL) * 0.045 * frontWeight;

          const philtrum = Math.exp(-(Math.pow(x, 2) / 0.006 + Math.pow(y + 0.31, 2) / 0.012));
          z -= philtrum * 0.032 * frontWeight;

          const cupidDip = 1.0 - 0.28 * Math.exp(-Math.pow(x, 2) / 0.004);
          const upperLip = Math.exp(-(Math.pow(x, 2) / 0.078 + Math.pow(y + 0.42, 2) / 0.0055)) * cupidDip;
          const lowerLip = Math.exp(-(Math.pow(x, 2) / 0.068 + Math.pow(y + 0.51, 2) / 0.0075));
          const oralSeam = Math.exp(-(Math.pow(x, 2) / 0.085 + Math.pow(y + 0.465, 2) / 0.0014));
          z += (upperLip * 0.145 + lowerLip * 0.135 - oralSeam * 0.075) * frontWeight;

          const chinSulcus = Math.exp(-(Math.pow(x, 2) / 0.065 + Math.pow(y + 0.62, 2) / 0.009));
          const chinBoss = Math.exp(-(Math.pow(x, 2) / 0.068 + Math.pow(y + 0.82, 2) / 0.032));
          z += (chinBoss * 0.14 - chinSulcus * 0.055) * frontWeight;
        }

        pos.setXYZ(i, x, y, z);
      }

      geo.computeVertexNormals();
      geo.userData.basePositions = new Float32Array(pos.array);
      geo.userData.sculptOffsets = new Float32Array(pos.array.length);
      return geo;
    }

    function createScleraTexture() {
      const canvas = document.createElement('canvas');
      canvas.width = 256;
      canvas.height = 256;
      const ctx = canvas.getContext('2d');
      const grad = ctx.createRadialGradient(128, 128, 15, 128, 128, 130);
      grad.addColorStop(0.0, '#f8fafc');
      grad.addColorStop(0.7, '#e2e8f0');
      grad.addColorStop(1.0, '#cbd5e1');
      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, 256, 256);

      ctx.strokeStyle = 'rgba(225, 29, 72, 0.16)';
      ctx.lineWidth = 0.8;
      for (let i = 0; i < 24; i++) {
        const a = (i / 24) * Math.PI * 2;
        ctx.beginPath();
        ctx.moveTo(128 + Math.cos(a) * 68, 128 + Math.sin(a) * 68);
        ctx.lineTo(128 + Math.cos(a + 0.08) * 116, 128 + Math.sin(a + 0.08) * 116);
        ctx.stroke();
      }
      const tex = new THREE.CanvasTexture(canvas);
      tex.colorSpace = THREE.SRGBColorSpace;
      return tex;
    }

    function createIrisTexture() {
      const canvas = document.createElement('canvas');
      canvas.width = 256;
      canvas.height = 256;
      const ctx = canvas.getContext('2d');
      const grad = ctx.createRadialGradient(128, 128, 22, 128, 128, 122);
      grad.addColorStop(0.0, '#38bdf8');
      grad.addColorStop(0.55, '#0284c7');
      grad.addColorStop(0.9, '#082f49');
      grad.addColorStop(1.0, '#020617');
      ctx.fillStyle = grad;
      ctx.beginPath();
      ctx.arc(128, 128, 124, 0, Math.PI * 2);
      ctx.fill();

      ctx.strokeStyle = 'rgba(186, 230, 253, 0.25)';
      ctx.lineWidth = 1.2;
      for (let i = 0; i < 64; i++) {
        const a = (i / 64) * Math.PI * 2;
        ctx.beginPath();
        ctx.moveTo(128 + Math.cos(a) * 34, 128 + Math.sin(a) * 34);
        ctx.lineTo(128 + Math.cos(a) * 110, 128 + Math.sin(a) * 110);
        ctx.stroke();
      }
      const tex = new THREE.CanvasTexture(canvas);
      tex.colorSpace = THREE.SRGBColorSpace;
      return tex;
    }

    let scleraTex = null;
