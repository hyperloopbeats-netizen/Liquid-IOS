            0.055,
            0.04
          );
          vectorGroup.add(arrow);
          arrowHelpers.push(arrow);

          const trailArr = new Float32Array(RIBBON_LEN * 3);
          for (let h = 0; h < RIBBON_LEN; h++) {
            trailArr[h * 3] = node.anchor.x;
            trailArr[h * 3 + 1] = node.anchor.y;
            trailArr[h * 3 + 2] = node.anchor.z;
          }
          const trailGeo = new THREE.BufferGeometry();
          trailGeo.setAttribute('position', new THREE.BufferAttribute(trailArr, 3));
          const line = new THREE.Line(
            trailGeo,
            new THREE.LineBasicMaterial({ color: 0xe879f9, transparent: true, opacity: 0.65 })
