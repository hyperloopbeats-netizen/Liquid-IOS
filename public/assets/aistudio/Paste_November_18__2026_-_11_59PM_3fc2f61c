      }
      const src = audioCtx.createBufferSource();
      src.buffer = decodedAudioBuffer;
      src.loop = true;
      src.connect(masterGain);
      const safeOffset = Math.max(0, offsetSec % Math.max(0.1, decodedAudioBuffer.duration));
      src.start(0, safeOffset);
      bufferSource = src;
      bufferStartTime = audioCtx.currentTime - safeOffset;
      bufferOffset = safeOffset;
      isBufferPlaying = true;
