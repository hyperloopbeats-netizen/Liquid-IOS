        keyLight.position.set(2, 3, 4);
        scene.add(keyLight);

        const starCount = ecoModeEnabled ? 120 : 280;
        const starGeo = new THREE.BufferGeometry();
        const starPositions = new Float32Array(starCount * 3);
        for (let i = 0; i < starCount; i++) {
          const r = 3.5 + Math.random() * 7.0;
          const theta = Math.random() * Math.PI * 2;
          const phi = Math.acos(2 * Math.random() - 1);
          starPositions[i * 3] = r * Math.sin(phi) * Math.cos(theta);
          starPositions[i * 3 + 1] = r * Math.cos(phi);
          starPositions[i * 3 + 2] = r * Math.sin(phi) * Math.sin(theta);
        }
        starGeo.setAttribute('position', new THREE.BufferAttribute(starPositions, 3));
        starField = new THREE.Points(
          starGeo,
          new THREE.PointsMaterial({ color: 0x38bdf8, size: 0.022, transparent: true, opacity: 0.38 })
        );
        scene.add(starField);

        uploadedImageTexture = new THREE.CanvasTexture(editCanvas);
        uploadedImageTexture.colorSpace = THREE.SRGBColorSpace;
        shaderUniforms.uImageTex.value = uploadedImageTexture;
        shaderUniforms.uHasImage.value = hasUploadedImage ? 1.0 : 0.0;

        headGeometry = createSculptedFaceGeometry(ecoModeEnabled ? 56 : 84);
        headMaterial = new THREE.ShaderMaterial({
          uniforms: shaderUniforms,
          vertexShader: /* glsl */ `
            varying vec3 vNormal;
            varying vec3 vWorldPos;
            varying vec3 vLocalPos;
            varying float vBrushProx;
            uniform vec3 uBrushCenter;
            uniform float uBrushRadius;
            uniform float uBrushActive;
            void main() {
              vLocalPos = position;
              vec4 worldPos = modelMatrix * vec4(position, 1.0);
              vWorldPos = worldPos.xyz;
              vNormal = normalize(normalMatrix * normal);
              float d = distance(position, uBrushCenter);
              vBrushProx = exp(-(d * d) / max(0.01, uBrushRadius * uBrushRadius)) * uBrushActive;
              gl_Position = projectionMatrix * viewMatrix * worldPos;
            }
          `,
          fragmentShader: /* glsl */ `
            varying vec3 vNormal;
            varying vec3 vWorldPos;
            varying vec3 vLocalPos;
            varying float vBrushProx;
            uniform float uTime;
            uniform int uSkinMode;
            uniform float uF1;
            uniform float uF2;
            uniform float uPlosive;
            uniform float uReactionBoost;
            uniform float uPingWave;
            uniform float uHasImage;
            uniform sampler2D uImageTex;
            uniform float uBrushPolarity;

            vec3 envReflection(vec3 refl) {
              float horizon = smoothstep(-0.4, 0.8, refl.y);
              vec3 sky = mix(vec3(0.04, 0.09, 0.18), vec3(0.22, 0.78, 0.98), horizon);
              float rimBand = pow(max(0.0, sin(refl.x * 4.0 + refl.y * 3.0 + uTime * 0.4)), 4.0);
              return sky + vec3(0.45, 0.18, 0.72) * rimBand * 0.55;
            }

            void main() {
              vec3 N = normalize(vNormal);
              vec3 V = normalize(cameraPosition - vWorldPos);
              float fresnel = pow(1.0 - max(dot(N, V), 0.0), 3.0);
              vec3 L1 = normalize(vec3(1.6, 2.2, 2.5));
              vec3 L2 = normalize(vec3(-2.0, -0.6, 1.4));
              float diff1 = max(dot(N, L1), 0.0);
              float diff2 = max(dot(N, L2), 0.0);
              vec3 H1 = normalize(L1 + V);
              float spec1 = pow(max(dot(N, H1), 0.0), 48.0);

              vec3 color = vec3(0.0);
              float alpha = 1.0;

              if (uSkinMode == 0) {
                vec3 R = reflect(-V, N);
                vec3 chrome = envReflection(R);
                vec3 obsidian = vec3(0.03, 0.045, 0.075);
                color = mix(obsidian, chrome, 0.45 + 0.55 * fresnel);
                color += vec3(0.75, 0.92, 1.0) * spec1 * 1.0;
                color += vec3(0.12, 0.65, 0.95) * fresnel * (0.45 + uF1 * 0.6 + uReactionBoost * 0.35);
              } else if (uSkinMode == 1) {
                float gridX = abs(fract(vLocalPos.x * 16.0) - 0.5);
                float gridY = abs(fract(vLocalPos.y * 16.0) - 0.5);
                float line = smoothstep(0.44, 0.49, max(gridX, gridY));
                float scan = 0.5 + 0.5 * sin(vLocalPos.y * 14.0 - uTime * 3.0);
                vec3 baseDark = vec3(0.015, 0.035, 0.065);
                vec3 neonCyan = vec3(0.10, 0.88, 0.98) * (0.75 + uF2 * 0.8);
                vec3 neonMag = vec3(0.92, 0.25, 0.78) * (0.4 + uF1 * 0.8 + uReactionBoost * 0.4);
                color = mix(baseDark, mix(neonCyan, neonMag, scan), line);
                color += neonCyan * fresnel * 0.55;
              } else if (uSkinMode == 2) {
                float band = 0.5 + 0.5 * sin(vLocalPos.x * 18.0 + vLocalPos.y * 18.0);
                vec3 crystalDeep = vec3(0.06, 0.14, 0.28);
                vec3 crystalEdge = vec3(0.32, 0.86, 1.0);
                color = crystalDeep * (0.35 + diff1 * 0.85 + band * 0.2) + crystalEdge * fresnel * 0.85 + vec3(1.0) * spec1 * 0.9;
                color += vec3(0.55, 0.25, 0.95) * diff2 * 0.4;
              } else {
                float plasma = sin(vLocalPos.y * 8.0 + uTime * 2.2) * cos(vLocalPos.x * 8.0 - uTime * 1.7);
                vec3 coreGlass = mix(vec3(0.04, 0.12, 0.26), vec3(0.35, 0.10, 0.48), 0.5 + 0.5 * plasma);
                vec3 rimEnergy = mix(vec3(0.15, 0.92, 0.98), vec3(0.98, 0.35, 0.75), clamp(uPlosive + uReactionBoost * 0.5, 0.0, 1.0));
                color = coreGlass * (0.5 + diff1 * 0.6) + rimEnergy * fresnel * (1.0 + uF1 * 0.65) + vec3(0.9, 0.98, 1.0) * spec1 * 0.85;
                alpha = 0.88 + fresnel * 0.12;
              }

              if (uHasImage > 0.5 && vLocalPos.z > -0.2) {
                vec2 uv = clamp(vec2(vLocalPos.x * 0.55 + 0.5, -vLocalPos.y * 0.45 + 0.5), 0.0, 1.0);
                vec3 imgCol = texture2D(uImageTex, uv).rgb;
                color = mix(color, imgCol * (0.55 + diff1 * 0.65) + vec3(0.2, 0.8, 1.0) * fresnel * 0.35, 0.78);
              }

              if (uPingWave > 0.01) {
                color += vec3(0.18, 0.92, 0.98) * uPingWave * (0.25 + fresnel * 0.55);
              }

              if (vBrushProx > 0.01) {
                vec3 brushTint = uBrushPolarity >= 0.0 ? vec3(0.15, 0.95, 1.0) : vec3(0.98, 0.25, 0.75);
                color = mix(color, brushTint, vBrushProx * 0.42);
              }

              gl_FragColor = vec4(color, alpha);
            }
          `,
          transparent: true
        });

        headMesh = new THREE.Mesh(headGeometry, headMaterial);
        scene.add(headMesh);

        scleraTex = createScleraTexture();
        irisTex = createIrisTexture();
        leftEyeRig = buildAnatomicalEye(-1);
        rightEyeRig = buildAnatomicalEye(1);
        headMesh.add(leftEyeRig.eyePivot, rightEyeRig.eyePivot);

        aiUnitGroup = new THREE.Group();
        headMesh.add(aiUnitGroup);
        aiSatMeshes.length = 0;
        for (let i = 0; i < 5; i++) {
          const angle = (i / 5) * Math.PI * 2 + Math.PI * 0.5;
          const sat = new THREE.Mesh(
