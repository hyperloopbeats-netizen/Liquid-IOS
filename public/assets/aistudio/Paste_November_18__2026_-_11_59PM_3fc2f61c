    function buildAnatomicalEye(sideSign) {
      const eyePivot = new THREE.Group();
      eyePivot.position.set(sideSign * 0.34, 0.21, 0.83);

      const ballGroup = new THREE.Group();
      eyePivot.add(ballGroup);

      const scleraMat = new THREE.MeshStandardMaterial({ map: scleraTex, roughness: 0.25, metalness: 0.02 });
      const scleraMesh = new THREE.Mesh(new THREE.SphereGeometry(0.145, 28, 28), scleraMat);
      ballGroup.add(scleraMesh);

      const irisMat = new THREE.MeshStandardMaterial({
        map: irisTex,
        color: new THREE.Color(0x38bdf8),
        roughness: 0.32,
        metalness: 0.1,
        emissive: new THREE.Color(0x0284c7),
        emissiveIntensity: 0.25
      });
      const irisMesh = new THREE.Mesh(new THREE.CircleGeometry(0.068, 28), irisMat);
      irisMesh.position.set(0, 0, 0.138);
      ballGroup.add(irisMesh);

      const pupilMesh = new THREE.Mesh(
        new THREE.CircleGeometry(0.029, 24),
        new THREE.MeshBasicMaterial({ color: 0x020617 })
      );
      pupilMesh.position.set(0, 0, 0.140);
      ballGroup.add(pupilMesh);

      const corneaMesh = new THREE.Mesh(
        new THREE.SphereGeometry(0.151, 24, 24),
        new THREE.MeshPhysicalMaterial({
          color: 0xffffff,
          transparent: true,
          opacity: 0.22,
          roughness: 0.05,
          clearcoat: 1.0,
          depthWrite: false
        })
      );
      corneaMesh.scale.set(1.0, 1.0, 0.72);
      corneaMesh.position.set(0, 0, 0.035);
      ballGroup.add(corneaMesh);

      const catchlight = new THREE.Mesh(
        new THREE.CircleGeometry(0.014, 12),
        new THREE.MeshBasicMaterial({ color: 0xffffff, transparent: true, opacity: 0.9, depthWrite: false })
      );
      catchlight.position.set(-0.032, 0.034, 0.148);
      ballGroup.add(catchlight);

      const lidMat = new THREE.MeshStandardMaterial({ color: 0x162238, roughness: 0.55, metalness: 0.15 });
      const upperLid = new THREE.Mesh(new THREE.SphereGeometry(0.158, 24, 12, 0, Math.PI * 2, 0, Math.PI * 0.52), lidMat);
      upperLid.rotation.x = -Math.PI * 0.42;
      eyePivot.add(upperLid);

      const lowerLid = new THREE.Mesh(new THREE.SphereGeometry(0.156, 24, 12, 0, Math.PI * 2, 0.48, Math.PI * 0.52), lidMat);
      lowerLid.rotation.x = Math.PI * 0.36;
      eyePivot.add(lowerLid);

      return { eyePivot, ballGroup, irisMat, pupilMesh, upperLid, lowerLid };
    }

    function initWebGLScene() {
