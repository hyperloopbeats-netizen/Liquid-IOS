    // =========================================================================
    // 7. THREE.JS SYNTHETIC SKIN & PROCEDURAL MESH ENGINE
    // =========================================================================
    function initForgeSimulation() {
      const container = document.getElementById('forge-viewport');
      if (!container || forgeEngine) return;
      const canvas = document.getElementById('forgeCanvas');
      canvas.width = container.clientWidth;
      canvas.height = container.clientHeight;

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(45, canvas.width / canvas.height, 0.1, 1000);
      camera.position.set(0, -14, 19);
      camera.lookAt(0, 0, 0);

      const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
      renderer.setSize(canvas.width, canvas.height);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));

      const geometry = new THREE.SphereGeometry(5.6, 56, 56);
      const material = new THREE.MeshPhysicalMaterial({
        color: 0x38bdf8,
        roughness: 0.10,
        metalness: 0.22,
        transmission: 0.85,
        transparent: true,
        opacity: 0.92,
        emissive: 0x0284c7,
        emissiveIntensity: 0.35
      });
      const modelMesh = new THREE.Mesh(geometry, material);
      scene.add(modelMesh);

      // Subtle wireframe overlay for technical skin mesh visibility
      const wireMat = new THREE.MeshBasicMaterial({ color: 0x7dd3fc, wireframe: true, transparent: true, opacity: 0.08 });
      const wireMesh = new THREE.Mesh(geometry, wireMat);
      modelMesh.add(wireMesh);

      scene.add(new THREE.AmbientLight(0xffffff, 0.95));
      const pLight1 = new THREE.PointLight(0xa855f7, 3.2, 60);
      pLight1.position.set(10, 10, 15);
      scene.add(pLight1);

      const pLight2 = new THREE.PointLight(0x38bdf8, 2.5, 60);
      pLight2.position.set(-10, -10, 12);
      scene.add(pLight2);

      const posAttr = geometry.attributes.position;
      const origX = new Float32Array(posAttr.count);
      const origY = new Float32Array(posAttr.count);
      const origZ = new Float32Array(posAttr.count);
      for (let i = 0; i < posAttr.count; i++) {
        origX[i] = posAttr.getX(i);
        origY[i] = posAttr.getY(i);
        origZ[i] = posAttr.getZ(i);
      }

      let timeElapsed = 0;
      let impactWaves = [];
      let currentParams = { skin: 'hydrogel', roughness: '0.10', transmission: '0.85', frequency: '3.50' };
      let animId = null;

      // Pointer drag orbit + click stress-test impact
      let isDraggingMesh = false;
      let dragMoved = false;
      let prevPointer = { x: 0, y: 0 };

      canvas.addEventListener('pointerdown', e => {
        isDraggingMesh = true;
        dragMoved = false;
        prevPointer = { x: e.clientX, y: e.clientY };
      });

      window.addEventListener('pointermove', e => {
        if (!isDraggingMesh) return;
        const dx = e.clientX - prevPointer.x;
        const dy = e.clientY - prevPointer.y;
        if (Math.abs(dx) > 3 || Math.abs(dy) > 3) dragMoved = true;
        modelMesh.rotation.z += dx * 0.012;
        modelMesh.rotation.x += dy * 0.012;
        prevPointer = { x: e.clientX, y: e.clientY };
      });

      window.addEventListener('pointerup', () => {
        if (isDraggingMesh && !dragMoved) {
          triggerImpactImpulse();
        }
        isDraggingMesh = false;
      });

      const onResize = () => {
        if (!container || !renderer) return;
        const nw = container.clientWidth;
        const nh = container.clientHeight;
        if (nw > 0 && nh > 0) {
          camera.aspect = nw / nh;
          camera.updateProjectionMatrix();
          renderer.setSize(nw, nh);
        }
      };
      window.addEventListener('resize', onResize);

      forgeEngine = {
        getCurrentParams() { return currentParams; },
        addImpact() {
          impactWaves.push({ time: 0, amplitude: 1.85 });
        },
        resize: onResize,
        dispose() {
          if (animId) cancelAnimationFrame(animId);
          window.removeEventListener('resize', onResize);
          renderer.dispose();
        },
        setSkinShader(skinType) {
          currentParams.skin = skinType;
          if (skinType === 'hydrogel') {
            material.color.setHex(0x38bdf8);
            material.emissive.setHex(0x0284c7);
            wireMat.color.setHex(0x7dd3fc);
            material.transmission = 0.85;
          } else if (skinType === 'vascular') {
            material.color.setHex(0x34d399);
            material.emissive.setHex(0x059669);
            wireMat.color.setHex(0x6ee7b7);
            material.transmission = 0.72;
          } else if (skinType === 'thermo') {
            material.color.setHex(0xf472b6);
            material.emissive.setHex(0xdb2777);
            wireMat.color.setHex(0xf9a8d4);
            material.transmission = 0.62;
          } else if (skinType === 'biolum') {
            material.color.setHex(0xa855f7);
            material.emissive.setHex(0x7c3aed);
            wireMat.color.setHex(0xd8b4fe);
            material.transmission = 0.92;
          }
        },
        updateParameters(params) {
          currentParams = { ...currentParams, ...params };
          material.roughness = parseFloat(currentParams.roughness);
          material.transmission = parseFloat(currentParams.transmission);
          syncSlidersWithParams(currentParams);
        }
      };

      function animate() {
        animId = requestAnimationFrame(animate);
        timeElapsed += 0.035;
        if (!isDraggingMesh) {
          modelMesh.rotation.z += 0.0045;
        }

        for (let i = impactWaves.length - 1; i >= 0; i--) {
          impactWaves[i].time += 0.055;
          if (impactWaves[i].time > 2.2) impactWaves.splice(i, 1);
        }

        const freq = parseFloat(currentParams.frequency) || 3.5;

        for (let i = 0; i < posAttr.count; i++) {
          const vx = origX[i], vy = origY[i], vz = origZ[i];
          const len = Math.sqrt(vx * vx + vy * vy + vz * vz) || 1;
          const nx = vx / len, ny = vy / len, nz = vz / len;

          let disp = Math.sin(vx * (freq * 0.16) + timeElapsed) * Math.cos(vy * (freq * 0.16) + timeElapsed) * 0.35;

          for (const imp of impactWaves) {
            const dist = Math.hypot(vx, vy);
            disp += Math.sin(dist * 2.2 - imp.time * 9.0) * imp.amplitude * Math.max(0, 1.0 - imp.time * 0.45) * 0.45;
          }

          posAttr.setXYZ(i, vx + nx * disp, vy + ny * disp, vz + nz * disp);
        }
        posAttr.needsUpdate = true;
        geometry.computeVertexNormals();
        renderer.render(scene, camera);
      }
      animate();
    }

    function syncSlidersWithParams(params) {
      const rEl = document.getElementById('slider-roughness');
      const tEl = document.getElementById('slider-transmission');
      const fEl = document.getElementById('slider-frequency');
      if (rEl) rEl.value = params.roughness;
      if (tEl) tEl.value = params.transmission;
      if (fEl) fEl.value = params.frequency;

      const vr = document.getElementById('val-roughness');
      const vt = document.getElementById('val-transmission');
      const vf = document.getElementById('val-frequency');
      if (vr) vr.textContent = parseFloat(params.roughness).toFixed(2);
      if (vt) vt.textContent = parseFloat(params.transmission).toFixed(2);
      if (vf) vf.textContent = parseFloat(params.frequency).toFixed(2);

      const tag = document.getElementById('mesh-telemetry-tag');
      if (tag) {
        tag.textContent = `R: ${parseFloat(params.roughness).toFixed(2)} | T: ${parseFloat(params.transmission).toFixed(2)} | F: ${parseFloat(params.frequency).toFixed(2)}`;
      }
    }

    function manualTuneParameter(key, val) {
      if (!forgeEngine) return;
      forgeEngine.updateParameters({ [key]: parseFloat(val).toFixed(2) });
    }

    function handleShaderSelectChange(skinType) {
      if (!forgeEngine) return;
