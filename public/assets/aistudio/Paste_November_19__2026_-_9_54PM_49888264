<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <title>AIM OS v3.8 — AI Model Forge & Synthetic Skin Master Suite</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- Three.js CDN -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Orbitron:wght@600;800&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
            orbitron: ['Orbitron', 'sans-serif']
          }
        }
      }
    }
  </script>
  <style>
    :root {
      --glass-blur: 24px;
      --glass-bg: rgba(15, 23, 42, 0.78);
      --glass-bg-elevated: rgba(15, 23, 42, 0.90);
      --glass-border: rgba(56, 189, 248, 0.28);
      --glass-shadow: 0 24px 48px -12px rgba(0, 0, 0, 0.65);
      --text-primary: #f8fafc;
      --panel-inner: rgba(2, 6, 23, 0.55);
    }

    * { box-sizing: border-box; user-select: none; }
    input, textarea, pre, code, select, .selectable { user-select: text; }

    body {
      margin: 0; padding: 0; overflow: hidden; width: 100vw; height: 100vh;
      font-family: 'Inter', sans-serif; color: var(--text-primary); background-color: #020617;
    }

    .wallpaper-aurora {
      background:
        radial-gradient(at 15% 20%, rgba(56, 189, 248, 0.45) 0px, transparent 50%),
        radial-gradient(at 85% 15%, rgba(168, 85, 247, 0.42) 0px, transparent 52%),
        radial-gradient(at 75% 85%, rgba(244, 114, 182, 0.38) 0px, transparent 50%),
        linear-gradient(135deg, #0b0f19 0%, #0f172a 50%, #020617 100%);
      background-size: 140% 140%;
      animation: meshShift 22s ease infinite alternate;
    }

    @keyframes meshShift {
      0% { background-position: 0% 20%; }
      50% { background-position: 100% 60%; }
      100% { background-position: 25% 100%; }
    }

    .glass-surface {
      background: var(--glass-bg);
      backdrop-filter: blur(var(--glass-blur)) saturate(180%);
      -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(180%);
      border: 1px solid var(--glass-border);
      box-shadow: var(--glass-shadow);
    }
    .glass-bar {
      background: var(--glass-bg-elevated);
      backdrop-filter: blur(28px) saturate(190%);
      -webkit-backdrop-filter: blur(28px) saturate(190%);
      border-bottom: 1px solid var(--glass-border);
    }
    .glass-inner { background: var(--panel-inner); border: 1px solid rgba(255, 255, 255, 0.12); }

    .window-frame { transition: opacity 0.2s ease, transform 0.22s cubic-bezier(0.16, 1, 0.3, 1); }
    .window-frame.dragging { transition: none !important; }
    .window-minimized { opacity: 0; transform: scale(0.86) translateY(60px); pointer-events: none; }

    .glass-dock {
      background: var(--glass-bg-elevated);
      backdrop-filter: blur(32px) saturate(195%);
      -webkit-backdrop-filter: blur(32px) saturate(195%);
      border: 1px solid var(--glass-border);
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.25);
    }
    .dock-item {
      transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1), margin 0.22s ease;
    }
    .dock-item:hover {
      transform: translateY(-12px) scale(1.25);
      margin-left: 8px;
      margin-right: 8px;
    }

    ::-webkit-scrollbar { width: 5px; height: 5px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: rgba(56, 189, 248, 0.35); border-radius: 9999px; }

    input[type="range"] { -webkit-appearance: none; appearance: none; height: 5px; border-radius: 999px; background: rgba(255, 255, 255, 0.2); outline: none; }
    input[type="range"]::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 13px; height: 13px; border-radius: 50%; background: #a855f7; box-shadow: 0 0 8px #a855f7; cursor: pointer; }
  </style>
</head>
<body class="wallpaper-aurora select-none">

  <!-- Top Status Bar -->
  <header class="glass-bar fixed top-0 left-0 right-0 h-9 px-4 flex items-center justify-between z-[1000] text-xs font-medium">
    <div class="flex items-center gap-3">
      <div class="relative">
        <button onclick="toggleMenu('system-menu')" class="flex items-center gap-2 px-2 py-1 rounded-lg hover:bg-white/15 transition cursor-pointer">
          <svg class="w-4 h-4 text-sky-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
          <span class="font-semibold font-orbitron tracking-wider">AIM OS • v3.8</span>
        </button>
        <div id="system-menu" class="hidden absolute left-0 mt-2 w-64 rounded-2xl glass-surface p-1.5 shadow-2xl z-[1100] text-xs">
          <button onclick="openApp('modelforge'); closeMenus();" class="w-full text-left px-3 py-2 rounded-xl hover:bg-white/15 flex justify-between items-center cursor-pointer text-purple-300 font-bold">
            <span>✨ AI Model Forge Suite</span><span class="font-mono opacity-60 text-[10px]">MASTER</span>
          </button>
          <button onclick="openApp('aim'); closeMenus();" class="w-full text-left px-3 py-2 rounded-xl hover:bg-white/15 flex justify-between items-center cursor-pointer">
            <span>🧠 Neural Ledger Bus</span><span class="font-mono opacity-60 text-[10px]">PUB/SUB</span>
          </button>
          <div class="my-1 border-t border-white/10"></div>
          <button onclick="resetVaultToDefaults(); closeMenus();" class="w-full text-left px-3 py-2 rounded-xl hover:bg-white/15 text-amber-300 cursor-pointer">
            <span>♻️ Reset Saved Vault</span>
          </button>
        </div>
      </div>
      <span class="opacity-30">|</span>
      <span id="active-app-label" class="font-semibold truncate max-w-[300px] text-sky-200">AI Model Forge • Master Workspace</span>
    </div>

    <div class="flex items-center gap-3">
      <button onclick="toggleGlassBlur()" id="blur-toggle-btn" class="px-2.5 py-1 rounded-lg bg-white/10 hover:bg-white/20 border border-white/15 transition font-mono text-[10px] text-purple-300 cursor-pointer flex items-center gap-1.5" title="Toggle Glassmorphic Backdrop Blur">
        <i data-lucide="sparkles" class="w-3 h-3"></i>
        <span id="blur-state-label">BLUR: ON</span>
      </button>
      <span id="top-clock" class="px-2 py-1 rounded-lg hover:bg-white/15 transition font-mono tabular-nums text-xs">18:18</span>
    </div>
  </header>

  <!-- Main Desktop Area -->
  <main id="desktop-area" class="relative w-full h-full pt-12 pb-24 px-4 overflow-hidden">
    <div id="desktop-icons" class="grid grid-flow-col grid-rows-5 gap-3 w-fit">
      <button ondblclick="openApp('modelforge')" onclick="if(window.innerWidth < 768) openApp('modelforge')" class="desktop-icon group w-28 p-2.5 rounded-2xl hover:bg-white/15 transition flex flex-col items-center gap-1.5 text-center cursor-pointer">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-purple-500 to-indigo-600 flex items-center justify-center shadow-lg group-hover:scale-105 transition">
          <i data-lucide="box" class="w-6 h-6 text-white"></i>
        </div>
        <span class="text-xs font-medium drop-shadow leading-tight">AI Model Forge</span>
      </button>
      <button ondblclick="openApp('aim')" onclick="if(window.innerWidth < 768) openApp('aim')" class="desktop-icon group w-28 p-2.5 rounded-2xl hover:bg-white/15 transition flex flex-col items-center gap-1.5 text-center cursor-pointer">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-sky-400 to-blue-600 flex items-center justify-center shadow-lg group-hover:scale-105 transition">
          <i data-lucide="terminal" class="w-6 h-6 text-white"></i>
        </div>
        <span class="text-xs font-medium drop-shadow leading-tight">Neural Ledger</span>
      </button>
    </div>

    <!-- Windows Container Layer -->
    <div id="windows-layer" class="absolute inset-0 pointer-events-none"></div>
  </main>

  <!-- Toast Notification Container -->
  <div id="toast-container" class="fixed top-12 right-4 z-[3000] flex flex-col gap-2 pointer-events-none"></div>

  <!-- Bottom Floating Glass Dock -->
  <nav aria-label="Application Dock" class="fixed bottom-3 left-1/2 -translate-x-1/2 z-[1500] max-w-[96vw]">
    <div id="dock-bar" class="glass-dock px-3.5 py-2.5 rounded-3xl flex items-end gap-2.5 sm:gap-3"></div>
  </nav>

  <!-- Master OS & Simulation Script -->
  <script>
    lucide.createIcons();

    // =========================================================================
    // 1. TOAST NOTIFICATION SYSTEM (REPLACES ALERT/CONFIRM)
    // =========================================================================
    function showToast(title, message, accent = 'purple') {
      const container = document.getElementById('toast-container');
      if (!container) return;
      const borderMap = {
        purple: 'border-purple-400 text-purple-300',
        sky: 'border-sky-400 text-sky-300',
        emerald: 'border-emerald-400 text-emerald-300',
        amber: 'border-amber-400 text-amber-300'
      };
      const el = document.createElement('div');
      el.className = `glass-surface px-4 py-2.5 rounded-2xl border-l-4 ${borderMap[accent] || borderMap.purple} shadow-2xl max-w-xs transition-all duration-300 transform translate-x-0 opacity-100 pointer-events-auto`;
      el.innerHTML = `
        <div class="text-[11px] font-bold font-mono tracking-wide">${title}</div>
        <div class="text-[11px] text-slate-200 mt-0.5 leading-snug">${message}</div>
      `;
      container.appendChild(el);
      setTimeout(() => {
        el.style.opacity = '0';
        el.style.transform = 'translateX(20px)';
        setTimeout(() => el.remove(), 300);
      }, 3400);
    }

    // =========================================================================
    // 2. GLASS BLUR TOGGLE
    // =========================================================================
    let isGlassBlurEnabled = true;
    function toggleGlassBlur() {
      isGlassBlurEnabled = !isGlassBlurEnabled;
      document.documentElement.style.setProperty('--glass-blur', isGlassBlurEnabled ? '24px' : '0px');
      document.getElementById('blur-state-label').textContent = isGlassBlurEnabled ? 'BLUR: ON' : 'BLUR: OFF';
      showToast('COMPOSITOR', `Backdrop glass blur ${isGlassBlurEnabled ? 'enabled (24px)' : 'disabled (performance mode)'}.`, 'sky');
    }

    // =========================================================================
    // 3. PUB/SUB NEURAL LEDGER BUS (AIM_BRAIN)
    // =========================================================================
    const AIM_BRAIN = {
      events: [
        { time: '18:18:00', source: 'MASTER', topic: 'BOOT', summary: 'AIM OS Master Suite v3.8 initialized with AI Model Forge & Synthetic Skin shaders.' }
      ],
      publish(source, topic, summary) {
        const time = new Date().toTimeString().split(' ')[0];
        this.events.unshift({ time, source, topic, summary });
        if (this.events.length > 60) this.events.pop();
        updateNeuralLedgerUI();
      }
    };

    function updateNeuralLedgerUI() {
      const listEl = document.getElementById('aim-brain-events-list');
      if (!listEl) return;
      listEl.innerHTML = AIM_BRAIN.events.map(ev => `
        <div class="p-2.5 rounded-xl bg-white/5 border-l-2 border-purple-400 space-y-1 text-[11px] font-mono">
          <div class="flex justify-between opacity-75 text-[10px]">
            <span>${ev.time} • <strong class="text-purple-300">[${ev.source}]</strong></span>
            <span class="text-cyan-300">${ev.topic}</span>
          </div>
          <div class="text-slate-200">${ev.summary}</div>
        </div>
      `).join('');
    }

    // =========================================================================
    // 4. APPLICATION REGISTRY & PERSISTENT VAULT STATE
    // =========================================================================
    const APPS = [
      { id: 'modelforge', name: 'AI Model Forge & Skin Suite', category: 'Gemini API + Three.js Shaders', width: 1060, height: 710, gradient: 'from-purple-500 to-indigo-600', icon: '<i data-lucide="box" class="w-6 h-6 text-white"></i>' },
      { id: 'aim', name: 'Neural Ledger Bus', category: 'Pub/Sub Bus', width: 680, height: 460, gradient: 'from-sky-400 to-blue-600', icon: '<i data-lucide="terminal" class="w-6 h-6 text-white"></i>' }
    ];

    const DEFAULT_VAULT = [
      { id: 'm-01', prompt: 'Cybernetic Exoskeleton Shoulder Plate', skin: 'hydrogel', roughness: '0.12', transmission: '0.85', frequency: '3.50', timestamp: '18:02' },
      { id: 'm-02', prompt: 'Bioluminescent Neural Waveguide Node', skin: 'biolum', roughness: '0.08', transmission: '0.92', frequency: '4.10', timestamp: '18:06' },
      { id: 'm-03', prompt: 'Vascular Perfusion Dermal Matrix', skin: 'vascular', roughness: '0.18', transmission: '0.72', frequency: '2.80', timestamp: '18:11' }
    ];

    function loadStoredVault() {
      try {
        const raw = localStorage.getItem('aim_os_model_vault_v38');
        if (raw) {
          const parsed = JSON.parse(raw);
          if (Array.isArray(parsed) && parsed.length > 0) return parsed;
        }
      } catch (e) {
        console.warn('LocalStorage unavailable, using in-memory vault.');
      }
      return [...DEFAULT_VAULT];
    }

    function persistVault(vaultArr) {
      try {
        localStorage.setItem('aim_os_model_vault_v38', JSON.stringify(vaultArr));
      } catch (e) {
        console.warn('Could not persist to localStorage.');
      }
    }

    let modelVault = loadStoredVault();
    let openWindows = {};
    let zIndexCounter = 100;
    let activeAppId = null;
    let forgeEngine = null;

    let forgeLogs = [
      { time: '18:18:00', type: 'SYSTEM_READY', details: 'AI Model Forge master suite synchronized with Gemini API & Vault.' }
    ];

    function resetVaultToDefaults() {
      modelVault = [...DEFAULT_VAULT];
      persistVault(modelVault);
      updateForgeUI();
      AIM_BRAIN.publish('VAULT', 'RESET', 'Model vault restored to default synthetic skin presets.');
      showToast('VAULT RESET', 'Default synthetic skin presets restored.', 'amber');
    }

    // =========================================================================
    // 5. DOCK & WINDOW MANAGER
    // =========================================================================
    function renderDock() {
      const dock = document.getElementById('dock-bar');
      dock.innerHTML = APPS.map(app => {
        const isOpen = Boolean(openWindows[app.id]);
        return `
          <button onclick="handleDockClick('${app.id}')" title="${app.name}" class="dock-item relative group flex flex-col items-center cursor-pointer">
            <span class="opacity-0 group-hover:opacity-100 transition-opacity absolute -top-10 px-2.5 py-1 rounded-xl glass-surface text-[11px] font-medium whitespace-nowrap pointer-events-none shadow-lg">${app.name}</span>
            <div class="w-12 h-12 rounded-2xl bg-gradient-to-br ${app.gradient} flex items-center justify-center shadow-lg border border-white/25">${app.icon}</div>
            <span class="w-1.5 h-1.5 rounded-full mt-1.5 transition-all ${isOpen ? 'bg-white opacity-100' : 'opacity-0'}"></span>
          </button>
        `;
      }).join('');
      lucide.createIcons();
    }

    function handleDockClick(appId) {
      if (!openWindows[appId]) openApp(appId);
      else if (openWindows[appId].minimized) restoreWindow(appId);
      else if (activeAppId === appId) minimizeWindow(appId);
      else focusWindow(appId);
    }

    function openApp(appId) {
      const app = APPS.find(a => a.id === appId);
      if (!app) return;
      if (openWindows[appId]) { restoreWindow(appId); focusWindow(appId); return; }

      const layer = document.getElementById('windows-layer');
      const w = Math.min(window.innerWidth - 32, app.width);
      const h = Math.min(window.innerHeight - 115, app.height);
      const left = Math.max(16, (window.innerWidth - w) / 2 + (appId === 'aim' ? 30 : 0));
      const top = Math.max(46, (window.innerHeight - h) / 2 - 14 + (appId === 'aim' ? 30 : 0));

      const winEl = document.createElement('div');
      winEl.id = `win-${appId}`;
      winEl.className = 'window-frame glass-surface rounded-3xl flex flex-col overflow-hidden pointer-events-auto absolute shadow-2xl';
      winEl.style.width = `${w}px`;
      winEl.style.height = `${h}px`;
      winEl.style.left = `${left}px`;
      winEl.style.top = `${top}px`;
      winEl.style.zIndex = ++zIndexCounter;
      winEl.addEventListener('mousedown', () => focusWindow(appId));

      winEl.innerHTML = `
        <div class="win-header h-11 px-4 flex items-center justify-between border-b border-white/15 bg-white/5 cursor-grab shrink-0">
          <div class="flex items-center gap-2">
            <button onclick="closeWindow('${appId}')" class="w-3.5 h-3.5 rounded-full bg-rose-500 hover:bg-rose-400 cursor-pointer" title="Close"></button>
            <button onclick="minimizeWindow('${appId}')" class="w-3.5 h-3.5 rounded-full bg-amber-400 hover:bg-amber-300 cursor-pointer" title="Minimize"></button>
            <button onclick="toggleMaximizeWindow('${appId}')" class="w-3.5 h-3.5 rounded-full bg-emerald-400 hover:bg-emerald-300 cursor-pointer" title="Maximize"></button>
          </div>
          <div class="text-xs font-semibold tracking-tight truncate px-2">${app.name} <span class="opacity-60 font-mono text-[10px] hidden sm:inline">(${app.category})</span></div>
          <div class="w-12"></div>
        </div>
        <div id="win-body-${appId}" class="flex-1 overflow-auto p-3 sm:p-4 text-xs">
          ${renderAppContent(appId)}
        </div>
      `;

      layer.appendChild(winEl);
      openWindows[appId] = { id: appId, minimized: false };
      makeWindowDraggable(winEl);
      focusWindow(appId);
      renderDock();
      postRenderAppHook(appId);
      AIM_BRAIN.publish(app.name.toUpperCase(), 'LAUNCH', `Launched ${app.name} window.`);
    }

    function focusWindow(appId) {
      const winEl = document.getElementById(`win-${appId}`);
      if (!winEl) return;
      winEl.style.zIndex = ++zIndexCounter;
      activeAppId = appId;
      const app = APPS.find(a => a.id === appId);
      document.getElementById('active-app-label').textContent = app ? `${app.name} • Active` : 'AIM OS Workspace';
    }

    function closeWindow(appId) {
      if (appId === 'modelforge' && forgeEngine) {
        forgeEngine.dispose();
        forgeEngine = null;
      }
      document.getElementById(`win-${appId}`)?.remove();
      delete openWindows[appId];
      renderDock();
    }

    function minimizeWindow(appId) {
      document.getElementById(`win-${appId}`)?.classList.add('window-minimized');
      if (openWindows[appId]) openWindows[appId].minimized = true;
      renderDock();
    }

    function restoreWindow(appId) {
      document.getElementById(`win-${appId}`)?.classList.remove('window-minimized');
      if (openWindows[appId]) openWindows[appId].minimized = false;
      focusWindow(appId);
      renderDock();
    }

    function toggleMaximizeWindow(appId) {
      const win = document.getElementById(`win-${appId}`);
      if (!win) return;
      if (!win.dataset.maximized) {
        win.dataset.prev = JSON.stringify({ left: win.style.left, top: win.style.top, width: win.style.width, height: win.style.height });
        win.style.left = '10px'; win.style.top = '44px';
        win.style.width = `${window.innerWidth - 20}px`;
        win.style.height = `${window.innerHeight - 110}px`;
        win.dataset.maximized = 'true';
      } else {
        const prev = JSON.parse(win.dataset.prev);
        win.style.left = prev.left; win.style.top = prev.top;
        win.style.width = prev.width; win.style.height = prev.height;
        delete win.dataset.maximized;
      }
      if (appId === 'modelforge' && forgeEngine) {
        setTimeout(() => forgeEngine.resize(), 60);
      }
    }

    function makeWindowDraggable(winEl) {
      const header = winEl.querySelector('.win-header');
      header.addEventListener('mousedown', e => {
        if (e.target.tagName === 'BUTTON') return;
        const startX = e.clientX, startY = e.clientY;
        const startLeft = winEl.offsetLeft, startTop = winEl.offsetTop;
        winEl.classList.add('dragging');
        const onMove = ev => {
          winEl.style.left = `${Math.max(0, startLeft + (ev.clientX - startX))}px`;
          winEl.style.top = `${Math.max(40, startTop + (ev.clientY - startY))}px`;
        };
        const onUp = () => { 
          winEl.classList.remove('dragging');
          window.removeEventListener('mousemove', onMove); 
          window.removeEventListener('mouseup', onUp); 
        };
        window.addEventListener('mousemove', onMove); window.addEventListener('mouseup', onUp);
      });
    }

    // =========================================================================
    // 6. APP VIEW TEMPLATES
    // =========================================================================
    function renderAppContent(appId) {
      if (appId === 'modelforge') {
        return `
          <div class="h-full flex flex-col gap-3 font-mono">
            <!-- Prompt & Control Bar -->
            <div class="p-3 rounded-2xl glass-inner flex flex-col gap-2 text-xs">
              <div class="flex items-center justify-between">
                <span class="text-purple-300 font-semibold flex items-center gap-2">
                  <i data-lucide="cpu" class="w-4 h-4 text-sky-400"></i>
                  Gemini API Prompt-to-Skin Engine & Blob Serializer
                </span>
                <span id="synth-status-badge" class="px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 text-[10px] border border-emerald-400/30">READY</span>
              </div>
              <div class="flex flex-wrap gap-2 items-center">
                <input type="password" id="gemini-key-input" placeholder="Optional Gemini API Key..." class="w-44 bg-slate-950/85 border border-purple-500/30 rounded-xl px-3 py-2 text-xs text-white outline-none focus:border-purple-400" />
                <input type="text" id="gemini-prompt-input" value="Auxetic metamaterial plate with autonomic healing microcapsules" class="flex-1 min-w-[210px] bg-slate-950/85 border border-purple-500/30 rounded-xl px-3 py-2 text-xs text-white outline-none focus:border-purple-400" />
                <select id="skin-shader-select" onchange="handleShaderSelectChange(this.value)" class="bg-slate-950/85 border border-purple-500/30 rounded-xl px-3 py-2 text-xs text-purple-200 outline-none cursor-pointer">
                  <option value="hydrogel">Hydrogel Matrix</option>
                  <option value="vascular">Vascular Flow</option>
                  <option value="thermo">Thermochromic</option>
                  <option value="biolum">Bioluminescent</option>
                </select>
                <button onclick="synthesizeModelWithSkin()" id="synthesize-btn" class="px-3.5 py-2 rounded-xl bg-gradient-to-r from-purple-500 to-indigo-600 hover:opacity-95 font-bold text-white transition cursor-pointer shadow-lg shadow-purple-500/20">SYNTHESIZE</button>
                <button onclick="saveCurrentModelToVault()" class="px-3 py-2 rounded-xl bg-emerald-500/25 hover:bg-emerald-500/40 border border-emerald-400/40 font-bold text-emerald-200 transition cursor-pointer">SAVE VAULT</button>
                <button onclick="exportModelAsBlob()" class="px-3 py-2 rounded-xl bg-sky-500/25 hover:bg-sky-500/40 border border-sky-400/40 font-bold text-sky-200 transition cursor-pointer">DOWNLOAD BLOB</button>
              </div>
