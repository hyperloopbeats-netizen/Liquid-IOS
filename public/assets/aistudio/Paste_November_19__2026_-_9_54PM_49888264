    function triggerImpactImpulse() {
      if (!forgeEngine) return;
      forgeEngine.addImpact();
      const params = forgeEngine.getCurrentParams();
      forgeLogs.unshift({
        time: new Date().toTimeString().split(' ')[0],
        type: 'SKIN_STRESS_TEST',
        details: `Viscoelastic impact wave propagated across [${params.skin.toUpperCase()}] mesh.`
      });
      AIM_BRAIN.publish('FORGE', 'IMPACT', `Stress-tested ${params.skin} skin shader.`);
      updateForgeUI();
    }

    // =========================================================================
    // 8. GEMINI API SYNTHESIS, VAULT PERSISTENCE & BLOB EXPORT
    // =========================================================================
    async function synthesizeModelWithSkin() {
      const promptInput = document.getElementById('gemini-prompt-input');
      const prompt = promptInput ? promptInput.value.trim() : 'Synthetic biomorphic skin lattice';
      const skinType = document.getElementById('skin-shader-select')?.value || 'hydrogel';
      const apiKey = document.getElementById('gemini-key-input')?.value.trim() || '';
      const badge = document.getElementById('synth-status-badge');

      if (badge) {
        badge.textContent = 'SYNTHESIZING...';
        badge.className = 'px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-300 text-[10px] border border-amber-400/30 animate-pulse';
      }

      // Deterministic hash seed from prompt for repeatable procedural generation when offline
      let hash = 0;
      for (let i = 0; i < prompt.length; i++) hash = ((hash << 5) - hash) + prompt.charCodeAt(i);
      const norm = Math.abs(hash % 100) / 100;

      let synthParams = {
        skin: skinType,
        roughness: (0.06 + norm * 0.22).toFixed(2),
        transmission: (0.68 + (1 - norm) * 0.26).toFixed(2),
        frequency: (1.80 + norm * 3.40).toFixed(2)
      };

      let usedLiveApi = false;

      if (apiKey) {
        try {
          const res = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${encodeURIComponent(apiKey)}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              contents: [{
                parts: [{
                  text: `Generate Three.js MeshPhysicalMaterial parameters for the 3D synthetic skin concept: "${prompt}". Return ONLY valid JSON with numeric keys: roughness (0.05 to 0.35), transmission (0.50 to 0.95), frequency (1.0 to 5.5).`
                }]
              }]
            })
          });
          if (res.ok) {
            const data = await res.json();
            const textResp = data?.candidates?.[0]?.content?.parts?.[0]?.text || '';
            const cleanJson = textResp.replace(/```json/gi, '').replace(/```/g, '').trim();
            const parsed = JSON.parse(cleanJson);
            if (typeof parsed.roughness === 'number') synthParams.roughness = Math.min(0.8, Math.max(0.02, parsed.roughness)).toFixed(2);
            if (typeof parsed.transmission === 'number') synthParams.transmission = Math.min(0.98, Math.max(0.1, parsed.transmission)).toFixed(2);
            if (typeof parsed.frequency === 'number') synthParams.frequency = Math.min(6.0, Math.max(0.5, parsed.frequency)).toFixed(2);
            usedLiveApi = true;
          }
        } catch (err) {
          console.warn('Gemini API direct call fell back to procedural synthesizer:', err);
        }
      }

      if (forgeEngine) {
        forgeEngine.setSkinShader(skinType);
        forgeEngine.updateParameters(synthParams);
        forgeEngine.addImpact();
      }

      if (badge) {
        badge.textContent = usedLiveApi ? 'GEMINI LIVE SYNC' : 'PROCEDURAL SYNC';
        badge.className = 'px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 text-[10px] border border-emerald-400/30';
      }

      const modeLabel = usedLiveApi ? 'Gemini Live API' : 'Procedural Engine';
      forgeLogs.unshift({
        time: new Date().toTimeString().split(' ')[0],
        type: usedLiveApi ? 'GEMINI_API_SYNC' : 'PROCEDURAL_SYNTH',
        details: `[${modeLabel}] Synthesized "${prompt}" (${skinType.toUpperCase()})`
      });
      AIM_BRAIN.publish('FORGE', 'SYNTHESIS', `Synthesized "${prompt}" via ${modeLabel}.`);
      showToast('MODEL SYNTHESIZED', `Applied ${skinType.toUpperCase()} shader parameters via ${modeLabel}.`, 'purple');
      updateForgeUI();
    }

    function saveCurrentModelToVault() {
      const promptText = document.getElementById('gemini-prompt-input')?.value.trim() || 'Untitled Synthetic Mesh';
      const params = forgeEngine ? forgeEngine.getCurrentParams() : { skin: 'hydrogel', roughness: '0.10', transmission: '0.85', frequency: '3.50' };
      const newModel = {
        id: 'm-' + Date.now().toString(36),
        prompt: promptText,
        skin: params.skin,
        roughness: params.roughness,
        transmission: params.transmission,
        frequency: params.frequency || '3.50',
        timestamp: new Date().toTimeString().split(' ')[0].substring(0, 5)
      };

      modelVault.unshift(newModel);
      persistVault(modelVault);

      forgeLogs.unshift({
        time: new Date().toTimeString().split(' ')[0],
        type: 'VAULT_COMMIT',
        details: `Saved "${newModel.prompt}" (${newModel.skin}) to persistent vault.`
      });
      AIM_BRAIN.publish('VAULT', 'SAVE', `Committed model "${newModel.prompt}" to vault.`);
      showToast('SAVED TO VAULT', `"${newModel.prompt}" persisted to LocalStorage.`, 'emerald');
      updateForgeUI();
    }

    function loadVaultModel(id) {
      const model = modelVault.find(m => m.id === id);
      if (!model) return;
      const pIn = document.getElementById('gemini-prompt-input');
      const sIn = document.getElementById('skin-shader-select');
      if (pIn) pIn.value = model.prompt;
      if (sIn) sIn.value = model.skin;

      if (forgeEngine) {
        forgeEngine.setSkinShader(model.skin);
        forgeEngine.updateParameters(model);
        forgeEngine.addImpact();
      }
      forgeLogs.unshift({
        time: new Date().toTimeString().split(' ')[0],
        type: 'VAULT_LOAD',
        details: `Loaded "${model.prompt}" (${model.skin}) from vault.`
      });
      AIM_BRAIN.publish('VAULT', 'LOAD', `Loaded "${model.prompt}" into active Three.js viewport.`);
      showToast('MODEL LOADED', `Loaded "${model.prompt}" (${model.skin.toUpperCase()}).`, 'sky');
      updateForgeUI();
    }

    function deleteVaultModel(event, id) {
      event.stopPropagation();
      modelVault = modelVault.filter(m => m.id !== id);
      persistVault(modelVault);
      updateForgeUI();
      showToast('VAULT ENTRY REMOVED', 'Model deleted from vault.', 'amber');
    }

    function exportModelAsBlob() {
      const params = forgeEngine ? forgeEngine.getCurrentParams() : { skin: 'hydrogel', roughness: '0.10', transmission: '0.85', frequency: '3.50' };
      const promptText = document.getElementById('gemini-prompt-input')?.value.trim() || 'Synthetic Skin Mesh';

      const payload = {
        generator: 'AIM OS v3.8 — AI Model Forge & Synthetic Skin Master Suite',
        exportedAt: new Date().toISOString(),
        prompt: promptText,
        shaderBinding: params.skin,
        threeJsMaterialConfig: {
          type: 'MeshPhysicalMaterial',
          roughness: parseFloat(params.roughness),
          transmission: parseFloat(params.transmission),
          waveDisplacementFrequency: parseFloat(params.frequency),
          transparent: true
        }
      };

      const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `aim_os_model_${params.skin}_${Date.now()}.json`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);

      forgeLogs.unshift({
        time: new Date().toTimeString().split(' ')[0],
        type: 'BLOB_EXPORT',
        details: `Serialized & downloaded JSON model blob (${params.skin}).`
      });
      AIM_BRAIN.publish('FORGE', 'EXPORT', `Downloaded JSON model artifact for "${promptText}".`);
      showToast('BLOB DOWNLOADED', `Exported aim_os_model_${params.skin}.json`, 'sky');
      updateForgeUI();
    }

    function updateForgeUI() {
      const list = document.getElementById('forge-ledger-list');
      if (list) list.innerHTML = renderForgeLogsHTML();

      const vaultList = document.getElementById('vault-items-list');
      if (vaultList) vaultList.innerHTML = renderVaultItemsHTML();

      const countEl = document.getElementById('vault-count');
      if (countEl) countEl.textContent = modelVault.length;
    }

