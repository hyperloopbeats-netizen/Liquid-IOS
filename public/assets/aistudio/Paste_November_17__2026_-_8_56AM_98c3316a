<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <title>AIM OS v9.0 — Autonomous Self-Healing & Verified Feedback Loop Kernel</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- Three.js CDN -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <!-- Three.js GLTFExporter CDN -->
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/exporters/GLTFExporter.js"></script>
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Orbitron:wght@600;800&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
            orbitron: ['Orbitron', 'sans-serif']
          }
        }
      }
    }
  </script>
  <style>
    :root {
      --glass-blur: 24px;
      --glass-bg: rgba(15, 23, 42, 0.88);
      --glass-bg-elevated: rgba(15, 23, 42, 0.98);
      --glass-border: rgba(0, 255, 102, 0.35);
      --glass-shadow: 0 24px 48px -12px rgba(0, 0, 0, 0.9);
      --text-primary: #f8fafc;
      --panel-inner: rgba(2, 6, 23, 0.75);
      --cyan: #00f3ff;
      --purple: #b537f2;
      --emerald: #00ff66;
    }

    * { box-sizing: border-box; user-select: none; }
    input, textarea, pre, code, .selectable { user-select: text; }

    body {
      margin: 0; padding: 0; overflow: hidden; width: 100vw; height: 100vh;
      font-family: 'Inter', sans-serif; color: var(--text-primary); background-color: #020617;
    }

    .wallpaper-healer {
      background:
        radial-gradient(at 15% 20%, rgba(0, 255, 102, 0.25) 0px, transparent 50%),
        radial-gradient(at 85% 15%, rgba(0, 243, 255, 0.30) 0px, transparent 52%),
        radial-gradient(at 50% 85%, rgba(181, 55, 242, 0.25) 0px, transparent 50%),
        linear-gradient(135deg, #010307 0%, #060b17 50%, #020617 100%);
      background-size: 180% 180%;
      animation: healerMeshShift 32s ease infinite alternate;
    }

    @keyframes healerMeshShift {
      0% { background-position: 0% 20%; }
      50% { background-position: 100% 75%; }
      100% { background-position: 25% 100%; }
    }

    .glass-surface {
      background: var(--glass-bg);
      backdrop-filter: blur(var(--glass-blur)) saturate(195%);
      -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(195%);
      border: 1px solid var(--glass-border);
      box-shadow: var(--glass-shadow);
    }
    .glass-bar {
      background: var(--glass-bg-elevated);
      backdrop-filter: blur(28px) saturate(200%);
      -webkit-backdrop-filter: blur(28px) saturate(200%);
      border-bottom: 1px solid var(--glass-border);
    }
    .glass-inner { background: var(--panel-inner); border: 1px solid rgba(255, 255, 255, 0.12); }

    .window-frame { transition: opacity 0.2s ease, transform 0.22s cubic-bezier(0.16, 1, 0.3, 1); }
    .window-frame.dragging { transition: none !important; }
    .window-minimized { opacity: 0; transform: scale(0.86) translateY(60px); pointer-events: none; }

    .glass-dock {
      background: var(--glass-bg-elevated);
      backdrop-filter: blur(32px) saturate(205%);
      -webkit-backdrop-filter: blur(32px) saturate(205%);
      border: 1px solid var(--glass-border);
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7), inset 0 1px 0 rgba(255, 255, 255, 0.25);
    }
    .dock-item {
      transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1), margin 0.22s ease;
    }
    .dock-item:hover {
      transform: translateY(-12px) scale(1.25);
      margin-left: 8px;
      margin-right: 8px;
    }

    ::-webkit-scrollbar { width: 5px; height: 5px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: rgba(0, 255, 102, 0.35); border-radius: 9999px; }
  </style>
</head>
<body class="wallpaper-healer select-none">

  <!-- Top Status Bar -->
  <header class="glass-bar fixed top-0 left-0 right-0 h-9 px-4 flex items-center justify-between z-[1000] text-xs font-medium">
    <div class="flex items-center gap-3">
      <button onclick="toggleMenu('system-menu')" class="flex items-center gap-2 px-2 py-1 rounded-lg hover:bg-white/15 transition cursor-pointer">
        <div id="synapse-led" class="w-2.5 h-2.5 rounded-full bg-emerald-400 shadow-[0_0_8px_#00ff66]"></div>
        <span class="font-semibold font-orbitron tracking-wider text-emerald-400">AIM OS v9.0 • AUTO-HEAL</span>
      </button>
      <div id="system-menu" class="hidden absolute left-4 top-10 w-72 rounded-2xl glass-surface p-1.5 shadow-2xl z-[1100] text-xs space-y-1">
        <button onclick="openApp('modelforge'); closeMenus();" class="w-full text-left px-3 py-2 rounded-xl hover:bg-white/15 flex justify-between cursor-pointer text-purple-300 font-bold"><span>✨ AI Model Forge Suite</span><span class="font-mono opacity-60">v9.0</span></button>
        <button onclick="openApp('healer'); closeMenus();" class="w-full text-left px-3 py-2 rounded-xl hover:bg-white/15 flex justify-between cursor-pointer text-emerald-300 font-bold"><span>🛡️ Self-Healing & Feedback</span><span class="font-mono opacity-60">Autonomous</span></button>
        <button onclick="openApp('cognition'); closeMenus();" class="w-full text-left px-3 py-2 rounded-xl hover:bg-white/15 flex justify-between cursor-pointer text-cyan-300 font-bold"><span>🧠 Quad Cognition Core</span><span class="font-mono opacity-60">Interlaced</span></button>
        <button onclick="openApp('gamedev'); closeMenus();" class="w-full text-left px-3 py-2 rounded-xl hover:bg-white/15 flex justify-between cursor-pointer text-amber-300 font-bold"><span>🎮 Matrix Game Sandbox</span><span class="font-mono opacity-60">Physics</span></button>
        <button onclick="openApp('audiored'); closeMenus();" class="w-full text-left px-3 py-2 rounded-xl hover:bg-white/15 flex justify-between cursor-pointer text-teal-300 font-bold"><span>🎙️ Real Mic FFT Analyzer</span><span class="font-mono opacity-60">Synesthesia</span></button>
        <button onclick="openApp('aim'); closeMenus();" class="w-full text-left px-3 py-2 rounded-xl hover:bg-white/15 flex justify-between cursor-pointer"><span>🧠 Neural Ledger Bus</span><span class="font-mono opacity-60">Pub/Sub</span></button>
      </div>
      <span class="opacity-30">|</span>
      <span id="active-app-label" class="font-semibold truncate max-w-[240px]">AI Model Forge • Master Workspace</span>
    </div>

    <div class="flex items-center gap-4">
      <div class="hidden sm:flex items-center gap-3 font-mono text-[11px] opacity-80">
        <span>Kernel Health: <strong id="top-kernel-health" class="text-emerald-400">100%</strong></span>
        <span>Heals Verified: <strong id="top-heals-count" class="text-cyan-400">0</strong></span>
        <span>Pulses: <strong id="top-pulses" class="text-purple-400">0</strong></span>
      </div>
      <button id="top-clock" class="px-2 py-1 rounded-lg hover:bg-white/15 transition font-mono tabular-nums text-xs cursor-pointer">18:18</button>
    </div>
  </header>

  <!-- Main Desktop Area -->
  <main id="desktop-area" class="relative w-full h-full pt-12 pb-24 px-4 overflow-hidden">
    <div id="desktop-icons" class="grid grid-flow-col grid-rows-6 gap-3 w-fit">
      <button ondblclick="openApp('modelforge')" class="desktop-icon group w-28 p-2.5 rounded-2xl hover:bg-white/15 transition flex flex-col items-center gap-1.5 text-center cursor-pointer">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-purple-500 to-indigo-600 flex items-center justify-center shadow-lg"><i data-lucide="box" class="w-6 h-6 text-white"></i></div>
        <span class="text-xs font-medium drop-shadow leading-tight">AI Model Forge</span>
      </button>
      <button ondblclick="openApp('healer')" class="desktop-icon group w-28 p-2.5 rounded-2xl hover:bg-white/15 transition flex flex-col items-center gap-1.5 text-center cursor-pointer">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-emerald-400 to-teal-600 flex items-center justify-center shadow-lg"><i data-lucide="shield-check" class="w-6 h-6 text-white"></i></div>
        <span class="text-xs font-medium drop-shadow leading-tight">Self-Healer</span>
      </button>
      <button ondblclick="openApp('cognition')" class="desktop-icon group w-28 p-2.5 rounded-2xl hover:bg-white/15 transition flex flex-col items-center gap-1.5 text-center cursor-pointer">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-cyan-400 to-blue-600 flex items-center justify-center shadow-lg"><i data-lucide="brain" class="w-6 h-6 text-white"></i></div>
        <span class="text-xs font-medium drop-shadow leading-tight">Quad Cognition</span>
      </button>
      <button ondblclick="openApp('gamedev')" class="desktop-icon group w-28 p-2.5 rounded-2xl hover:bg-white/15 transition flex flex-col items-center gap-1.5 text-center cursor-pointer">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-amber-500 to-orange-600 flex items-center justify-center shadow-lg"><i data-lucide="gamepad-2" class="w-6 h-6 text-white"></i></div>
        <span class="text-xs font-medium drop-shadow leading-tight">Game Sandbox</span>
      </button>
      <button ondblclick="openApp('audiored')" class="desktop-icon group w-28 p-2.5 rounded-2xl hover:bg-white/15 transition flex flex-col items-center gap-1.5 text-center cursor-pointer">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-teal-400 to-cyan-600 flex items-center justify-center shadow-lg"><i data-lucide="mic" class="w-6 h-6 text-white"></i></div>
        <span class="text-xs font-medium drop-shadow leading-tight">Real Mic FFT</span>
      </button>
      <button ondblclick="openApp('aim')" class="desktop-icon group w-28 p-2.5 rounded-2xl hover:bg-white/15 transition flex flex-col items-center gap-1.5 text-center cursor-pointer">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-purple-400 to-pink-600 flex items-center justify-center shadow-lg"><i data-lucide="terminal" class="w-6 h-6 text-white"></i></div>
        <span class="text-xs font-medium drop-shadow leading-tight">Neural Ledger</span>
      </button>
    </div>

    <!-- Windows Container Layer -->
    <div id="windows-layer" class="absolute inset-0 pointer-events-none"></div>
  </main>

  <!-- Bottom Floating Glass Dock -->
  <nav aria-label="Application Dock" class="fixed bottom-3 left-1/2 -translate-x-1/2 z-[1500] max-w-[96vw]">
    <div id="dock-bar" class="glass-dock px-3.5 py-2.5 rounded-3xl flex items-end gap-2.5 sm:gap-3"></div>
  </nav>

  <!-- Master Script -->
  <script>
    lucide.createIcons();

    // ==========================================
    // AUTONOMOUS KERNEL HEALER & VERIFIED FEEDBACK LOOP
    // ==========================================
    const KERNEL_HEALER = {
      health: 100,
      healsCount: 0,
      logs: [
        { time: '18:18:00', type: 'SUCCESS', verified: true, msg: 'Autonomous Healer initialized. Continuous feedback loop online.' }
      ],
      publish(type, verified, msg) {
        const time = new Date().toTimeString().split(' ')[0];
        this.logs.unshift({ time, type, verified, msg });
        if (this.logs.length > 50) this.logs.pop();
        
        const elH = document.getElementById('top-kernel-health');
        const elC = document.getElementById('top-heals-count');
        if (elH) {
          elH.textContent = `${this.health}%`;
          elH.className = this.health < 80 ? 'text-amber-400' : 'text-emerald-400';
        }
        if (elC) elC.textContent = this.healsCount;
        updateHealerUI();
      },
      detectAndHeal() {
        // Simulate background telemetry check for anomaly
        const hasAnomaly = Math.random() < 0.35;
        if (hasAnomaly) {
          this.health = Math.max(65, this.health - 20);
          this.publish('ANOMALY_DETECTED', false, 'Buffer pressure or context drift flagged by Sentinel daemon.');
          
          setTimeout(() => {
            // Auto-heal protocol
            this.health = 100;
            this.healsCount++;
            this.publish('AUTO_HEAL_VERIFIED', true, 'Self-healing routine executed: buffers re-allocated and WebGL context verified.');
          }, 1200);
        }
      }
    };

    setInterval(() => KERNEL_HEALER.detectAndHeal(), 6000);

    function updateHealerUI() {
      const container = document.getElementById('healer-logs-list');
      if (!container) return;
      container.innerHTML = KERNEL_HEALER.logs.map(l => `
        <div class="p-2.5 rounded-xl bg-white/5 border-l-2 ${l.verified ? 'border-emerald-400 text-emerald-200' : 'border-amber-400 text-amber-200'} text-[11px] font-mono">
          <div class="flex justify-between opacity-75 text-[10px]">
            <span>[${l.time}] • <strong>${l.type}</strong></span>
            <span>Verified: ${l.verified ? 'YES' : 'PENDING'}</span>
          </div>
          <div class="mt-0.5">${l.msg}</div>
        </div>
      `).join('');
    }

    const APPS = [
      { id: 'modelforge', name: 'AI Model Forge & Skin Suite', category: 'Gemini + GLTF + Lighting', width: 1040, height: 720, gradient: 'from-purple-500 to-indigo-600', icon: '<i data-lucide="box" class="w-6 h-6 text-white"></i>' },
      { id: 'healer', name: 'Self-Healing & Verified Feedback', category: 'Autonomous Kernel Guard', width: 800, height: 560, gradient: 'from-emerald-400 to-teal-600', icon: '<i data-lucide="shield-check" class="w-6 h-6 text-white"></i>' },
      { id: 'cognition', name: 'Quad-Cognition Core', category: 'Interlaced Matrix', width: 840, height: 580, gradient: 'from-cyan-400 to-blue-600', icon: '<i data-lucide="brain" class="w-6 h-6 text-white"></i>' },
      { id: 'gamedev', name: 'Matrix Game Design Sandbox', category: '3D Physics & Mechanics', width: 880, height: 600, gradient: 'from-amber-500 to-orange-600', icon: '<i data-lucide="gamepad-2" class="w-6 h-6 text-white"></i>' },
      { id: 'audiored', name: 'Real Mic FFT Analyzer', category: 'Audio Synesthesia', width: 720, height: 480, gradient: 'from-teal-400 to-cyan-600', icon: '<i data-lucide="mic" class="w-6 h-6 text-white"></i>' },
      { id: 'aim', name: 'Neural Ledger Bus', category: 'Pub/Sub Bus', width: 680, height: 460, gradient: 'from-purple-400 to-pink-600', icon: '<i data-lucide="terminal" class="w-6 h-6 text-white"></i>' }
    ];

    let openWindows = {};
    let zIndexCounter = 100;
    let activeAppId = null;
    let forgeEngine = null;
    let gameEngine = null;
    let micAnalyser = null;
    let micAudioCtx = null;
    let isMicActive = false;

    let modelVault = JSON.parse(localStorage.getItem('aim_model_vault') || 'null') || [
      { id: 'm-01', prompt: 'Cybernetic Exoskeleton Plate', skin: 'hydrogel', tags: ['exo', 'armor'], roughness: '0.12', transmission: '0.85', timestamp: '18:02' }
    ];

    let forgeLogs = [
      { time: '18:18:00', type: 'SYSTEM_READY', details: 'AI Model Forge master suite synchronized with localStorage vault & GLTF exporter.' }
    ];

    function renderDock() {
      const dock = document.getElementById('dock-bar');
      if (!dock) return;
      dock.innerHTML = APPS.map(app => {
        const isOpen = Boolean(openWindows[app.id]);
        return `
          <button onclick="handleDockClick('${app.id}')" title="${app.name}" class="dock-item relative group flex flex-col items-center cursor-pointer">
            <span class="opacity-0 group-hover:opacity-100 transition-opacity absolute -top-10 px-2.5 py-1 rounded-xl glass-surface text-[11px] font-medium whitespace-nowrap pointer-events-none shadow-lg">${app.name}</span>
            <div class="w-12 h-12 rounded-2xl bg-gradient-to-br ${app.gradient} flex items-center justify-center shadow-lg border border-white/25">${app.icon}</div>
            <span class="w-1.5 h-1.5 rounded-full mt-1.5 transition-all ${isOpen ? 'bg-white opacity-100' : 'opacity-0'}"></span>
          </button>
        `;
      }).join('');
      lucide.createIcons();
    }

    function handleDockClick(appId) {
      if (!openWindows[appId]) openApp(appId);
      else if (openWindows[appId].minimized) restoreWindow(appId);
      else if (activeAppId === appId) minimizeWindow(appId);
      else focusWindow(appId);
    }

    function openApp(appId) {
      const app = APPS.find(a => a.id === appId);
      if (!app) return;
      if (openWindows[appId]) { restoreWindow(appId); focusWindow(appId); return; }

      const layer = document.getElementById('windows-layer');
      const w = Math.min(window.innerWidth - 40, app.width);
      const h = Math.min(window.innerHeight - 120, app.height);
      const left = Math.max(20, (window.innerWidth - w) / 2);
      const top = Math.max(48, (window.innerHeight - h) / 2);

      const winEl = document.createElement('div');
      winEl.id = `win-${appId}`;
      winEl.className = 'window-frame glass-surface rounded-3xl flex flex-col overflow-hidden pointer-events-auto absolute shadow-2xl';
      winEl.style.width = `${w}px`;
      winEl.style.height = `${h}px`;
      winEl.style.left = `${left}px`;
      winEl.style.top = `${top}px`;
      winEl.style.zIndex = ++zIndexCounter;
      winEl.addEventListener('mousedown', () => focusWindow(appId));

      winEl.innerHTML = `
        <div class="win-header h-11 px-4 flex items-center justify-between border-b border-white/15 bg-white/5 cursor-grab shrink-0">
          <div class="flex items-center gap-2">
            <button onclick="closeWindow('${appId}')" class="w-3.5 h-3.5 rounded-full bg-rose-500 hover:bg-rose-400 cursor-pointer" title="Close"></button>
            <button onclick="minimizeWindow('${appId}')" class="w-3.5 h-3.5 rounded-full bg-amber-400 hover:bg-amber-300 cursor-pointer" title="Minimize"></button>
            <button onclick="toggleMaximizeWindow('${appId}')" class="w-3.5 h-3.5 rounded-full bg-emerald-400 hover:bg-emerald-300 cursor-pointer" title="Maximize"></button>
          </div>
          <div class="text-xs font-semibold tracking-tight">${app.name} <span class="opacity-60 font-mono text-[10px]">(${app.category})</span></div>
          <div class="w-12"></div>
        </div>
        <div id="win-body-${appId}" class="flex-1 overflow-auto p-4 text-xs">
          ${renderAppContent(appId)}
        </div>
      `;

      layer.appendChild(winEl);
      openWindows[appId] = { id: appId, minimized: false };
      makeWindowDraggable(winEl);
      focusWindow(appId);
      renderDock();
      postRenderAppHook(appId);
    }

    function focusWindow(appId) {
      const winEl = document.getElementById(`win-${appId}`);
      if (!winEl) return;
      winEl.style.zIndex = ++zIndexCounter;
      activeAppId = appId;
      const app = APPS.find(a => a.id === appId);
      document.getElementById('active-app-label').textContent = app ? `${app.name} • Active` : 'AIM OS Workspace';
    }

    function closeWindow(appId) {
      document.getElementById(`win-${appId}`)?.remove();
      delete openWindows[appId];
      renderDock();
    }

    function minimizeWindow(appId) {
      document.getElementById(`win-${appId}`)?.classList.add('window-minimized');
      openWindows[appId].minimized = true;
      renderDock();
    }

    function restoreWindow(appId) {
      document.getElementById(`win-${appId}`)?.classList.remove('window-minimized');
      openWindows[appId].minimized = false;
      focusWindow(appId);
      renderDock();
    }

    function toggleMaximizeWindow(appId) {
      const win = document.getElementById(`win-${appId}`);
      if (!win) return;
      if (!win.dataset.maximized) {
        win.dataset.prev = JSON.stringify({ left: win.style.left, top: win.style.top, width: win.style.width, height: win.style.height });
        win.style.left = '10px'; win.style.top = '44px';
        win.style.width = `${window.innerWidth - 20}px`;
        win.style.height = `${window.innerHeight - 110}px`;
        win.dataset.maximized = 'true';
      } else {
        const prev = JSON.parse(win.dataset.prev);
        win.style.left = prev.left; win.style.top = prev.top;
        win.style.width = prev.width; win.style.height = prev.height;
        delete win.dataset.maximized;
      }
    }

    function makeWindowDraggable(winEl) {
      const header = winEl.querySelector('.win-header');
      header.addEventListener('mousedown', e => {
        if (e.target.tagName === 'BUTTON') return;
        const startX = e.clientX, startY = e.clientY;
        const startLeft = winEl.offsetLeft, startTop = winEl.offsetTop;
        winEl.classList.add('dragging');
        const onMove = ev => {
          winEl.style.left = `${Math.max(0, startLeft + (ev.clientX - startX))}px`;
          winEl.style.top = `${Math.max(40, startTop + (ev.clientY - startY))}px`;
        };
        const onUp = () => { 
          winEl.classList.remove('dragging');
          window.removeEventListener('mousemove', onMove); 
          window.removeEventListener('mouseup', onUp); 
        };
        window.addEventListener('mousemove', onMove); window.addEventListener('mouseup', onUp);
      });
    }

    function renderAppContent(appId) {
      if (appId === 'modelforge') {
        return `
          <div class="h-full flex flex-col gap-3 font-mono">
            <div class="p-3 rounded-2xl glass-inner flex flex-col gap-2 text-xs">
              <div class="flex items-center justify-between">
                <span class="text-purple-300 font-semibold">Gemini API Prompt-to-Skin Engine & GLTF Exporter</span>
                <span class="w-2.5 h-2.5 rounded-full bg-purple-400 animate-pulse"></span>
              </div>
              <div class="flex flex-wrap gap-2 items-center">
                <input type="password" id="gemini-key-input" placeholder="Gemini API Key..." class="w-32 bg-slate-950/80 border border-purple-500/30 rounded-xl px-3 py-2 text-xs text-white outline-none" />
                <input type="text" id="gemini-prompt-input" value="Auxetic metamaterial plate with autonomic healing microcapsules" class="flex-1 min-w-[180px] bg-slate-950/80 border border-purple-500/30 rounded-xl px-3 py-2 text-xs text-white outline-none" />
                <select id="skin-shader-select" class="bg-slate-950/80 border border-purple-500/30 rounded-xl px-3 py-2 text-xs text-purple-200 outline-none cursor-pointer">
                  <option value="hydrogel">Hydrogel Matrix</option>
                  <option value="vascular">Vascular Flow</option>
                  <option value="thermo">Thermochromic</option>
                  <option value="biolum">Bioluminescent</option>
                </select>
                <button onclick="synthesizeModelWithSkin()" class="px-3 py-2 rounded-xl bg-gradient-to-r from-purple-500 to-indigo-600 font-bold text-white transition cursor-pointer">SYNTHESIZE</button>
                <button onclick="saveCurrentModelToVault()" class="px-3 py-2 rounded-xl bg-emerald-500/30 border border-emerald-400/40 font-bold text-emerald-200 transition cursor-pointer">SAVE</button>
                <button onclick="exportModelAsGLTF()" class="px-3 py-2 rounded-xl bg-purple-500/30 border border-purple-400/40 font-bold text-purple-200 transition cursor-pointer">.GLTF</button>
              </div>
            </div>

            <div class="flex-1 grid grid-cols-1 md:grid-cols-12 gap-3 min-h-0">
              <div class="md:col-span-7 p-3 rounded-2xl glass-inner flex flex-col relative overflow-hidden min-h-[320px]">
                <div class="flex justify-between items-center text-[10px] uppercase tracking-wider opacity-60 pb-2">
                  <span>Live Synthetic Skin Mesh Preview (Click to Stress Test)</span>
                  <span class="text-purple-300">Vertices: 3,136</span>
                </div>
                <div id="forge-viewport" class="flex-1 rounded-2xl bg-slate-950/80 border border-white/15 relative overflow-hidden flex items-center justify-center cursor-crosshair">
                  <canvas id="forgeCanvas" class="absolute inset-0 w-full h-full block"></canvas>
                </div>
              </div>

              <div class="md:col-span-5 flex flex-col gap-3 min-h-0">
                <div class="h-44 p-3 rounded-2xl glass-inner flex flex-col min-h-0">
                  <div class="flex items-center justify-between text-[10px] uppercase tracking-wider text-purple-300 pb-2 border-b border-white/10">
                    <span>Persistent Vault (<span id="vault-count">${modelVault.length}</span>)</span>
                  </div>
                  <div class="flex-1 overflow-y-auto pt-2 space-y-2" id="vault-items-list">
                    ${renderVaultListItems(modelVault)}
                  </div>
                </div>

                <div class="flex-1 p-3 rounded-2xl glass-inner flex flex-col min-h-0">
                  <div class="flex items-center justify-between text-[10px] font-mono text-purple-300 pb-1.5 border-b border-white/10">
                    <span>Forge Neural Bus</span>
                    <span class="w-2 h-2 rounded-full bg-purple-400 animate-pulse"></span>
                  </div>
                  <div class="flex-1 overflow-y-auto pt-2 space-y-1.5 font-mono text-[10px]" id="forge-ledger-list">
                    ${forgeLogs.map(l => `
                      <div class="p-1.5 rounded-lg bg-white/5 border-l-2 border-purple-400">
                        <div class="flex justify-between opacity-60"><span>${l.time}</span><span class="text-purple-300">${l.type}</span></div>
                        <div class="truncate opacity-90">${l.details}</div>
                      </div>
                    `).join('')}
                  </div>
                </div>
              </div>
            </div>
          </div>
        `;
      } else if (appId === 'healer') {
        return `
          <div class="h-full flex flex-col gap-3 font-mono">
            <div class="p-4 rounded-2xl glass-inner flex items-center justify-between">
              <div>
                <span class="text-emerald-300 font-bold text-sm">Autonomous Self-Healing & Verified Feedback Loop</span>
                <div class="text-[11px] opacity-75">Runs continuously to detect anomalies, execute repairs, and log verified feedback.</div>
              </div>
              <button onclick="KERNEL_HEALER.detectAndHeal()" class="px-4 py-2.5 rounded-2xl bg-emerald-500/20 border border-emerald-400 text-emerald-300 font-bold hover:bg-emerald-500 hover:text-black transition cursor-pointer">TRIGGER HEAL CYCLE</button>
            </div>
            <div class="flex-1 p-3 rounded-2xl glass-inner flex flex-col min-h-0">
              <div class="text-[10px] uppercase tracking-wider text-emerald-300 pb-2 border-b border-white/10">Verified Feedback Register</div>
              <div class="flex-1 overflow-y-auto pt-2 space-y-2" id="healer-logs-list">
                ${KERNEL_HEALER.logs.map(l => `
                  <div class="p-2.5 rounded-xl bg-white/5 border-l-2 ${l.verified ? 'border-emerald-400 text-emerald-200' : 'border-amber-400 text-amber-200'} text-[11px] font-mono">
                    <div class="flex justify-between opacity-75 text-[10px]">
                      <span>[${l.time}] • <strong>${l.type}</strong></span>
                      <span>Verified: ${l.verified ? 'YES' : 'PENDING'}</span>
                    </div>
                    <div class="mt-0.5">${l.msg}</div>
                  </div>
                `).join('')}
              </div>
            </div>
          </div>
        `;
      } else if (appId === 'cognition') {
        return `
          <div class="h-full flex flex-col gap-3 font-mono">
            <div class="p-3 rounded-2xl glass-inner flex items-center justify-between text-xs">
              <span class="text-cyan-300 font-bold">Quad-Cognition Interlaced Core Active</span>
              <span class="text-emerald-300">Coherence: 0.999</span>
            </div>
            <div class="flex-1 overflow-y-auto grid grid-cols-2 gap-3">
              <div class="p-3 rounded-xl bg-white/5 border border-white/10">
                <div class="font-bold text-cyan-200">System Alpha</div>
                <div class="text-[10px] opacity-70">Symbolic Deductive Engine</div>
              </div>
              <div class="p-3 rounded-xl bg-white/5 border border-white/10">
                <div class="font-bold text-purple-200">System Beta</div>
                <div class="text-[10px] opacity-70">Neural Pattern Associator</div>
              </div>
              <div class="p-3 rounded-xl bg-white/5 border border-white/10">
                <div class="font-bold text-emerald-200">System Gamma</div>
                <div class="text-[10px] opacity-70">Autonomous Heuristic Optimizer</div>
              </div>
              <div class="p-3 rounded-xl bg-white/5 border border-white/10">
                <div class="font-bold text-amber-200">System Delta</div>
                <div class="text-[10px] opacity-70">Meta-Cognitive Supervisor</div>
              </div>
            </div>
          </div>
        `;
      } else if (appId === 'gamedev') {
        return `
          <div class="h-full flex flex-col gap-3 font-mono">
            <div class="p-3 rounded-2xl glass-inner flex items-center justify-between text-xs">
              <span class="text-amber-300 font-bold">Matrix 3D Physics Game Sandbox</span>
              <button onclick="spawnGameBlock()" class="px-3 py-1.5 rounded-xl bg-amber-500/30 border border-amber-400/40 text-amber-200 font-bold hover:bg-amber-500/50 cursor-pointer">Spawn Object</button>
            </div>
            <div class="flex-1 rounded-2xl bg-slate-950 border border-amber-500/40 relative overflow-hidden flex items-center justify-center">
              <canvas id="gameCanvas" class="w-full h-full block cursor-crosshair"></canvas>
            </div>
          </div>
        `;
      } else if (appId === 'audiored') {
        return `
          <div class="h-full flex flex-col gap-3 font-mono">
            <div class="p-3 rounded-2xl glass-inner flex justify-between items-center text-xs">
              <span class="text-teal-300 font-bold">Real Microphone FFT Audio Analyzer</span>
              <button id="mic-toggle-btn" onclick="toggleMicrophoneFFT()" class="px-4 py-2 rounded-xl bg-teal-500/30 border border-teal-400 text-teal-200 font-bold hover:bg-teal-500 hover:text-black transition cursor-pointer">START MICROPHONE</button>
            </div>
            <div class="flex-1 rounded-2xl bg-black border border-teal-500/40 relative overflow-hidden flex items-center justify-center">
              <canvas id="fftCanvas" class="w-full h-full block"></canvas>
            </div>
          </div>
        `;
      } else if (appId === 'aim') {
        return `
          <div class="h-full flex flex-col space-y-3 font-mono">
            <div class="flex items-center justify-between pb-1 border-b border-cyan-500/30">
              <span class="font-orbitron text-xs font-bold text-cyan-200">AIM OS • NEURAL LEDGER (PUB/SUB BUS)</span>
            </div>
            <div class="flex-1 bg-black/90 rounded-2xl border border-cyan-500/30 p-3 overflow-auto custom-scroll space-y-2" id="aim-brain-events-list"></div>
          </div>
        `;
      }
      return '';
    }

    function postRenderAppHook(appId) {
      if (appId === 'modelforge') initForgeSimulation();
      if (appId === 'gamedev') initGameSandbox();
      if (appId === 'audiored') initFFTVisualizer();
      if (appId === 'healer') updateHealerUI();
    }

    function renderVaultListItems(items) {
      if (items.length === 0) return '<div class="text-[11px] opacity-50 p-2">No matching vault models found.</div>';
      return items.map(m => `
        <div class="p-2 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 flex justify-between items-center transition">
          <div onclick="loadVaultModel('${m.id}')" class="truncate cursor-pointer flex-1 mr-2">
            <div class="font-semibold text-purple-200 truncate">${m.prompt}</div>
            <div class="text-[9px] opacity-60 font-mono">${m.timestamp} • Skin: ${m.skin}</div>
          </div>
          <button onclick="deleteVaultItem('${m.id}')" class="text-[10px] text-rose-300 font-mono p-1 rounded bg-rose-500/20 hover:bg-rose-500/40 cursor-pointer" title="Delete">✕</button>
        </div>
      `).join('');
    }

    function initForgeSimulation() {
      const container = document.getElementById('forge-viewport');
      if (!container || forgeEngine) return;
      const canvas = document.getElementById('forgeCanvas');
      canvas.width = container.clientWidth;
      canvas.height = container.clientHeight;

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(45, canvas.width / canvas.height, 0.1, 1000);
      camera.position.set(0, -16, 20);
      camera.lookAt(0, 0, 0);

      const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
      renderer.setSize(canvas.width, canvas.height);

      const geometry = new THREE.SphereGeometry(6, 48, 48);
      const material = new THREE.MeshPhysicalMaterial({
        color: 0x38bdf8,
        roughness: 0.10,
        metalness: 0.2,
        transmission: 0.85,
        transparent: true,
        opacity: 0.9,
        emissive: 0x0284c7,
        emissiveIntensity: 0.3
      });
      const modelMesh = new THREE.Mesh(geometry, material);
      scene.add(modelMesh);

      scene.add(new THREE.AmbientLight(0xffffff, 0.9));
      const plight1 = new THREE.PointLight(0xa855f7, 3, 50);
      plight1.position.set(0, 0, 15);
      scene.add(plight1);

      forgeEngine = {
        mesh: modelMesh,
        scene: scene,
        setSkinShader(skinType) {
          if (skinType === 'hydrogel') material.color.setHex(0x38bdf8);
          else if (skinType === 'vascular') material.color.setHex(0x34d399);
          else if (skinType === 'thermo') material.color.setHex(0xf472b6);
          else if (skinType === 'biolum') material.color.setHex(0xa855f7);
        },
        updateParameters(params) {
          material.roughness = parseFloat(params.roughness);
          material.transmission = parseFloat(params.transmission);
        }
      };

      function animate() {
        requestAnimationFrame(animate);
        modelMesh.rotation.z += 0.005;
        renderer.render(scene, camera);
      }
      animate();
    }

    function initGameSandbox() {
      const container = document.querySelector('#win-body-gamedev .relative');
      if (!container || gameEngine) return;
      const canvas = document.getElementById('gameCanvas');
      canvas.width = container.clientWidth;
      canvas.height = container.clientHeight;

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(50, canvas.width / canvas.height, 0.1, 1000);
      camera.position.set(0, -12, 16);
      camera.lookAt(0, 0, 0);

      const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
      renderer.setSize(canvas.width, canvas.height);
      scene.add(new THREE.AmbientLight(0xffffff, 1.2));

      let blocks = [];
      function spawnBlock() {
        const geo = new THREE.BoxGeometry(2, 2, 2);
        const mat = new THREE.MeshStandardMaterial({ color: 0xf59e0b, roughness: 0.3, metalness: 0.5 });
        const mesh = new THREE.Mesh(geo, mat);
        mesh.position.set((Math.random() - 0.5) * 8, (Math.random() - 0.5) * 8, 10);
        mesh.userData = { vel: new THREE.Vector3((Math.random() - 0.5) * 0.2, (Math.random() - 0.5) * 0.2, -0.1) };
        scene.add(mesh);
        blocks.push(mesh);
      }
      for(let i=0; i<3; i++) spawnBlock();

      gameEngine = { spawnBlock };

      function animate() {
        requestAnimationFrame(animate);
        for (const b of blocks) {
          b.position.add(b.userData.vel);
          b.rotation.x += 0.02;
          if (b.position.z < -2 || b.position.z > 15) b.userData.vel.z *= -1;
        }
        renderer.render(scene, camera);
      }
      animate();
    }

    function spawnGameBlock() { if (gameEngine) gameEngine.spawnBlock(); }

    function initFFTVisualizer() {
      const container = document.querySelector('#win-body-audiored .relative');
      if (!container) return;
      const canvas = document.getElementById('fftCanvas');
      canvas.width = container.clientWidth;
      canvas.height = container.clientHeight;
      const ctx = canvas.getContext('2d');
      ctx.fillStyle = '#020617';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.fillStyle = '#00f3ff';
      ctx.font = '12px JetBrains Mono';
      ctx.textAlign = 'center';
      ctx.fillText('Microphone Inactive. Click Start.', canvas.width / 2, canvas.height / 2);
    }

    async function toggleMicrophoneFFT() {
      const btn = document.getElementById('mic-toggle-btn');
      if (!isMicActive) {
        try {
          micAudioCtx = new (window.AudioContext || window.webkitAudioContext)();
          const stream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
          const source = micAudioCtx.createMediaStreamSource(stream);
          micAnalyser = micAudioCtx.createAnalyser();
          micAnalyser.fftSize = 256;
          source.connect(micAnalyser);
          isMicActive = true;
          if (btn) btn.textContent = 'STOP MICROPHONE';
        } catch(e) {
          alert('Microphone permission denied.');
        }
      } else {
        isMicActive = false;
        if (micAudioCtx) micAudioCtx.close();
        if (btn) btn.textContent = 'START MICROPHONE';
      }
    }

    async function synthesizeModelWithSkin() {
      const prompt = document.getElementById('gemini-prompt-input').value;
      const skinType = document.getElementById('skin-shader-select').value;
      if (forgeEngine) forgeEngine.setSkinShader(skinType);
      forgeLogs.unshift({ time: new Date().toTimeString().split(' ')[0], type: 'SYNTHESIS', details: `Synthesized "${prompt}"` });
    }

    function saveCurrentModelToVault() {
      const promptText = document.getElementById('gemini-prompt-input').value;
      modelVault.unshift({ id: 'm-' + Math.floor(Math.random()*900+100), prompt: promptText, skin: 'hydrogel', timestamp: '18:18' });
      localStorage.setItem('aim_model_vault', JSON.stringify(modelVault));
    }

    function deleteVaultItem(id) {
      modelVault = modelVault.filter(m => m.id !== id);
      localStorage.setItem('aim_model_vault', JSON.stringify(modelVault));
    }

    function exportModelAsGLTF() {
      if (!forgeEngine || !forgeEngine.scene) return;
      new THREE.GLTFExporter().parse(forgeEngine.scene, gltf => {
        const blob = new Blob([gltf], { type: 'application/octet-stream' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url; a.download = `aim_os_model.glb`;
        document.body.appendChild(a); a.click(); document.body.removeChild(a);
        URL.revokeObjectURL(url);
      }, { binary: true });
    }

    function toggleMenu(id) {
      const el = document.getElementById(id);
      const isHidden = el.classList.contains('hidden');
      ['system-menu'].forEach(i => document.getElementById(i)?.classList.add('hidden'));
      if (isHidden) el.classList.remove('hidden');
    }
    function closeMenus() { ['system-menu'].forEach(i => document.getElementById(i)?.classList.add('hidden')); }
    document.addEventListener('click', e => { if (!e.target.closest('header')) closeMenus(); });

    setInterval(() => {
      document.getElementById('top-clock').textContent = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    }, 1000);

    window.addEventListener('DOMContentLoaded', () => {
      renderDock();
      setTimeout(() => openApp('modelforge'), 250);
    });
  </script>
</body>
