    function initLiquidMembrane() {
      const canvas = document.getElementById('liquidBrainCanvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      canvas.width = canvas.parentElement.clientWidth;
      canvas.height = canvas.parentElement.clientHeight;

      let step = 0;
      function render() {
        requestAnimationFrame(render);
        step += 0.04;
        ctx.fillStyle = 'rgba(2, 6, 23, 0.92)';
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        ctx.strokeStyle = '#ec4899';
        ctx.lineWidth = 3;
        ctx.beginPath();
        for (let x = 0; x < canvas.width; x += 5) {
          const y = canvas.height / 2 + Math.sin(x * 0.02 + step) * 35 + Math.cos(x * 0.01 - step * 0.5) * 20;
          if (x === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
        }
        ctx.stroke();

        for (let i = 0; i < 6; i++) {
          const vx = (Math.sin(step * 0.5 + i) * 0.4 + 0.5) * canvas.width;
          const vy = (Math.cos(step * 0.3 + i * 2) * 0.4 + 0.5) * canvas.height;
          ctx.fillStyle = i % 2 === 0 ? '#ec4899' : '#a855f7';
          ctx.beginPath(); ctx.arc(vx, vy, 8, 0, Math.PI * 2); ctx.fill();
        }
      }
      render();
    }

