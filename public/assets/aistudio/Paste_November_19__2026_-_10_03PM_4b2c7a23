    function executeAIGeneratorPipeline() {
      const prompt = document.getElementById('ai-generator-prompt').value;
      const frame = document.getElementById('game-sandbox-frame');
      const log = document.getElementById('generator-watchdog-log');
      const status = document.getElementById('generator-status');

      if (!frame) return;
      status.textContent = 'COMPILING';
      AIM_BRAIN.publish('GENERATOR', 'AI_COMPILE', `Compiling game for prompt: "${prompt}"`);

      if (log) {
        log.innerHTML = `<div class="p-1.5 rounded-lg bg-cyan-500/15 border-l-2 border-cyan-400"><div class="flex justify-between opacity-75"><span>Now</span><span class="text-cyan-300">AI_STUDIO_GEN</span></div><div>Synthesizing game loop for: ${prompt}</div></div>` + log.innerHTML;
      }

      const gameHTML = `<!DOCTYPE html>
      <html lang="en">
      <head><meta charset="UTF-8"><script src="https://cdn.tailwindcss.com"><\/script></head>
      <body class="bg-slate-950 text-white h-screen flex flex-col items-center justify-center overflow-hidden m-0">
        <div class="absolute top-3 left-4 text-xs font-mono text-cyan-400">⚡ AIM OS GENERATED GAME: ${prompt}</div>
        <canvas id="gameCanvas" width="700" height="400" class="rounded-2xl border border-cyan-500/40 shadow-2xl bg-black cursor-crosshair"></canvas>
        <div class="mt-3 text-[11px] text-slate-400 font-mono">Use Mouse to Aim & Move • Click to Fire Lasers</div>
        <script>
          const canvas = document.getElementById('gameCanvas');
          const ctx = canvas.getContext('2d');
          let player = { x: 350, y: 350, size: 20 };
          let bullets = [];
          let enemies = [];
          let score = 0;

          window.addEventListener('mousemove', e => {
            const rect = canvas.getBoundingClientRect();
            player.x = Math.max(20, Math.min(canvas.width - 20, e.clientX - rect.left));
          });
          window.addEventListener('click', () => {
            bullets.push({ x: player.x, y: player.y, vy: -7 });
          });

          setInterval(() => {
            if (enemies.length < 6) {
              enemies.push({ x: Math.random() * (canvas.width - 40) + 20, y: -20, vy: 1.5 + Math.random() * 1.5, size: 18 });
            }
          }, 1200);

          function loop() {
            ctx.fillStyle = 'rgba(2, 6, 23, 0.4)';
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            ctx.fillStyle = '#38bdf8';
            ctx.beginPath(); ctx.arc(player.x, player.y, player.size/2, 0, Math.PI*2); ctx.fill();

            ctx.fillStyle = '#10b981';
            bullets.forEach((b, idx) => {
              b.y += b.vy;
              ctx.fillRect(b.x - 2, b.y, 4, 10);
              if (b.y < 0) bullets.splice(idx, 1);
            });

            ctx.fillStyle = '#ec4899';
            enemies.forEach((en, eIdx) => {
              en.y += en.vy;
              ctx.fillRect(en.x - en.size/2, en.y - en.size/2, en.size, en.size);

              bullets.forEach((b, bIdx) => {
                const dist = Math.hypot(b.x - en.x, b.y - en.y);
                if (dist < 20) {
                  enemies.splice(eIdx, 1);
                  bullets.splice(bIdx, 1);
                  score += 100;
                }
              });

              if (en.y > canvas.height) enemies.splice(eIdx, 1);
            });

            ctx.fillStyle = '#ffffff';
            ctx.font = '12px monospace';
            ctx.fillText('SCORE: ' + score, 20, 30);

            requestAnimationFrame(loop);
          }
          loop();
        <\/script>
      </body>
      </html>`;

      setTimeout(() => {
        frame.srcdoc = gameHTML;
        status.textContent = 'ONLINE';
        AIM_BRAIN.publish('GENERATOR', 'READY', 'Game compiled and running in sandbox.');
      }, 600);
    }

    let diffusionMesh, diffusionRenderer, diffusionScene, diffusionCamera;
    function initDiffusionStudio() {
      const canvas = document.getElementById('diffusionCanvas');
      if (!canvas) return;
      const container = canvas.parentElement;
      diffusionScene = new THREE.Scene();
      diffusionCamera = new THREE.PerspectiveCamera(45, container.clientWidth / container.clientHeight, 0.1, 1000);
      diffusionCamera.position.set(0, 0, 7);
      diffusionRenderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
      diffusionRenderer.setSize(container.clientWidth, container.clientHeight);
      diffusionScene.add(new THREE.AmbientLight(0xffffff, 1.2));
      const geometry = new THREE.IcosahedronGeometry(2, 2);
      const material = new THREE.MeshStandardMaterial({ color: 0x38bdf8, metalness: 0.9, roughness: 0.15 });
      diffusionMesh = new THREE.Mesh(geometry, material);
      diffusionScene.add(diffusionMesh);
      function animate() {
        requestAnimationFrame(animate);
        if (diffusionMesh) { diffusionMesh.rotation.x += 0.007; diffusionMesh.rotation.y += 0.01; }
        diffusionRenderer.render(diffusionScene, diffusionCamera);
      }
      animate();
    }
