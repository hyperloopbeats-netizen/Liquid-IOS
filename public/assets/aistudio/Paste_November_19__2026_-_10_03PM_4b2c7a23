        <button onclick="openApp('chronoreplay'); closeMenus();" class="w-full text-left px-3 py-2 rounded-xl hover:bg-white/15 flex justify-between cursor-pointer text-amber-300 font-bold"><span>⏱️ Chrono-Replay Debugger</span><span class="font-mono opacity-60">v1.0</span></button>
        <button onclick="openApp('diffusionstudio'); closeMenus();" class="w-full text-left px-3 py-2 rounded-xl hover:bg-white/15 flex justify-between cursor-pointer text-cyan-300 font-bold"><span>🔮 Neural Diffusion Studio</span><span class="font-mono opacity-60">v1.0</span></button>
        <button onclick="openApp('generator'); closeMenus();" class="w-full text-left px-3 py-2 rounded-xl hover:bg-white/15 flex justify-between cursor-pointer text-cyan-300 font-bold"><span>⚡ Self-Healing Generator</span><span class="font-mono opacity-60">v5.0</span></button>
        <button onclick="openApp('modelforge'); closeMenus();" class="w-full text-left px-3 py-2 rounded-xl hover:bg-white/15 flex justify-between cursor-pointer text-purple-300 font-bold"><span>✨ AI Model Forge Suite</span><span class="font-mono opacity-60">v3.8</span></button>
        <button onclick="openApp('gameforge'); closeMenus();" class="w-full text-left px-3 py-2 rounded-xl hover:bg-white/15 flex justify-between cursor-pointer text-emerald-300 font-bold"><span>🎮 Orion Game Loop</span><span class="font-mono opacity-60">v1.0</span></button>
        <button onclick="openApp('gridforge'); closeMenus();" class="w-full text-left px-3 py-2 rounded-xl hover:bg-white/15 flex justify-between cursor-pointer text-cyan-300 font-bold"><span>🗺️ Grid-Forge Worldbuilder</span><span class="font-mono opacity-60">v1.0</span></button>
        <button onclick="openApp('aimaudio'); closeMenus();" class="w-full text-left px-3 py-2 rounded-xl hover:bg-white/15 flex justify-between cursor-pointer text-pink-300 font-bold"><span>🎵 Spectral DSP Synth</span><span class="font-mono opacity-60">v1.0</span></button>
        <button onclick="openApp('swarmnode'); closeMenus();" class="w-full text-left px-3 py-2 rounded-xl hover:bg-white/15 flex justify-between cursor-pointer text-amber-300 font-bold"><span>⚡ Swarm-Node Pipeline</span><span class="font-mono opacity-60">v1.0</span></button>
        <button onclick="openApp('telemetrypulse'); closeMenus();" class="w-full text-left px-3 py-2 rounded-xl hover:bg-white/15 flex justify-between cursor-pointer text-sky-300 font-bold"><span>📊 Telemetry-Pulse HUD</span><span class="font-mono opacity-60">v1.0</span></button>
