    function initChronoReplayDebugger() {
      const canvas = document.getElementById('telemetryGraphCanvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      canvas.width = canvas.parentElement.clientWidth;
      canvas.height = canvas.parentElement.clientHeight;
      function renderLoop() {
        telemetryAnimId = requestAnimationFrame(renderLoop);
        ctx.fillStyle = 'rgba(2, 6, 23, 0.95)';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.strokeStyle = '#f59e0b';
        ctx.lineWidth = 2.5;
        ctx.beginPath();
        const stepX = canvas.width / (fpsBuffer.length - 1);
        fpsBuffer.forEach((fps, idx) => {
          const x = idx * stepX;
          const y = canvas.height - (fps / 60) * (canvas.height - 30) - 15;
          if (idx === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
        });
        ctx.stroke();
      }
      renderLoop();
    }

