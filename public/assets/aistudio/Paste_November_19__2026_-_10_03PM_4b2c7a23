        <span class="text-xs font-medium drop-shadow leading-tight">Spectral Synth</span>
      </button>
      <button onclick="openApp('swarmnode')" ondblclick="openApp('swarmnode')" class="desktop-icon group w-28 p-2.5 rounded-2xl hover:bg-white/15 transition flex flex-col items-center gap-1.5 text-center cursor-pointer">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-amber-500 to-orange-600 flex items-center justify-center shadow-lg"><i data-lucide="activity" class="w-6 h-6 text-white"></i></div>
