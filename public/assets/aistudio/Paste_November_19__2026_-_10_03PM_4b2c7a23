        <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-amber-500 to-orange-600 flex items-center justify-center shadow-lg"><i data-lucide="history" class="w-6 h-6 text-white"></i></div>
        <span class="text-xs font-medium drop-shadow leading-tight">Chrono-Replay</span>
