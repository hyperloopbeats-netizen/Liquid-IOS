      <button onclick="openApp('quantumgit')" ondblclick="openApp('quantumgit')" class="desktop-icon group w-28 p-2.5 rounded-2xl hover:bg-white/15 transition flex flex-col items-center gap-1.5 text-center cursor-pointer">
