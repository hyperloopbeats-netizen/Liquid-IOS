      <button onclick="openApp('diffusionstudio')" ondblclick="openApp('diffusionstudio')" class="desktop-icon group w-28 p-2.5 rounded-2xl hover:bg-white/15 transition flex flex-col items-center gap-1.5 text-center cursor-pointer">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-cyan-400 to-indigo-600 flex items-center justify-center shadow-lg"><i data-lucide="wand-2" class="w-6 h-6 text-white"></i></div>
