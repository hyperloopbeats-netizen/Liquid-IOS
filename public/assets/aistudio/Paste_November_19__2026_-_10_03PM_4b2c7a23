  <!-- Master Script -->
  <script>
    lucide.createIcons();

    const AIM_BRAIN = {
      events: [
        { time: '18:18:00', source: 'MASTER', topic: 'BOOT', summary: 'AIM OS v7.0 Master Monolithic Cognitive Suite initialized with 14 neural apps.' }
      ],
      synapticWeights: {
        generativeMatrix: 0.95,
        sentientBuilding: 0.92,
        liquidMembrane: 0.98,
        quantumGit: 0.88,
        chronoReplay: 0.85
      },
      publish(source, topic, summary) {
        const time = new Date().toTimeString().split(' ')[0];
        this.events.unshift({ time, source, topic, summary });
        if (this.events.length > 60) this.events.pop();
        updateNeuralLedgerUI();
        this.broadcastSynapticPulse(source, summary);
      },
      broadcastSynapticPulse(source, summary) {
        window.dispatchEvent(new CustomEvent('aim-synaptic-pulse', { detail: { source, summary, weights: this.synapticWeights } }));
      }
    };

    function updateNeuralLedgerUI() {
      const listEl = document.getElementById('aim-brain-events-list');
      if (!listEl) return;
      listEl.innerHTML = AIM_BRAIN.events.map(ev => `
        <div class="p-2.5 rounded-xl bg-white/5 border-l-2 border-cyan-400 space-y-1 text-[11px] font-mono">
          <div class="flex justify-between opacity-75 text-[10px]">
            <span>${ev.time} • <strong class="text-cyan-300">[${ev.source}]</strong></span>
            <span class="text-emerald-300">${ev.topic}</span>
          </div>
          <div class="text-slate-200">${ev.summary}</div>
        </div>
      `).join('');
    }

    const APPS = [
      { id: 'generativematrix', name: 'Matrix of Generative Opportunity', category: 'Generative Opportunity Map + Synaptic Visualizer', width: 1140, height: 760, gradient: 'from-cyan-400 to-teal-600', icon: '<i data-lucide="sparkles" class="w-6 h-6 text-white"></i>' },
      { id: 'sentientbuilding', name: 'Fixed Sentient Building Orchestrator', category: 'Autonomous Architectural HUD + Synaptic Visualizer', width: 1140, height: 760, gradient: 'from-emerald-400 to-green-700', icon: '<i data-lucide="building-2" class="w-6 h-6 text-white"></i>' },
      { id: 'liquidmembrane', name: 'Liquid Membrane Brain', category: 'Bio-Fluid Neural Matrix + Synaptic Visualizer', width: 1140, height: 760, gradient: 'from-pink-500 to-purple-600', icon: '<i data-lucide="brain" class="w-6 h-6 text-white"></i>' },
      { id: 'quantumgit', name: 'Quantum Git-Sync Matrix Depot', category: 'Decentralized Package Manager + Commit Tree', width: 1140, height: 760, gradient: 'from-indigo-500 to-violet-700', icon: '<i data-lucide="git-branch" class="w-6 h-6 text-white"></i>' },
      { id: 'chronoreplay', name: 'Chrono-Replay Telemetry Debugger', category: 'Time-Travel Debugger + Fault Suite', width: 1140, height: 760, gradient: 'from-amber-500 to-orange-600', icon: '<i data-lucide="history" class="w-6 h-6 text-white"></i>' },
      { id: 'diffusionstudio', name: 'Neural Diffusion Prompt Studio', category: 'Text-to-3D PBR Asset Generator', width: 1140, height: 760, gradient: 'from-cyan-400 to-indigo-600', icon: '<i data-lucide="wand-2" class="w-6 h-6 text-white"></i>' },
      { id: 'generator', name: 'Self-Healing Game Generator', category: 'Autonomous 5-Part Pipeline + Watchdog', width: 1120, height: 760, gradient: 'from-cyan-400 to-blue-600', icon: '<i data-lucide="cpu" class="w-6 h-6 text-white"></i>' },
      { id: 'modelforge', name: 'AI Model Forge & Skin Suite', category: 'Gemini API + Three.js Shaders', width: 1040, height: 700, gradient: 'from-purple-500 to-indigo-600', icon: '<i data-lucide="box" class="w-6 h-6 text-white"></i>' },
      { id: 'gameforge', name: 'Orion Game Loop & JSON Orchestrator', category: 'Game Engine + Live AI Director', width: 1100, height: 740, gradient: 'from-emerald-500 to-teal-600', icon: '<i data-lucide="gamepad-2" class="w-6 h-6 text-white"></i>' },
      { id: 'gridforge', name: 'Grid-Forge Spatial Worldbuilder', category: 'GPU Voxel Grid + JSON Compiler', width: 1080, height: 720, gradient: 'from-cyan-500 to-blue-600', icon: '<i data-lucide="grid" class="w-6 h-6 text-white"></i>' },
      { id: 'aimaudio', name: 'Spectral DSP & Adaptive Soundscape', category: 'Web Audio API + Reactive DSP', width: 1020, height: 680, gradient: 'from-pink-500 to-rose-600', icon: '<i data-lucide="headphones" class="w-6 h-6 text-white"></i>' },
      { id: 'swarmnode', name: 'Swarm-Node Multi-Agent Pipeline', category: 'JSON Workflow + Local AI Agents', width: 1100, height: 740, gradient: 'from-amber-500 to-orange-600', icon: '<i data-lucide="activity" class="w-6 h-6 text-white"></i>' },
      { id: 'telemetrypulse', name: 'Telemetry-Pulse Hardware HUD', category: 'Zero-Copy Buffer + System Telemetry', width: 1020, height: 680, gradient: 'from-sky-400 to-blue-600', icon: '<i data-lucide="bar-chart-3" class="w-6 h-6 text-white"></i>' },
      { id: 'aim', name: 'Neural Ledger Bus', category: 'Pub/Sub Bus', width: 680, height: 460, gradient: 'from-indigo-500 to-slate-700', icon: '<i data-lucide="terminal" class="w-6 h-6 text-white"></i>' }
    ];

    let openWindows = {};
    let zIndexCounter = 100;
    let activeAppId = null;

    function renderDock() {
      const dock = document.getElementById('dock-bar');
      if (!dock) return;
      dock.innerHTML = APPS.map(app => {
        const isOpen = Boolean(openWindows[app.id]);
        return `
          <button onclick="handleDockClick('${app.id}')" title="${app.name}" class="dock-item relative group flex flex-col items-center cursor-pointer">
            <span class="opacity-0 group-hover:opacity-100 transition-opacity absolute -top-10 px-2.5 py-1 rounded-xl glass-surface text-[11px] font-medium whitespace-nowrap pointer-events-none shadow-lg">${app.name}</span>
            <div class="w-12 h-12 rounded-2xl bg-gradient-to-br ${app.gradient} flex items-center justify-center shadow-lg border border-white/25">${app.icon}</div>
            <span class="w-1.5 h-1.5 rounded-full mt-1.5 transition-all ${isOpen ? 'bg-white opacity-100' : 'opacity-0'}"></span>
          </button>
