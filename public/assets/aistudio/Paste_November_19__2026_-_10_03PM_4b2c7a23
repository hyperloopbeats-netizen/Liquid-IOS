    function initSentientBuilding() {
      const canvas = document.getElementById('sentientBuildingCanvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      canvas.width = canvas.parentElement.clientWidth;
      canvas.height = canvas.parentElement.clientHeight;

      let t = 0;
      function render() {
        requestAnimationFrame(render);
        t += 0.03;
        ctx.fillStyle = 'rgba(2, 6, 23, 0.9)';
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        const floors = 5;
        const fh = canvas.height / (floors + 2);
        for (let i = 0; i < floors; i++) {
          const y = (i + 1) * fh;
          ctx.strokeStyle = 'rgba(16, 185, 129, 0.4)';
          ctx.lineWidth = 2;
          ctx.strokeRect(60, y, canvas.width - 120, fh - 10);

          const pulseX = 60 + ((Math.sin(t + i) + 1) / 2) * (canvas.width - 120);
          ctx.fillStyle = '#10b981';
          ctx.beginPath(); ctx.arc(pulseX, y + (fh - 10)/2, 5, 0, Math.PI * 2); ctx.fill();
        }
      }
      render();
    }

